# Hasura GraphQL Engine Configuration
# Copy this file to .env and fill in your actual values

## Database Configuration
HASURA_GRAPHQL_DATABASE_URL=postgresql://username:password@localhost:5432/hrdb
POSTGRES_DB=hrdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

## Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password

## Hasura Core Configuration
HASURA_GRAPHQL_ADMIN_SECRET=your-super-secure-admin-secret-here
HASURA_GRAPHQL_ENABLE_CONSOLE=true
HASURA_GRAPHQL_DEV_MODE=true
HASURA_GRAPHQL_ENABLED_LOG_TYPES=startup,http-log,webhook-log,websocket-log,query-log

## JWT Authentication Configuration
HASURA_GRAPHQL_JWT_SECRET={"type":"HS256","key":"your-jwt-secret-key-here-must-be-at-least-32-chars-long"}
JWT_SECRET=your-jwt-secret-key-here-must-be-at-least-32-chars-long

## CORS Configuration
HASURA_GRAPHQL_CORS_DOMAIN=http://localhost:5173,http://localhost:3000
HASURA_GRAPHQL_ENABLE_CORS=true

## WebSocket Configuration
HASURA_GRAPHQL_WS_READ_COOKIE=false
HASURA_GRAPHQL_ENABLE_TELEMETRY=false

## Performance Configuration
HASURA_GRAPHQL_CONNECTION_COMPRESSION=true
HASURA_GRAPHQL_LIVE_QUERIES_MULTIPLEXED_REFETCH_INTERVAL=1000
HASURA_GRAPHQL_LIVE_QUERIES_MULTIPLEXED_BATCH_SIZE=100

## Security Configuration
HASURA_GRAPHQL_DISABLE_INTERACTIVE_TRANSACTION_FOR_READ_QUERIES=false
HASURA_GRAPHQL_STRINGIFY_NUMERIC_TYPES=false
HASURA_GRAPHQL_INFER_FUNCTION_PERMISSIONS=false

## Event System Configuration
HASURA_GRAPHQL_EVENTS_HTTP_POOL_SIZE=100
HASURA_GRAPHQL_EVENTS_FETCH_INTERVAL=1000

## Rate Limiting
HASURA_GRAPHQL_API_RATE_LIMIT_ENABLED=true
HASURA_GRAPHQL_API_RATE_LIMIT_MAX_REQS_PER_MIN=1000
HASURA_GRAPHQL_API_RATE_LIMIT_UNIQUE_PARAMS=IP,user-role

## Logging and Monitoring
HASURA_GRAPHQL_LOG_LEVEL=info
HASURA_GRAPHQL_ENABLE_REMOTE_SCHEMA_PERMISSIONS=true

## Backend Service Configuration
BACKEND_SERVICE_URL=http://localhost:3001
AUTH_SERVICE_URL=http://localhost:3001/auth
WEBHOOK_SECRET=your-webhook-secret-for-events

## Development Specific
NODE_ENV=development
PORT=8080

## Production Overrides (uncomment for production)
# HASURA_GRAPHQL_DEV_MODE=false  
# HASURA_GRAPHQL_ENABLE_CONSOLE=false
# HASURA_GRAPHQL_LOG_LEVEL=warn
# HASURA_GRAPHQL_ENABLE_TELEMETRY=true

## Optional: Analytics and Metrics
# HASURA_GRAPHQL_METRICS_SECRET=your-metrics-secret
# HASURA_GRAPHQL_ENABLE_ALLOWLIST=true

## Optional: Remote Schema Integration
# REMOTE_SCHEMA_WEBHOOK_URL=http://localhost:4000/graphql
# REMOTE_SCHEMA_WEBHOOK_SECRET=your-remote-schema-secret