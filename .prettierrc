{
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"plugins": ["prettier-plugin-tailwindcss", "prettier-plugin-svelte"],
	"overrides": [
		{
			"files": "*.svelte",
			"options": {
				"parser": "svelte"
			}
		},
		{
			"files": "*.sql",
			"options": {
				"parser": "sql",
				"printWidth": 80,
				"tabWidth": 2,
				"useTabs": false
			}
		}
	],
	"tailwindStylesheet": "./src/app.css"
}
