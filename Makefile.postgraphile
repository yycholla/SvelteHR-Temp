# PostGraphile HR System Makefile
# Node.js-based PostGraphile server with PostgreSQL and Redis

.PHONY: help install clean
.PHONY: db-up db-down db-reset db-health db-logs db-shell
.PHONY: server-dev server-prod server-start server-stop server-status server-logs
.PHONY: dev install-backend install-frontend
.PHONY: migrate-check schema-status test-graphql test-auth
.PHONY: quick-start env-check
.DEFAULT_GOAL := help

# Configuration
COMPOSE_FILE := docker-compose.postgraphile.yml
DB_CONTAINER := svelteHR-postgres-postgraphile
REDIS_CONTAINER := svelteHR-redis-postgraphile
BACKEND_DIR := backend
LOGS_DIR := $(BACKEND_DIR)/logs

# Colors for output
GREEN := \033[0;32m
YELLOW := \033[0;33m
RED := \033[0;31m
NC := \033[0m # No Color

help: ## Show this help message
	@echo "PostGraphile HR System - Development Commands"
	@echo "=============================================="
	@echo ""
	@echo "Database Operations:"
	@grep -E '^db-[a-zA-Z0-9_-]+:.*?## .*$$' $(MAKEFILE_LIST) | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "  $(GREEN)%-20s$(NC) %s\n", $$1, $$2}'
	@echo ""
	@echo "Server Operations:"
	@grep -E '^server-[a-zA-Z0-9_-]+:.*?## .*$$' $(MAKEFILE_LIST) | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "  $(GREEN)%-20s$(NC) %s\n", $$1, $$2}'
	@echo ""
	@echo "Development Operations:"
	@grep -E '^(dev|install|quick-start|clean)[a-zA-Z0-9_-]*:.*?## .*$$' $(MAKEFILE_LIST) | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "  $(GREEN)%-20s$(NC) %s\n", $$1, $$2}'
	@echo ""
	@echo "Schema Operations:"
	@grep -E '^(migrate|schema)[a-zA-Z0-9_-]*:.*?## .*$$' $(MAKEFILE_LIST) | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "  $(GREEN)%-20s$(NC) %s\n", $$1, $$2}'
	@echo ""
	@echo "Testing Operations:"
	@grep -E '^test-[a-zA-Z0-9_-]*:.*?## .*$$' $(MAKEFILE_LIST) | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "  $(GREEN)%-20s$(NC) %s\n", $$1, $$2}''

## Database Operations

db-up: ## Start PostgreSQL and Redis containers
	@echo "$(GREEN)Starting database services...$(NC)"
	docker-compose -f $(COMPOSE_FILE) up -d postgres redis
	@echo "$(GREEN)Waiting for services to be healthy...$(NC)"
	@timeout 60 bash -c 'until docker-compose -f $(COMPOSE_FILE) ps postgres | grep "healthy"; do sleep 2; done' || (echo "$(RED)PostgreSQL failed to start$(NC)" && exit 1)
	@timeout 30 bash -c 'until docker-compose -f $(COMPOSE_FILE) ps redis | grep "healthy"; do sleep 2; done' || (echo "$(RED)Redis failed to start$(NC)" && exit 1)
	@echo "$(GREEN)Database services are ready!$(NC)"

db-down: ## Stop all containers
	@echo "$(YELLOW)Stopping all services...$(NC)"
	docker-compose -f $(COMPOSE_FILE) down

db-reset: ## Reset database with fresh data (destructive)
	@echo "$(RED)WARNING: This will destroy all data!$(NC)"
	@read -p "Are you sure? [y/N] " -n 1 -r; echo; \
	if [[ $$REPLY =~ ^[Yy]$$ ]]; then \
		echo "$(YELLOW)Stopping services...$(NC)"; \
		docker-compose -f $(COMPOSE_FILE) down -v; \
		echo "$(YELLOW)Removing volumes...$(NC)"; \
		docker volume rm svelteHR-postgraphile_postgres_data svelteHR-postgraphile_redis_data 2>/dev/null || true; \
		echo "$(GREEN)Starting fresh database...$(NC)"; \
		make db-up; \
	else \
		echo "$(GREEN)Operation cancelled$(NC)"; \
	fi

db-health: ## Check database service health
	@echo "$(GREEN)Checking service health...$(NC)"
	@docker-compose -f $(COMPOSE_FILE) ps
	@echo ""
	@echo "$(GREEN)PostgreSQL Status:$(NC)"
	@docker exec $(DB_CONTAINER) pg_isready -U postgres -d hr_system || echo "$(RED)PostgreSQL not ready$(NC)"
	@echo ""
	@echo "$(GREEN)Redis Status:$(NC)"
	@docker exec $(REDIS_CONTAINER) redis-cli ping || echo "$(RED)Redis not ready$(NC)"
	@echo ""
	@echo "$(GREEN)Database Statistics:$(NC)"
	@docker exec $(DB_CONTAINER) psql -U postgres -d hr_system -c "\
		SELECT 'Employees' as table_name, count(*) as count FROM hr_public.employees \
		UNION ALL SELECT 'Departments', count(*) FROM hr_public.departments \
		UNION ALL SELECT 'Time Off Requests', count(*) FROM hr_public.time_off_requests \
		UNION ALL SELECT 'Performance Reviews', count(*) FROM hr_public.performance_reviews;" 2>/dev/null || echo "$(YELLOW)Database not initialized yet$(NC)"

db-logs: ## View database container logs
	@echo "$(GREEN)PostgreSQL Logs:$(NC)"
	docker logs $(DB_CONTAINER) --tail=50 -f

db-shell: ## Open PostgreSQL shell
	@echo "$(GREEN)Opening PostgreSQL shell (hr_system database)...$(NC)"
	docker exec -it $(DB_CONTAINER) psql -U postgres -d hr_system

## Server Operations

server-dev: db-up ## Start PostGraphile development server (Node.js)
	@echo "$(GREEN)Starting PostGraphile development server...$(NC)"
	@echo "GraphQL API: http://localhost:3001/graphql"
	@echo "GraphiQL IDE: http://localhost:3001/graphiql"
	@echo "Metrics API: http://localhost:9090/metrics"
	@mkdir -p $(LOGS_DIR)
	cd $(BACKEND_DIR) && npm run postgraphile:dev

server-prod: db-up ## Start PostGraphile in production mode
	@echo "$(GREEN)Starting PostGraphile production server...$(NC)"
	cd $(BACKEND_DIR) && npm run postgraphile:prod

server-start: server-dev ## Alias for server-dev

server-stop: ## Stop all server processes
	@echo "$(YELLOW)Stopping PostGraphile server processes...$(NC)"
	@pkill -f "node.*backend.*server.ts" || true
	@pkill -f "postgraphile" || true
	@echo "$(GREEN)Server processes stopped$(NC)"

server-status: ## Check if server is running and healthy
	@echo "$(GREEN)Checking PostGraphile server status...$(NC)"
	@curl -s http://localhost:3001/health | jq . || echo "$(RED)❌ GraphQL API not running on port 3001$(NC)"
	@curl -s http://localhost:9090/metrics > /dev/null && echo "$(GREEN)✅ Metrics server running on port 9090$(NC)" || echo "$(RED)❌ Metrics server not running on port 9090$(NC)"
	@echo ""
	@echo "$(GREEN)Server Endpoints:$(NC)"
	@echo "  - GraphQL API:    http://localhost:3001/graphql"
	@echo "  - GraphiQL IDE:   http://localhost:3001/graphiql"
	@echo "  - Health Check:   http://localhost:3001/health"
	@echo "  - Detailed Health: http://localhost:3001/health-detailed"
	@echo "  - System Metrics: http://localhost:3001/metrics"
	@echo "  - Alerts:         http://localhost:3001/alerts"

server-logs: ## View server logs
	@echo "$(GREEN)PostGraphile Server Logs:$(NC)"
	@test -f $(LOGS_DIR)/combined.log && tail -f $(LOGS_DIR)/combined.log || echo "$(YELLOW)No log file found$(NC)"

## Development Operations

dev: server-dev ## Start full development environment (database + server)
	@echo "$(GREEN)Starting full development environment...$(NC)"
	@make db-up
	@sleep 5
	@make db-health
	@make server-dev

quick-start: ## Complete setup for first-time users
	@echo "$(GREEN)PostGraphile HR System - Quick Start$(NC)"
	@echo "=================================="
	@echo "$(YELLOW)1. Checking environment...$(NC)"
	@make env-check
	@echo ""
	@echo "$(YELLOW)2. Installing dependencies...$(NC)"
	@make install-backend
	@echo ""
	@echo "$(YELLOW)3. Starting database services...$(NC)"
	@make db-up
	@echo ""
	@echo "$(YELLOW)4. Checking database health...$(NC)"
	@make db-health
	@echo ""
	@echo "$(YELLOW)5. Starting PostGraphile server...$(NC)"
	@make server-status
	@echo ""
	@echo "$(GREEN)Quick start completed!$(NC)"
	@echo ""
	@echo "$(GREEN)Next steps:$(NC)"
	@echo "  - Run 'make server-dev' to start the GraphQL API"
	@echo "  - Visit http://localhost:3001/graphiql to explore the API"
	@echo "  - Test authentication with: admin@company.com / AdminPass123!"
	@echo "  - Run 'make help' to see all available commands"

install: install-backend install-frontend ## Install all dependencies

install-backend: ## Install backend dependencies
	@echo "$(GREEN)Installing backend dependencies...$(NC)"
	cd backend && npm install

install-frontend: ## Install frontend dependencies
	@echo "$(GREEN)Installing frontend dependencies...$(NC)"
	npm install

clean: ## Clean up containers, volumes, and dependencies
	@echo "$(YELLOW)Cleaning up...$(NC)"
	docker-compose -f $(COMPOSE_FILE) down -v --remove-orphans
	docker system prune -f
	@echo "$(GREEN)Cleanup completed$(NC)"

## Schema Operations

migrate-check: ## Check if database needs migration
	@echo "$(GREEN)Checking database schema status...$(NC)"
	@if docker exec $(DB_CONTAINER) psql -U postgres -d hr_system -c "\d hr_public.employees" >/dev/null 2>&1; then \
		echo "$(GREEN)Database schema is initialized$(NC)"; \
		docker exec $(DB_CONTAINER) psql -U postgres -d hr_system -c "\
			SELECT schemaname, tablename \
			FROM pg_tables \
			WHERE schemaname IN ('hr_public', 'hr_private', 'hr_hidden') \
			ORDER BY schemaname, tablename;"; \
	else \
		echo "$(YELLOW)Database schema not found - run 'make db-reset' to initialize$(NC)"; \
	fi

schema-status: migrate-check ## Show current schema status (alias)

## Testing Operations

test-auth: ## Test authentication functions via GraphQL
	@echo "$(GREEN)Testing authentication endpoint...$(NC)"
	@curl -s -X POST \
	  -H "Content-Type: application/json" \
	  -d '{
	    "query": "mutation { authenticateEmail(email: \"admin@company.com\", password: \"AdminPass123!\") { token user { id email role } } }"
	  }' \
	  http://localhost:3001/graphql | jq . || echo "$(RED)Authentication test failed or server not running$(NC)"

test-graphql: ## Test GraphQL endpoint (requires server running)
	@echo "$(GREEN)Testing GraphQL endpoint...$(NC)"
	@curl -s -X POST \
	  -H "Content-Type: application/json" \
	  -d '{"query": "query { __schema { types { name } } }"}' \
	  http://localhost:3001/graphql | jq '.data.__schema.types[0]' || echo "$(RED)GraphQL server not running or not accessible$(NC)"

test-contract: ## Run GraphQL contract tests
	@echo "$(GREEN)Running GraphQL contract tests...$(NC)"
	@cd tests/contract && npm test

## Database Utilities

db-backup: ## Create database backup
	@echo "$(GREEN)Creating database backup...$(NC)"
	@mkdir -p backups
	@BACKUP_FILE="backups/hr_system_$(shell date +%Y%m%d_%H%M%S).sql"; \
	docker exec $(DB_CONTAINER) pg_dump -U postgres hr_system > $$BACKUP_FILE; \
	echo "$(GREEN)Backup created: $$BACKUP_FILE$(NC)"

db-restore: ## Restore database from backup (interactive)
	@echo "$(GREEN)Available backups:$(NC)"
	@ls -la backups/*.sql 2>/dev/null || (echo "$(YELLOW)No backups found$(NC)" && exit 1)
	@echo "$(YELLOW)Enter backup file path:$(NC)"
	@read -r BACKUP_FILE; \
	if [ -f "$$BACKUP_FILE" ]; then \
		echo "$(RED)This will replace current database!$(NC)"; \
		read -p "Continue? [y/N] " -n 1 -r; echo; \
		if [[ $$REPLY =~ ^[Yy]$$ ]]; then \
			docker exec -i $(DB_CONTAINER) dropdb -U postgres hr_system --if-exists; \
			docker exec -i $(DB_CONTAINER) createdb -U postgres hr_system; \
			cat $$BACKUP_FILE | docker exec -i $(DB_CONTAINER) psql -U postgres hr_system; \
			echo "$(GREEN)Database restored from $$BACKUP_FILE$(NC)"; \
		fi; \
	else \
		echo "$(RED)Backup file not found$(NC)"; \
	fi

db-console: ## Open database admin console (pgAdmin)
	@echo "$(GREEN)Starting pgAdmin...$(NC)"
	docker-compose -f $(COMPOSE_FILE) up -d pgadmin
	@echo "$(GREEN)pgAdmin will be available at: http://localhost:5050$(NC)"
	@echo "$(GREEN)Login: admin@svelteHR.com / admin123$(NC)"

## Environment Management

env-check: ## Check environment configuration
	@echo "$(GREEN)Environment Configuration:$(NC)"
	@echo "Docker Compose File: $(COMPOSE_FILE)"
	@echo "Database Container: $(DB_CONTAINER)"
	@echo "Redis Container: $(REDIS_CONTAINER)"
	@echo "Backend Directory: $(BACKEND_DIR)"
	@echo "Logs Directory: $(LOGS_DIR)"
	@echo ""
	@echo "$(GREEN)Required Files:$(NC)"
	@test -f $(COMPOSE_FILE) && echo "✓ $(COMPOSE_FILE)" || echo "✗ $(COMPOSE_FILE) $(RED)(missing)$(NC)"
	@test -f database/init.sql && echo "✓ database/init.sql" || echo "✗ database/init.sql $(RED)(missing)$(NC)"
	@test -f backend/package.json && echo "✓ backend/package.json" || echo "✗ backend/package.json $(RED)(missing)$(NC)"
	@test -f backend/src/server.ts && echo "✓ backend/src/server.ts" || echo "✗ backend/src/server.ts $(RED)(missing)$(NC)"
	@test -d backend/src/auth && echo "✓ backend/src/auth/" || echo "✗ backend/src/auth/ $(RED)(missing)$(NC)"
	@test -d backend/src/cache && echo "✓ backend/src/cache/" || echo "✗ backend/src/cache/ $(RED)(missing)$(NC)"
	@test -d backend/src/monitoring && echo "✓ backend/src/monitoring/" || echo "✗ backend/src/monitoring/ $(RED)(missing)$(NC)"
	@test -d backend/src/postgraphile && echo "✓ backend/src/postgraphile/" || echo "✗ backend/src/postgraphile/ $(RED)(missing)$(NC)"
	@test -d database/migrations && echo "✓ database/migrations/" || echo "✗ database/migrations/ $(RED)(missing)$(NC)"
	@test -d database/functions && echo "✓ database/functions/" || echo "✗ database/functions/ $(RED)(missing)$(NC)"
	@test -d database/policies && echo "✓ database/policies/" || echo "✗ database/policies/ $(RED)(missing)$(NC)"
	@echo ""
	@echo "$(GREEN)Node.js Check:$(NC)"
	@node --version && echo "✓ Node.js installed" || echo "✗ Node.js not found $(RED)(install Node.js)$(NC)"
	@npm --version && echo "✓ npm available" || echo "✗ npm not available $(RED)(install npm)$(NC)"
	@echo ""
	@echo "$(GREEN)Dependencies Status:$(NC)"
	@cd $(BACKEND_DIR) && test -d node_modules && echo "✓ Backend dependencies installed" || echo "✗ Backend dependencies not installed $(RED)(run 'make install-backend')$(NC)"