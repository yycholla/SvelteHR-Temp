# =============================================================================
# Docker Ignore File for SvelteHR Frontend
# =============================================================================
# 
# Excludes files and directories from Docker build context to:
# - Reduce build time and image size
# - Prevent sensitive files from being included in image
# - Follow twelve-factor security practices
# =============================================================================

# =============================================================================
# Development and Build Artifacts
# =============================================================================

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# Build outputs
build/
dist/
.svelte-kit/
.output/
.vercel/
.netlify/

# Development caches
.vite/
vite.config.js.timestamp-*
.turbo/

# =============================================================================
# Environment and Configuration (Security)
# =============================================================================

# Environment files (these should come from Doppler)
.env
.env.*
!.env.example
.doppler.yaml

# Doppler cache
.doppler/

# Configuration backups
.env-backup*/

# =============================================================================
# Version Control and Documentation
# =============================================================================

# Git
.git/
.gitignore
.gitattributes
.github/

# Documentation
README.md
CHANGELOG.md
docs/
*.md
!package.json

# =============================================================================
# Development Tools and IDE
# =============================================================================

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# =============================================================================
# Testing and Coverage
# =============================================================================

# Test files
coverage/
.nyc_output/
test-results/
playwright-report/

# =============================================================================
# Logs and Temporary Files
# =============================================================================

# Logs
logs/
*.log
lerna-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Temporary files
tmp/
temp/

# =============================================================================
# Docker and CI/CD
# =============================================================================

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# =============================================================================
# Package Manager Files (Keep package.json, exclude locks in some cases)
# =============================================================================

# Keep package.json but exclude lock files if using different managers
# package-lock.json  # Uncomment if using yarn exclusively
# yarn.lock          # Uncomment if using npm exclusively