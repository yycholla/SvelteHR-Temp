module onboarding_offboarding {

    # Onboarding Process Templates
    type OnboardingTemplate extending portal_communication::FormEnabled {
        required property name -> str;
        property description -> str;
        property target_role -> str; # Which role this template is for
        property target_department -> str;
        property duration_days -> int32 {
            default := 30;
        }
        property is_active -> bool {
            default := true;
        }
        link created_by -> rbac::User;
        property template_steps -> json; # Ordered list of steps
        property required_documents -> json; # List of required documents
        property assigned_buddy_role -> str; # Role that should be assigned as buddy
        
        # Computed properties
        property step_count := len(<array<json>>.template_steps);
        property processes_created := count(.<template[is OnboardingProcess]);
        
        # Indexes
        index on (.target_role);
        index on (.is_active);
    }

    # Individual Onboarding Process
    type OnboardingProcess extending portal_communication::FormEnabled {
        required link employee -> rbac::User;
        required link template -> OnboardingTemplate;
        property status -> default::ApprovalStatus {
            default := default::ApprovalStatus.Pending;
        }
        property start_date -> cal::local_date;
        property expected_completion_date -> cal::local_date;
        property actual_completion_date -> cal::local_date;
        property progress_percentage -> decimal {
            default := 0;
            constraint expression on (__subject__ >= 0 and __subject__ <= 100);
        }
        link assigned_hr -> rbac::User;
        link assigned_manager -> rbac::User;
        link assigned_buddy -> rbac::User;
        property notes -> str;
        property current_step -> int32 {
            default := 1;
        }
        
        # Computed properties
        property is_completed := .status = default::ApprovalStatus.Approved;
        
        # Constraints
        constraint exclusive on (.employee); # One active onboarding per employee
        
        # Indexes
        index on (.employee);
        index on (.status);
        index on (.expected_completion_date);
    }

    # Onboarding Steps/Tasks
    type OnboardingStep extending default::Auditable {
        required link process -> OnboardingProcess;
        required property step_number -> int32;
        required property title -> str;
        property description -> str;
        property step_type -> str; # task, document, meeting, training
        property is_required -> bool {
            default := true;
        }
        property status -> default::TaskStatus {
            default := default::TaskStatus.Pending;
        }
        property due_date -> cal::local_date;
        property completion_date -> cal::local_date;
        link assigned_to -> rbac::User; # Who is responsible for this step
        link completed_by -> rbac::User; # Who actually completed it
        property completion_notes -> str;
        property estimated_hours -> decimal;
        property actual_hours -> decimal;
        property requires_approval -> bool {
            default := false;
        }
        link approved_by -> rbac::User;
        property approval_date -> datetime;
        
        # Computed properties
        property is_completed := .status = default::TaskStatus.Completed;
        property can_complete := .status in {default::TaskStatus.Pending, default::TaskStatus.InProgress};
        
        # Constraints
        constraint exclusive on ((.process, .step_number));
        
        # Indexes
        index on (.process);
        index on (.status);
        index on (.due_date);
        index on (.assigned_to);
    }

    # Onboarding Documents
    type OnboardingDocument extending default::Auditable {
        required link process -> OnboardingProcess;
        required property document_type -> str; # I-9, W-4, Handbook, etc.
        property document_name -> str;
        property is_required -> bool {
            default := true;
        }
        property is_submitted -> bool {
            default := false;
        }
        property submission_date -> datetime;
        property file_path -> str;
        property file_size -> int64;
        property mime_type -> str;
        link submitted_by -> rbac::User;
        link reviewed_by -> rbac::User;
        property review_status -> default::ApprovalStatus {
            default := default::ApprovalStatus.Pending;
        }
        property review_date -> datetime;
        property review_notes -> str;
        property expiry_date -> cal::local_date;
        property requires_signature -> bool {
            default := false;
        }
        property is_signed -> bool {
            default := false;
        }
        property signature_date -> datetime;
        
        # Computed properties
        property is_approved := .review_status = default::ApprovalStatus.Approved;
        property needs_review := .is_submitted and .review_status = default::ApprovalStatus.Pending;
        
        # Indexes
        index on (.process);
        index on (.document_type);
        index on (.review_status);
        index on (.expiry_date);
    }

    # Equipment Assignment
    type EquipmentAssignment extending default::Auditable {
        required link employee -> rbac::User;
        required property equipment_type -> str; # Laptop, Phone, Desk, etc.
        required property equipment_id -> str; # Serial number or asset ID
        property brand -> str;
        property model -> str;
        property serial_number -> str;
        property assigned_date -> cal::local_date {
            default := cal::to_local_date(datetime_current(), 'UTC');
        }
        property return_date -> cal::local_date;
        property condition_at_assignment -> str {
            default := 'new';
        }
        property condition_at_return -> str;
        property estimated_value -> decimal;
        property is_returned -> bool {
            default := false;
        }
        link assigned_by -> rbac::User;
        link returned_to -> rbac::User;
        property notes -> str;
        property warranty_expiry -> cal::local_date;
        property maintenance_schedule -> str;
        
        # Computed properties
        
        # Indexes
        index on (.employee);
        index on (.is_returned);
        index on (.equipment_id);
        index on (.assigned_date);
    }

    # Offboarding Process
    type OffboardingProcess extending default::Auditable {
        required link employee -> rbac::User;
        property offboarding_type -> str {
            default := 'voluntary';
        }
        property reason -> str;
        property last_working_day -> cal::local_date;
        property notice_given_date -> cal::local_date;
        property notice_period_days -> int32;
        property status -> default::ApprovalStatus {
            default := default::ApprovalStatus.Pending;
        }
        property progress_percentage -> decimal {
            default := 0;
            constraint expression on (__subject__ >= 0 and __subject__ <= 100);
        }
        link initiated_by -> rbac::User;
        link hr_contact -> rbac::User;
        link manager -> rbac::User;
        property exit_interview_scheduled -> bool {
            default := false;
        }
        property exit_interview_date -> datetime;
        property exit_interview_completed -> bool {
            default := false;
        }
        property knowledge_transfer_completed -> bool {
            default := false;
        }
        property equipment_returned -> bool {
            default := false;
        }
        property access_revoked -> bool {
            default := false;
        }
        property final_pay_processed -> bool {
            default := false;
        }
        property rehire_eligible -> bool;
        property completion_date -> cal::local_date;
        property notes -> str;
        
        # Computed properties
        property is_completed := .status = default::ApprovalStatus.Approved;
        
        # Constraints
        constraint exclusive on (.employee); # One active offboarding per employee
        
        # Indexes
        index on (.employee);
        index on (.status);
        index on (.last_working_day);
    }

    # Exit Interview
    type ExitInterview extending portal_communication::FormEnabled {
        required link offboarding -> OffboardingProcess;
        link conducted_by -> rbac::User;
        property interview_date -> datetime;
        property interview_method -> str {
            default := 'in_person';
        }
        property responses -> json; # Survey responses
        property overall_satisfaction -> int32 {
            constraint expression on (__subject__ >= 1 and __subject__ <= 5);
        }
        property would_recommend_company -> bool;
        property likelihood_to_return -> int32 {
            constraint expression on (__subject__ >= 1 and __subject__ <= 5);
        }
        property feedback_summary -> str;
        property improvement_suggestions -> str;
        property confidential_notes -> str;
        property follow_up_required -> bool {
            default := false;
        }
        property follow_up_notes -> str;
        
        # Computed properties
        property is_positive_exit := .overall_satisfaction >= 4 and .would_recommend_company;
        
        # Constraints
        constraint exclusive on (.offboarding);
        
        # Indexes
        index on (.interview_date);
        index on (.overall_satisfaction);
        index on (.would_recommend_company);
    }
}