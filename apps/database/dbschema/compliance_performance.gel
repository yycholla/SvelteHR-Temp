module compliance_performance {

    # Compliance Items
    type ComplianceItem extending default::Auditable {
        required link employee -> rbac::User;
        required property item_type -> str; # Training, Certification, Document, etc.
        required property title -> str;
        property description -> str;
        property status -> default::ComplianceStatus {
            default := default::ComplianceStatus.Active;
        }
        property due_date -> cal::local_date;
        property completion_date -> cal::local_date;
        property renewal_period -> default::RenewalPeriod {
            default := default::RenewalPeriod.None;
        }
        property next_renewal_date -> cal::local_date;
        property compliance_score -> decimal; # 0-100
        property required_for_role -> bool {
            default := false;
        }
        property external_id -> str; # For third-party system integration
        
        # Computed properties
        property is_completed := exists .completion_date;
        
        # Indexes
        index on (.employee);
        index on (.status);
        index on (.due_date);
        index on (.item_type);
    }

    # Documents for compliance or general storage
    type Document extending default::Auditable {
        required property filename -> str;
        required property file_path -> str;
        property file_size -> int64;
        property mime_type -> str;
        property document_type -> str; # Resume, Contract, Certification, etc.
        link owner -> rbac::User; # Employee who owns the document
        link uploaded_by -> rbac::User; # Employee who uploaded it
        property is_confidential -> bool {
            default := false;
        }
        property access_level -> str {
            default := 'private';
        }
        property retention_period -> int32; # Days to retain
        property expiry_date -> cal::local_date;
        property document_hash -> str; # For integrity checking
        property version -> int32 {
            default := 1;
        }
        link parent_document -> Document; # For versioning
        property metadata -> json;
        
        # Computed properties
        property file_size_mb := <decimal>.file_size / <decimal>1024.0 / <decimal>1024.0;
        property is_latest_version := not exists(.<parent_document[is Document]);
        
        # Indexes
        index on (.owner);
        index on (.document_type);
        index on (.expiry_date);
        index on (.file_path);
    }

    # Performance Review Templates
    type PerformanceTemplate extending default::Auditable {
        required property name -> str;
        property description -> str;
        required property template_data -> json; # Stores the form structure
        property is_active -> bool {
            default := true;
        }
        property is_default -> bool {
            default := false;
        }
        property review_period -> str; # Annual, Semi-Annual, Quarterly
        property target_roles -> json; # Array of role IDs this template applies to
        link created_by -> rbac::User;
        
        # Computed properties
        property reviews_count := count(.<template[is PerformanceReview]);
        property avg_score := math::mean(.<template[is PerformanceReview].overall_score);
        
        # Indexes
        index on (.is_active);
        index on (.is_default);
    }

    # Performance Reviews
    type PerformanceReview extending portal_communication::FormEnabled {
        required link employee -> rbac::User;
        required link template -> PerformanceTemplate;
        link reviewer -> rbac::User; # Usually the manager
        property review_period_start -> cal::local_date;
        property review_period_end -> cal::local_date;
        property status -> default::ApprovalStatus {
            default := default::ApprovalStatus.Pending;
        }
        property responses -> json; # Stores the actual responses
        property goals -> json; # Goals for next period
        property overall_score -> decimal; # 1-5 or 1-10 scale
        property self_review_completed -> bool {
            default := false;
        }
        property manager_review_completed -> bool {
            default := false;
        }
        property final_review_completed -> bool {
            default := false;
        }
        property submitted_at -> datetime;
        property reviewed_at -> datetime;
        property finalized_at -> datetime;
        property comments -> str;
        
        # Computed properties
        property is_self_review := .employee = .reviewer;
        
        # Constraints
        constraint expression on (.review_period_start <= .review_period_end);
        
        # Indexes
        index on (.employee);
        index on (.status);
        index on (.review_period_start);
        index on (.review_period_end);
        index on (.overall_score);
    }

    # Performance Goals
    type PerformanceGoal extending default::Auditable {
        required link employee -> rbac::User;
        link review -> PerformanceReview; # Can be linked to a review or standalone
        required property title -> str;
        property description -> str;
        property target_value -> str;
        property current_value -> str;
        property measurement_criteria -> str;
        property due_date -> cal::local_date;
        property completion_date -> cal::local_date;
        property status -> default::TaskStatus {
            default := default::TaskStatus.Pending;
        }
        property progress_percentage -> decimal {
            default := 0;
            constraint expression on (__subject__ >= 0 and __subject__ <= 100);
        }
        property priority -> str {
            default := 'medium';
        }
        link manager -> rbac::User;
        property notes -> str;
        
        # Computed properties
        property is_completed := .status = default::TaskStatus.Completed;
        
        # Indexes
        index on (.employee);
        index on (.status);
        index on (.due_date);
    }

    # Disciplinary Actions
    type DisciplinaryAction extending default::Auditable {
        required link employee -> rbac::User;
        required property action_type -> str; # Verbal Warning, Written Warning, Suspension, etc.
        required property reason -> str;
        property description -> str;
        property severity_level -> int32 {
            default := 1;
            constraint expression on (__subject__ >= 1 and __subject__ <= 5);
        }
        property action_date -> cal::local_date {
            default := cal::to_local_date(datetime_current(), 'UTC');
        }
        link issued_by -> rbac::User;
        link witness -> rbac::User;
        property follow_up_required -> bool {
            default := false;
        }
        property follow_up_date -> cal::local_date;
        property resolution -> str;
        property is_active -> bool {
            default := true;
        }
        property appeal_deadline -> cal::local_date;
        property appeal_submitted -> bool {
            default := false;
        }
        
        # Computed properties
        
        # Indexes
        index on (.employee);
        index on (.is_active);
        index on (.action_type);
        index on (.severity_level);
        index on (.action_date);
    }
}