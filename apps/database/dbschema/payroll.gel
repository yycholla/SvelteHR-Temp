module payroll {
    # Pay types for different compensation structures
    scalar type PayType extending enum<Salary, Hourly, Commission, Contract>;
    
    # Pay period types
    scalar type PayPeriodType extending enum<Weekly, BiWeekly, SemiMonthly, Monthly>;
    
    # Pay period status
    scalar type PayPeriodStatus extending enum<Draft, Open, Processing, Finalized, Paid>;
    
    # Paystub status
    scalar type PaystubStatus extending enum<Draft, Generated, Delivered, Viewed>;
    
    # Deduction types
    scalar type DeductionType extending enum<Tax, Insurance, Retirement, Union, Garnishment, Other>;
    
    # Tax types
    scalar type TaxType extending enum<Federal, State, Local, SocialSecurity, Medicare, Unemployment>;

    # Salary band for compensation management
    type SalaryBand {
        required property title -> str;
        required property min_salary -> int32;
        required property max_salary -> int32;
        property currency -> str {
            default := "USD";
        };
        property grade_level -> int32;
        property department -> str;
        property location -> str;
        property experience_level -> str;
        property is_active -> bool {
            default := true;
        };
        property notes -> str;
        
        # Metadata
        required property created_at -> datetime {
            default := datetime_current();
        };
        required property updated_at -> datetime {
            default := datetime_current();
        };
        
        # Relationships
        multi link employees := .<salary_band[is PayrollEmployee];
    }

    # Payroll employee configuration
    type PayrollEmployee {
        required link employee -> rbac::User {
            constraint exclusive;
        };
        
        # Compensation details
        required property pay_type -> PayType;
        required property base_salary -> int32;
        property hourly_rate -> float32;
        property annual_salary -> int32;
        property commission_rate -> float32;
        property overtime_rate -> float32;
        
        # Pay schedule
        required property pay_period_type -> PayPeriodType;
        property pay_day -> int32; # Day of month or week
        
        # Banking information
        property bank_name -> str;
        property account_number -> str;
        property routing_number -> str;
        property account_type -> str; # Checking, Savings
        
        # Tax withholding
        property federal_allowances -> int32;
        property state_allowances -> int32;
        property additional_federal_withholding -> float32;
        property additional_state_withholding -> float32;
        property exempt_federal -> bool {
            default := false;
        };
        property exempt_state -> bool {
            default := false;
        };
        
        # Benefits and deductions
        property health_insurance_deduction -> float32;
        property dental_insurance_deduction -> float32;
        property vision_insurance_deduction -> float32;
        property retirement_contribution_percent -> float32;
        property retirement_contribution_amount -> float32;
        
        # Employment details
        property start_date -> datetime;
        property end_date -> datetime;
        property is_active -> bool {
            default := true;
        };
        
        # Salary band assignment
        link salary_band -> SalaryBand;
        
        # Metadata
        required property created_at -> datetime {
            default := datetime_current();
        };
        required property updated_at -> datetime {
            default := datetime_current();
        };
        
        # Relationships
        multi link pay_periods := .<payroll_employee[is PayPeriod];
        multi link paystubs := .<payroll_employee[is Paystub];
        multi link compensation_changes := .<payroll_employee[is CompensationChange];
    }

    # Pay period management
    type PayPeriod {
        required property period_start -> datetime;
        required property period_end -> datetime;
        required property pay_date -> datetime;
        required property status -> PayPeriodStatus {
            default := PayPeriodStatus.Draft;
        };
        
        # Pay period details
        required property pay_period_type -> PayPeriodType;
        property period_number -> int32;
        property year -> int32;
        property quarter -> int32;
        
        # Processing information
        property processed_date -> datetime;
        link processed_by -> rbac::User;
        property finalized_date -> datetime;
        link finalized_by -> rbac::User;
        property paid_date -> datetime;
        
        # Totals
        property total_gross_pay -> float32;
        property total_net_pay -> float32;
        property total_taxes -> float32;
        property total_deductions -> float32;
        property total_employees -> int32;
        
        # Notes and adjustments
        property notes -> str;
        property has_adjustments -> bool {
            default := false;
        };
        
        # Specific employee assignment (optional - can be for all employees)
        link payroll_employee -> PayrollEmployee;
        
        # Metadata
        required property created_at -> datetime {
            default := datetime_current();
        };
        required property updated_at -> datetime {
            default := datetime_current();
        };
        
        # Relationships
        multi link paystubs := .<pay_period[is Paystub];
    }

    # Individual paystub for each employee per pay period
    type Paystub {
        required link payroll_employee -> PayrollEmployee;
        required link pay_period -> PayPeriod;
        
        required property status -> PaystubStatus {
            default := PaystubStatus.Draft;
        };
        
        # Earnings
        property regular_hours -> float32;
        property overtime_hours -> float32;
        property vacation_hours -> float32;
        property sick_hours -> float32;
        property holiday_hours -> float32;
        property bonus_amount -> float32;
        property commission_amount -> float32;
        property other_earnings -> float32;
        
        # Gross pay calculation
        property regular_pay -> float32;
        property overtime_pay -> float32;
        property vacation_pay -> float32;
        property sick_pay -> float32;
        property holiday_pay -> float32;
        required property gross_pay -> float32;
        
        # Tax withholdings
        property federal_income_tax -> float32;
        property state_income_tax -> float32;
        property local_income_tax -> float32;
        property social_security_tax -> float32;
        property medicare_tax -> float32;
        property unemployment_tax -> float32;
        property total_taxes -> float32;
        
        # Other deductions
        property health_insurance -> float32;
        property dental_insurance -> float32;
        property vision_insurance -> float32;
        property retirement_contribution -> float32;
        property union_dues -> float32;
        property garnishments -> float32;
        property other_deductions -> float32;
        property total_deductions -> float32;
        
        # Net pay
        required property net_pay -> float32;
        
        # Year-to-date totals
        property ytd_gross_pay -> float32;
        property ytd_taxes -> float32;
        property ytd_deductions -> float32;
        property ytd_net_pay -> float32;
        
        # Direct deposit information
        property direct_deposit_amount -> float32;
        property check_amount -> float32;
        property is_direct_deposit -> bool {
            default := true;
        };
        
        # Document management
        property paystub_pdf_url -> str;
        property generated_date -> datetime;
        property delivered_date -> datetime;
        property viewed_date -> datetime;
        
        # Adjustments and notes
        property adjustments -> json;
        property notes -> str;
        property memo -> str;
        
        # Metadata
        required property created_at -> datetime {
            default := datetime_current();
        };
        required property updated_at -> datetime {
            default := datetime_current();
        };
        
        # Unique constraint
        constraint exclusive on ((.payroll_employee, .pay_period));
    }

    # Compensation change history
    type CompensationChange {
        required link payroll_employee -> PayrollEmployee;
        
        # Change details
        required property change_type -> str; # Salary, Hourly Rate, Bonus, Promotion, etc.
        required property effective_date -> datetime;
        property end_date -> datetime;
        
        # Previous values
        property previous_base_salary -> int32;
        property previous_hourly_rate -> float32;
        property previous_pay_type -> PayType;
        
        # New values
        property new_base_salary -> int32;
        property new_hourly_rate -> float32;
        property new_pay_type -> PayType;
        
        # Change details
        required property reason -> str;
        property notes -> str;
        link approved_by -> rbac::User;
        property approved_date -> datetime;
        
        # Performance-related
        property performance_rating -> str;
        property merit_increase_percent -> float32;
        property market_adjustment_percent -> float32;
        
        # Promotion details
        property previous_title -> str;
        property new_title -> str;
        property previous_department -> str;
        property new_department -> str;
        link previous_manager -> rbac::User;
        link new_manager -> rbac::User;
        
        # Salary band changes
        link previous_salary_band -> SalaryBand;
        link new_salary_band -> SalaryBand;
        
        # Metadata
        link created_by -> rbac::User;
        required property created_at -> datetime {
            default := datetime_current();
        };
        required property updated_at -> datetime {
            default := datetime_current();
        };
    }

    # Tax rate tables for calculations
    type TaxRate {
        required property tax_type -> TaxType;
        required property jurisdiction -> str; # Federal, State Name, City Name
        required property year -> int32;
        
        # Rate structure
        required property rate_percent -> float32;
        property min_income -> float32;
        property max_income -> float32;
        property flat_amount -> float32;
        
        # Additional details
        property filing_status -> str; # Single, Married, etc.
        property pay_frequency -> str; # Weekly, BiWeekly, etc.
        property is_active -> bool {
            default := true;
        };
        
        # Metadata
        required property created_at -> datetime {
            default := datetime_current();
        };
        required property updated_at -> datetime {
            default := datetime_current();
        };
        
        # Unique constraint
        constraint exclusive on ((.tax_type, .jurisdiction, .year, .filing_status, .pay_frequency));
    }

    # Payroll run summary
    type PayrollRun {
        required property run_date -> datetime;
        required link pay_period -> PayPeriod;
        
        # Run details
        required property status -> str; # Pending, Processing, Completed, Failed
        property employees_processed -> int32;
        property employees_failed -> int32;
        property total_gross_pay -> float32;
        property total_net_pay -> float32;
        property total_taxes -> float32;
        property total_deductions -> float32;
        
        # Processing details
        link started_by -> rbac::User;
        property started_at -> datetime;
        property completed_at -> datetime;
        property processing_time_seconds -> int32;
        
        # Error handling
        property errors -> json;
        property warnings -> json;
        property processing_log -> str;
        
        # Approval and finalization
        property requires_approval -> bool {
            default := true;
        };
        link approved_by -> rbac::User;
        property approved_at -> datetime;
        link finalized_by -> rbac::User;
        property finalized_at -> datetime;
        
        # Metadata
        required property created_at -> datetime {
            default := datetime_current();
        };
        required property updated_at -> datetime {
            default := datetime_current();
        };
    }
}