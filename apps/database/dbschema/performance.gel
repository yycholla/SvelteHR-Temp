# Performance Management Schema for geldb
# This schema defines performance reviews, goals, feedback, and analytics

module performance {
    # Enums for performance management
    scalar type ReviewStatus extending enum<Draft, InProgress, Submitted, UnderReview, Completed, Overdue>;
    scalar type ReviewType extending enum<Annual, Quarterly, Probationary, ProjectBased, SelfReview, PeerReview, ManagerReview>;
    scalar type QuestionType extending enum<Text, Textarea, Rating, Scale, MultipleChoice, Checkbox, YesNo, FileUpload>;
    scalar type GoalStatus extending enum<NotStarted, InProgress, OnTrack, AtRisk, Completed, Cancelled>;
    scalar type FeedbackType extending enum<Continuous, Formal, Peer, Upward, Downward>;
    
    # Performance Review Template
    type ReviewTemplate {
        required property name -> str {
            constraint max_len_value(255);
        };
        property description -> str;
        property version -> int32 {
            default := 1;
        };
        property is_default -> bool {
            default := false;
        };
        property is_active -> bool {
            default := true;
        };
        property review_type -> ReviewType {
            default := ReviewType.Annual;
        };
        
        # Relationships
        multi link departments -> default::Department;
        multi link roles -> rbac::Role;
        multi link sections -> ReviewTemplateSection;
        link created_by -> rbac::User;
        
        # Metadata
        property created_at -> datetime {
            default := datetime_current();
        };
        property updated_at -> datetime {
            default := datetime_current();
        };
    }
    
    # Review Template Sections
    type ReviewTemplateSection {
        required property title -> str {
            constraint max_len_value(255);
        };
        property description -> str;
        required property order_index -> int32;
        property is_required -> bool {
            default := false;
        };
        property weight -> float32 {
            default := 1.0;
        };
        
        # Relationships
        required link template -> ReviewTemplate;
        multi link questions -> ReviewQuestion;
        
        # Metadata
        property created_at -> datetime {
            default := datetime_current();
        };
        property updated_at -> datetime {
            default := datetime_current();
        };
    }
    
    # Review Questions
    type ReviewQuestion {
        required property title -> str {
            constraint max_len_value(500);
        };
        property description -> str;
        required property question_type -> QuestionType;
        required property order_index -> int32;
        property is_required -> bool {
            default := false;
        };
        property config -> json;  # Store question-specific configuration
        
        # Relationships
        required link section -> ReviewTemplateSection;
        
        # Metadata
        property created_at -> datetime {
            default := datetime_current();
        };
        property updated_at -> datetime {
            default := datetime_current();
        };
    }
    
    # Performance Review Instance
    type PerformanceReview {
        required property review_period_start -> datetime;
        required property review_period_end -> datetime;
        required property due_date -> datetime;
        property submit_date -> datetime;
        property completion_date -> datetime;
        property status -> ReviewStatus {
            default := ReviewStatus.Draft;
        };
        property overall_score -> float32;
        property manager_comments -> str;
        property employee_comments -> str;
        property self_assessment_complete -> bool {
            default := false;
        };
        property manager_review_complete -> bool {
            default := false;
        };
        
        # Relationships
        required link employee -> rbac::User;
        required link template -> ReviewTemplate;
        link reviewer -> rbac::User;  # Usually the manager
        link created_by -> rbac::User;
        multi link responses -> ReviewResponse;
        multi link goals -> PerformanceGoal;
        
        # Metadata
        property created_at -> datetime {
            default := datetime_current();
        };
        property updated_at -> datetime {
            default := datetime_current();
        };
    }
    
    # Review Responses
    type ReviewResponse {
        property text_value -> str;
        property numeric_value -> float32;
        property json_value -> json;  # For complex responses
        property score -> float32;
        property is_complete -> bool {
            default := false;
        };
        
        # Relationships
        required link review -> PerformanceReview;
        required link question -> ReviewQuestion;
        link responder -> rbac::User;  # Who provided this response
        
        # Metadata
        property created_at -> datetime {
            default := datetime_current();
        };
        property updated_at -> datetime {
            default := datetime_current();
        };
    }
    
    # Performance Goals
    type PerformanceGoal {
        required property title -> str {
            constraint max_len_value(255);
        };
        property description -> str;
        property target_date -> datetime;
        property completion_date -> datetime;
        property status -> GoalStatus {
            default := GoalStatus.NotStarted;
        };
        property progress_percentage -> int32 {
            default := 0;
            constraint min_value(0);
            constraint max_value(100);
        };
        property weight -> float32 {
            default := 1.0;
        };
        property is_smart_goal -> bool {
            default := false;
        };
        property measurable_criteria -> str;
        property success_metrics -> json;
        
        # Relationships
        required link employee -> rbac::User;
        link manager -> rbac::User;
        link review -> PerformanceReview;  # Optional - goals can exist outside reviews
        multi link progress_updates -> GoalProgressUpdate;
        
        # Metadata
        property created_at -> datetime {
            default := datetime_current();
        };
        property updated_at -> datetime {
            default := datetime_current();
        };
    }
    
    # Goal Progress Updates
    type GoalProgressUpdate {
        required property update_text -> str;
        property progress_percentage -> int32 {
            constraint min_value(0);
            constraint max_value(100);
        };
        property challenges -> str;
        property next_steps -> str;
        property is_milestone -> bool {
            default := false;
        };
        
        # Relationships
        required link goal -> PerformanceGoal;
        required link updated_by -> rbac::User;
        
        # Metadata
        property created_at -> datetime {
            default := datetime_current();
        };
    }
    
    # Continuous Feedback
    type Feedback {
        required property content -> str;
        property feedback_type -> FeedbackType {
            default := FeedbackType.Continuous;
        };
        property is_anonymous -> bool {
            default := false;
        };
        property is_public -> bool {
            default := false;
        };
        property rating -> int32 {
            constraint min_value(1);
            constraint max_value(5);
        };
        property tags -> array<str>;
        
        # Relationships
        required link recipient -> rbac::User;
        link giver -> rbac::User;  # Can be null for anonymous feedback
        link related_goal -> PerformanceGoal;
        link related_review -> PerformanceReview;
        
        # Metadata
        property created_at -> datetime {
            default := datetime_current();
        };
        property updated_at -> datetime {
            default := datetime_current();
        };
    }
    
    # Performance Metrics and Analytics
    type PerformanceMetric {
        required property metric_name -> str {
            constraint max_len_value(255);
        };
        required property metric_value -> float32;
        property metric_unit -> str;
        property metric_type -> str;  # e.g., 'score', 'percentage', 'count'
        property period_start -> datetime;
        property period_end -> datetime;
        property context -> json;  # Additional metadata
        
        # Relationships
        required link employee -> rbac::User;
        link department -> default::Department;
        link review -> PerformanceReview;
        
        # Metadata
        property created_at -> datetime {
            default := datetime_current();
        };
    }
    
    # Development Plans
    type DevelopmentPlan {
        required property title -> str {
            constraint max_len_value(255);
        };
        property description -> str;
        required property target_date -> datetime;
        property completion_date -> datetime;
        property status -> GoalStatus {
            default := GoalStatus.NotStarted;
        };
        property skills_to_develop -> array<str>;
        property learning_resources -> json;
        property budget_allocated -> float32;
        property budget_used -> float32;
        
        # Relationships
        required link employee -> rbac::User;
        link manager -> rbac::User;
        link mentor -> rbac::User;
        multi link activities -> DevelopmentActivity;
        
        # Metadata
        property created_at -> datetime {
            default := datetime_current();
        };
        property updated_at -> datetime {
            default := datetime_current();
        };
    }
    
    # Development Activities
    type DevelopmentActivity {
        required property title -> str {
            constraint max_len_value(255);
        };
        property description -> str;
        property activity_type -> str;  # e.g., 'training', 'mentoring', 'project'
        property duration_hours -> int32;
        property cost -> float32;
        property completion_date -> datetime;
        property status -> GoalStatus {
            default := GoalStatus.NotStarted;
        };
        property learning_outcomes -> str;
        property certification_earned -> str;
        
        # Relationships
        required link plan -> DevelopmentPlan;
        required link employee -> rbac::User;
        
        # Metadata
        property created_at -> datetime {
            default := datetime_current();
        };
        property updated_at -> datetime {
            default := datetime_current();
        };
    }
}
