module hr_workflows {

    # Task Management
    type Task extending default::Auditable {
        required property title -> str;
        property description -> str;
        property status -> default::TaskStatus {
            default := default::TaskStatus.Pending;
        }
        property priority -> str {
            default := 'medium';
        }
        property due_date -> datetime;
        property completion_date -> datetime;
        property estimated_hours -> decimal;
        property actual_hours -> decimal;
        
        # Relationships
        required link assigned_to -> rbac::User;
        link created_by -> rbac::User;
        link parent_task -> Task;
        multi link subtasks := .<parent_task[is Task];
        multi link dependencies -> Task;
        
        # Computed properties
        property completion_percentage := count(.subtasks filter .status = default::TaskStatus.Completed) / count(.subtasks) * 100 if count(.subtasks) > 0 else (100 if .status = default::TaskStatus.Completed else 0);
        
        # Indexes
        index on (.status);
        index on (.due_date);
        index on (.assigned_to);
    }

    # Task Templates for recurring tasks
    type TaskTemplate extending default::Auditable {
        required property title -> str;
        property description -> str;
        property default_priority -> str {
            default := 'medium';
        }
        property estimated_hours -> decimal;
        property days_to_complete -> int32;
        link default_assignee -> rbac::User;
        property is_active -> bool {
            default := true;
        }
        
    }

    # Leave Balance
    type LeaveBalance extending default::Auditable {
        required link employee -> rbac::User;
        required property leave_type -> str; # Vacation, Sick, Personal, etc.
        property balance -> decimal {
            default := 0;
        }
        property accrued_ytd -> decimal {
            default := 0;
        }
        property used_ytd -> decimal {
            default := 0;
        }
        property carry_over_limit -> decimal;
        property accrual_rate -> decimal; # per pay period
        property last_updated -> datetime;
        
        # Constraints
        constraint exclusive on ((.employee, .leave_type));
        
        # Computed properties
        property available_balance := .balance - .used_ytd;
        property projected_balance := .balance + (.accrual_rate * 26); # Assuming biweekly pay
        
        # Indexes
        index on (.employee);
        index on (.leave_type);
    }

    # Leave Requests
    type Leave extending default::Auditable {
        required link leave_balance -> LeaveBalance;
        required property start_date -> cal::local_date;
        required property end_date -> cal::local_date;
        property status -> default::ApprovalStatus {
            default := default::ApprovalStatus.Pending;
        }
        property reason -> str;
        property days_requested -> decimal;
        link approver -> rbac::User;
        property approved_at -> datetime;
        property comments -> str;
        property is_emergency -> bool {
            default := false;
        }
        
        # Computed properties
        property is_pending := .status = default::ApprovalStatus.Pending;
        property is_approved := .status = default::ApprovalStatus.Approved;
        
        # Constraints
        constraint expression on (.start_date <= .end_date);
        
        # Indexes
        index on (.status);
        index on (.start_date);
        index on (.end_date);
        index on (.leave_balance);
    }

    # Attendance Tracking
    type Attendance extending default::Auditable {
        required link employee -> rbac::User;
        required property date -> cal::local_date;
        property status -> default::AttendanceStatus {
            default := default::AttendanceStatus.Present;
        }
        property clock_in_time -> cal::local_time;
        property clock_out_time -> cal::local_time;
        property break_duration -> duration;
        property total_hours -> decimal;
        property overtime_hours -> decimal;
        property approval_status -> default::ApprovalStatus {
            default := default::ApprovalStatus.Pending;
        }
        link approved_by -> rbac::User;
        property notes -> str;
        
        # Computed properties
        property is_late := (.clock_in_time ?? <cal::local_time>'09:00:00') > <cal::local_time>'09:00:00';
        property left_early := (.clock_out_time ?? <cal::local_time>'17:00:00') < <cal::local_time>'17:00:00';
        
        # Constraints
        constraint exclusive on ((.employee, .date));
        constraint expression on ((.clock_out_time ?? <cal::local_time>{}) >= (.clock_in_time ?? <cal::local_time>{}));
        
        # Indexes
        index on (.employee);
        index on (.date);
        index on (.status);
    }

    # Time Entries for detailed tracking
    type TimeEntry extending default::Auditable {
        required link attendance -> Attendance;
        required property entry_type -> default::TimeEntryType;
        required property timestamp -> datetime;
        property location -> str;
        property ip_address -> str;
        property device_info -> str;
        property notes -> str;
        
        # Computed
        property date := cal::to_local_date(.timestamp, 'UTC');
        
        # Indexes
        index on (.attendance);
        index on (.entry_type);
        index on (.timestamp);
    }

    # HR Requests
    type HRRequest extending portal_communication::FormEnabled {
        required link employee -> rbac::User;
        required property request_type -> str; # Policy Question, Benefits, etc.
        required property subject -> str;
        required property description -> str;
        property status -> default::ApprovalStatus {
            default := default::ApprovalStatus.Pending;
        }
        property priority -> str {
            default := 'medium';
        }
        link assigned_to_user -> rbac::User;
        property resolution -> str;
        property resolved_at -> datetime;
        
        # Computed properties
        property is_resolved := .status = default::ApprovalStatus.Approved;
        
        # Indexes
        index on (.status);
        index on (.employee);
        index on (.request_type);
    }

    # Change Requests for employee data changes
    type ChangeRequest extending portal_communication::FormEnabled {
        required link employee -> rbac::User;
        required property change_type -> str; # Address, Emergency Contact, etc.
        required property field_name -> str;
        property old_value -> str;
        property new_value -> str;
        property status -> default::ApprovalStatus {
            default := default::ApprovalStatus.Pending;
        }
        link reviewed_by -> rbac::User;
        property reviewed_at -> datetime;
        property reason -> str;
        property supporting_documents -> json;
        
        # Computed
        property is_pending := .status = default::ApprovalStatus.Pending;
        
        # Indexes
        index on (.employee);
        index on (.status);
        index on (.change_type);
    }
}