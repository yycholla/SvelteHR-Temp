module time_attendance {
    # Enum types for time and attendance
    scalar type TimeEntryType extending enum<ClockIn, ClockOut, BreakStart, BreakEnd, LunchStart, LunchEnd>;
    scalar type TimesheetStatus extending enum<Draft, Submitted, UnderReview, Approved, Rejected>;
    scalar type TimeOffType extending enum<Vacation, Sick, Personal, Holiday, Bereavement, Jury, Military, FMLA>;
    scalar type TimeOffStatus extending enum<Pending, Approved, Denied, Cancelled>;
    scalar type ScheduleStatus extending enum<Scheduled, Published, Cancelled>;
    scalar type AttendanceStatus extending enum<Present, Late, Absent, PartialDay, Excused>;
    scalar type OvertimeType extending enum<Regular, Premium, Double>;

    # Time Clock Entry - individual clock in/out events
    type TimeEntry {
        required employee: rbac::User;
        required entry_type: TimeEntryType;
        required timestamp: datetime;
        location: str;
        ip_address: str;
        notes: str;
        is_manual: bool {
            default := false;
        };
        manual_reason: str;
        approved_by: rbac::User;
        approved_at: datetime;
        created_at: datetime {
            default := datetime_current();
        };
        updated_at: datetime {
            default := datetime_current();
        };

        # Computed properties
        property formatted_timestamp := to_str(.timestamp, 'YYYY-MM-DD HH24:MI:SS');
    }

    # Work Session - paired clock in/out with breaks
    type WorkSession {
        required employee: rbac::User;
        required start_time: datetime;
        end_time: datetime;
        break_duration: duration; # Total break time
        lunch_duration: duration;
        total_hours: float32;
        overtime_hours: float32;
        overtime_type: OvertimeType;
        location: str;
        notes: str;
        is_approved: bool {
            default := false;
        };
        approved_by: rbac::User;
        approved_at: datetime;
        created_at: datetime {
            default := datetime_current();
        };
        updated_at: datetime {
            default := datetime_current();
        };

        # Links to time entries
        multi time_entries: TimeEntry {
            on target delete allow;
        };

        # Computed properties
        property work_date := to_str(.start_time, 'YYYY-MM-DD');
        property duration := .end_time - .start_time;
        property effective_work_time := (.end_time - .start_time) - .break_duration - .lunch_duration;
    }

    # Timesheet - collection of work sessions for a period
    type Timesheet {
        required employee: rbac::User;
        required period_start: datetime;
        required period_end: datetime;
        required status: TimesheetStatus {
            default := TimesheetStatus.Draft;
        };
        total_regular_hours: float32 {
            default := 0.0;
        };
        total_overtime_hours: float32 {
            default := 0.0;
        };
        total_break_hours: float32 {
            default := 0.0;
        };
        employee_notes: str;
        manager_notes: str;
        submitted_at: datetime;
        submitted_by: rbac::User;
        reviewed_at: datetime;
        reviewed_by: rbac::User;
        approved_at: datetime;
        approved_by: rbac::User;
        created_at: datetime {
            default := datetime_current();
        };
        updated_at: datetime {
            default := datetime_current();
        };

        # Links to work sessions
        multi work_sessions: WorkSession {
            on target delete allow;
        };

        # Computed properties
        property period_days := duration_to_seconds(.period_end - .period_start) / 86400;
        # property is_current_period removed due to datetime_current() volatility
    }

    # Time Off Request
    type TimeOffRequest {
        required employee: rbac::User;
        required time_off_type: TimeOffType;
        required start_date: datetime;
        required end_date: datetime;
        required days_requested: float32;
        required status: TimeOffStatus {
            default := TimeOffStatus.Pending;
        };
        reason: str;
        employee_notes: str;
        manager_notes: str;
        is_paid: bool {
            default := true;
        };
        documentation_required: bool {
            default := false;
        };
        documentation_received: bool {
            default := false;
        };
        requested_by: rbac::User;
        requested_at: datetime {
            default := datetime_current();
        };
        reviewed_by: rbac::User;
        reviewed_at: datetime;
        approved_by: rbac::User;
        approved_at: datetime;
        denied_reason: str;
        created_at: datetime {
            default := datetime_current();
        };
        updated_at: datetime {
            default := datetime_current();
        };

        # Computed properties
        property duration_days := duration_to_seconds(.end_date - .start_date) / 86400;
        # properties is_current, is_future, is_past removed due to datetime_current() volatility
    }

    # Time Off Balance - tracks available time off by type
    type TimeOffBalance {
        required employee: rbac::User;
        required time_off_type: TimeOffType;
        required accrual_year: int32;
        allocated_hours: float32 {
            default := 0.0;
        };
        used_hours: float32 {
            default := 0.0;
        };
        pending_hours: float32 {
            default := 0.0;
        };
        carryover_hours: float32 {
            default := 0.0;
        };
        accrual_rate: float32; # Hours per pay period
        max_balance: float32;
        expires_at: datetime;
        created_at: datetime {
            default := datetime_current();
        };
        updated_at: datetime {
            default := datetime_current();
        };

        # Computed properties
        property available_hours := .allocated_hours + .carryover_hours - .used_hours - .pending_hours;
        property utilization_percentage := (.used_hours / (.allocated_hours + .carryover_hours)) * 100;

        # Constraints
        constraint exclusive on ((.employee, .time_off_type, .accrual_year));
    }

    # Schedule Template - defines work schedules
    type ScheduleTemplate {
        required name: str;
        description: str;
        monday_start: str; # HH:MM format
        monday_end: str;
        tuesday_start: str;
        tuesday_end: str;
        wednesday_start: str;
        wednesday_end: str;
        thursday_start: str;
        thursday_end: str;
        friday_start: str;
        friday_end: str;
        saturday_start: str;
        saturday_end: str;
        sunday_start: str;
        sunday_end: str;
        weekly_hours: float32;
        is_active: bool {
            default := true;
        };
        created_by: rbac::User;
        created_at: datetime {
            default := datetime_current();
        };
        updated_at: datetime {
            default := datetime_current();
        };

        # Computed properties
        property is_full_time := .weekly_hours >= 40.0;
        property is_part_time := .weekly_hours < 40.0;
    }

    # Employee Schedule Assignment
    type EmployeeSchedule {
        required employee: rbac::User;
        required schedule_template: ScheduleTemplate;
        required effective_date: datetime;
        end_date: datetime;
        is_active: bool {
            default := true;
        };
        assigned_by: rbac::User;
        notes: str;
        created_at: datetime {
            default := datetime_current();
        };
        updated_at: datetime {
            default := datetime_current();
        };

        # Computed properties
        # property is_current removed due to datetime_current() volatility
    }

    # Shift - specific work periods
    type Shift {
        required employee: rbac::User;
        required schedule_date: datetime;
        required start_time: datetime;
        required end_time: datetime;
        required status: ScheduleStatus {
            default := ScheduleStatus.Scheduled;
        };
        break_duration: duration;
        lunch_duration: duration;
        location: str;
        notes: str;
        created_by: rbac::User;
        created_at: datetime {
            default := datetime_current();
        };
        updated_at: datetime {
            default := datetime_current();
        };

        # Computed properties
        property scheduled_hours := duration_to_seconds(.end_time - .start_time) / 3600;
        property net_hours := .scheduled_hours - (duration_to_seconds(.break_duration ?? <duration>'0') / 3600) - (duration_to_seconds(.lunch_duration ?? <duration>'0') / 3600);
        # properties is_today, is_future, is_past removed due to datetime_current() volatility
    }

    # Attendance Record - daily attendance summary
    type AttendanceRecord {
        required employee: rbac::User;
        required attendance_date: datetime;
        required status: AttendanceStatus;
        clock_in_time: datetime;
        clock_out_time: datetime;
        scheduled_start: datetime;
        scheduled_end: datetime;
        total_hours: float32 {
            default := 0.0;
        };
        break_hours: float32 {
            default := 0.0;
        };
        overtime_hours: float32 {
            default := 0.0;
        };
        late_minutes: int32 {
            default := 0;
        };
        early_departure_minutes: int32 {
            default := 0;
        };
        notes: str;
        created_at: datetime {
            default := datetime_current();
        };
        updated_at: datetime {
            default := datetime_current();
        };

        # Links
        work_session: WorkSession;
        shift: Shift;

        # Computed properties
        property is_late := .late_minutes > 0;
        property is_early_departure := .early_departure_minutes > 0;
        property attendance_score := 100 - (.late_minutes * 0.5) - (.early_departure_minutes * 0.5);

        # Constraints
        constraint exclusive on ((.employee, .attendance_date));
    }

    # Overtime Policy
    type OvertimePolicy {
        required name: str;
        description: str;
        daily_threshold: float32 {
            default := 8.0;
        };
        weekly_threshold: float32 {
            default := 40.0;
        };
        premium_multiplier: float32 {
            default := 1.5;
        };
        double_time_threshold: float32; # Hours after which double time applies
        double_time_multiplier: float32 {
            default := 2.0;
        };
        is_active: bool {
            default := true;
        };
        effective_date: datetime;
        created_by: rbac::User;
        created_at: datetime {
            default := datetime_current();
        };
        updated_at: datetime {
            default := datetime_current();
        };
    }

    # Time Tracking Analytics Views
    type AttendanceAnalytics {
        period_start: datetime;
        period_end: datetime;
        total_employees: int32;
        present_count: int32;
        late_count: int32;
        absent_count: int32;
        average_hours_per_employee: float32;
        total_overtime_hours: float32;
        attendance_rate: float32;
        punctuality_rate: float32;
        generated_at: datetime {
            default := datetime_current();
        };
    }
}