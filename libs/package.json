{
  "name": "authentication-testing-workspace",
  "version": "1.0.0",
  "description": "Workspace for authentication testing libraries",
  "private": true,
  "workspaces": [
    "auth-test-orchestrator",
    "test-result-analyzer",
    "auth-test-reporter",
    "shared"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "build:all": "npm run build --workspaces",
    "test:all": "npm run test --workspaces",
    "lint:all": "npm run lint --workspaces",
    "clean:all": "npm run clean --workspaces",
    "dev:orchestrator": "npm run dev --workspace=auth-test-orchestrator",
    "dev:analyzer": "npm run dev --workspace=test-result-analyzer",
    "dev:reporter": "npm run dev --workspace=auth-test-reporter",
    "test:contract": "npm run test:contract --workspaces",
    "test:unit": "npm run test:unit --workspaces",
    "test:integration": "npm run test:integration --workspaces",
    "validate": "npm run lint:all && npm run test:all && npm run build:all"
  },
  "keywords": [
    "authentication",
    "testing",
    "orchestration",
    "analysis",
    "reporting",
    "playwright"
  ],
  "author": "SvelteHR Team",
  "license": "MIT",
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "concurrently": "^8.2.2"
  }
}