{
  "name": "test-result-analyzer",
  "version": "1.0.0",
  "description": "Pattern detection and failure correlation for authentication test results",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "auth-analyze": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:contract": "vitest tests/contract",
    "test:unit": "vitest tests/unit",
    "test:integration": "vitest tests/integration",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "test-analysis",
    "pattern-detection",
    "correlation",
    "statistics",
    "failure-analysis",
    "authentication"
  ],
  "author": "SvelteHR Team",
  "license": "MIT",
  "dependencies": {
    "commander": "^11.1.0",
    "chalk": "^5.3.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4",
    "winston": "^3.11.0",
    "lodash": "^4.17.21",
    "simple-statistics": "^7.8.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "@types/lodash": "^4.14.202",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.2",
    "vitest": "^1.0.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ]
}