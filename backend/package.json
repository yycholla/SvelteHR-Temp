{
  "name": "@sveltehr/backend",
  "version": "1.0.0",
  "description": "Complete PostGraphile GraphQL server for SvelteHR system",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:dev": "tsx src/server.ts",
    "start:prod": "NODE_ENV=production tsx src/server.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:contract": "jest tests/contract",
    "test:integration": "jest tests/integration",
    "test:unit": "jest tests/unit",
    "test:hr": "jest tests/contract/test_*_graphql.js tests/integration/test_hr_*.js",
    "test:workflows": "jest tests/integration/test_*_flow.js",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist coverage *.log logs/*.log",
    "validate": "npm run type-check && npm run lint:check",
    "schema:watch": "postgraphile --connection $DATABASE_URL --schema hr_public --watch --enhance-graphiql",
    "schema:validate": "npm run postgraphile:standalone --dry-run",
    "db:migrate": "tsx ../database/migrations/*.sql",
    "db:migrate:hr": "tsx migrations/migrate.ts migrate",
    "db:migrate:hr:status": "tsx migrations/migrate.ts status",
    "db:migrate:hr:rollback": "tsx migrations/migrate.ts rollback",
    "db:migrate:hr:create": "tsx migrations/migrate.ts create"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "graphile-build": "^4.14.1",
    "graphile-build-pg": "^4.14.1",
    "helmet": "^7.1.0",
    "http-proxy-middleware": "^2.0.6",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "node-cache": "^5.1.2",
    "pg": "^8.11.3",
    "postgraphile": "^4.14.1",
    "postgraphile-plugin-connection-filter": "^2.3.0",
    "redis": "^4.7.1",
    "winston": "^3.17.0",
    "graphile-utils": "^4.13.0",
    "postgraphile-plugin-nested-mutations": "^1.0.3",
    "postgraphile-plugin-upload-field": "^1.0.1",
    "@graphile-contrib/pg-aggregates": "^1.0.2",
    "@graphile-contrib/pg-many-to-many": "^1.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "graphql-upload": "^16.0.2",
    "graphql-ws": "^5.14.2",
    "ws": "^8.14.2",
    "joi": "^17.11.0",
    "date-fns": "^2.30.0",
    "csv-writer": "^1.6.0",
    "xlsx": "^0.18.5",
    "sharp": "^0.32.6",
    "pdf-lib": "^1.17.1",
    "agenda": "^5.0.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "node-notifier": "^10.0.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "tsx": "^4.6.0",
    "typescript": "^5.3.2",
    "@types/multer": "^1.4.11",
    "@types/nodemailer": "^6.4.14",
    "@types/ws": "^8.5.10",
    "@types/joi": "^17.2.3",
    "@types/node-cron": "^3.0.11",
    "graphql-schema-linter": "^3.0.1"
  },
  "keywords": [
    "hr",
    "graphql",
    "postgraphile",
    "postgresql",
    "redis",
    "jwt",
    "authentication",
    "express",
    "typescript",
    "performance",
    "monitoring",
    "caching",
    "enterprise"
  ],
  "author": "SvelteHR Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/svelteHR/svelteHR.git",
    "directory": "backend"
  }
}
