{
  "name": "@sveltehr/backend",
  "version": "1.0.0",
  "description": "Complete PostGraphile GraphQL server for SvelteHR system",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:dev": "tsx src/server.ts",
    "start:prod": "NODE_ENV=production tsx src/server.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:contract": "jest tests/contract",
    "test:integration": "jest tests/integration",
    "test:unit": "jest tests/unit",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist coverage *.log logs/*.log",
    "validate": "npm run type-check && npm run lint:check",
    "schema:watch": "postgraphile --connection $DATABASE_URL --schema hr_public --watch --enhance-graphiql",
    "schema:validate": "npm run postgraphile:standalone --dry-run",
    "db:migrate": "tsx ../database/migrations/*.sql"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "graphile-build": "^4.14.1",
    "graphile-build-pg": "^4.14.1",
    "helmet": "^7.1.0",
    "http-proxy-middleware": "^2.0.6",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "node-cache": "^5.1.2",
    "pg": "^8.11.3",
    "postgraphile": "^4.14.1",
    "postgraphile-plugin-connection-filter": "^2.3.0",
    "redis": "^4.7.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "node-notifier": "^10.0.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "tsx": "^4.6.0",
    "typescript": "^5.3.2"
  },
  "keywords": [
    "hr",
    "graphql",
    "postgraphile",
    "postgresql",
    "redis",
    "jwt",
    "authentication",
    "express",
    "typescript",
    "performance",
    "monitoring",
    "caching",
    "enterprise"
  ],
  "author": "SvelteHR Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/svelteHR/svelteHR.git",
    "directory": "backend"
  }
}
