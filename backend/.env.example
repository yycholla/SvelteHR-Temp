# Database Configuration
DATABASE_URL=postgres://postgres:postgres123@localhost:5432/hr_system

# Redis Configuration  
REDIS_URL=redis://localhost:6379

# JWT Configuration (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-change-in-production
JWT_EXPIRY=900
JWT_REFRESH_EXPIRY=2592000

# Server Configuration
PORT=3001
NODE_ENV=development
METRICS_PORT=9090

# Cache Configuration
CACHE_DEFAULT_TTL=3600
CACHE_MEMORY_TTL=300
CACHE_REDIS_TTL=3600
CACHE_MAX_KEYS=5000

# Performance Configuration
SLOW_QUERY_THRESHOLD=1000
HIGH_CONNECTION_THRESHOLD=80
LOW_CACHE_HIT_RATE_THRESHOLD=0.7
HIGH_MEMORY_THRESHOLD=5368709120

# Security Configuration
JWT_PG_TYPE_IDENTIFIER=hr_public.jwt_token
DEFAULT_ROLE=hr_guest
ALLOW_REGISTRATION=false
REQUIRE_EMAIL_VERIFICATION=false
ENABLE_RATE_LIMITING=true
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100
