{
	"name": "svelteHR-contract-tests",
	"version": "1.0.0",
	"description": "Contract tests for SvelteHR PostGraphile migration",
	"main": "index.js",
	"scripts": {
		"test": "mocha \"test_*.js\" --timeout 30000 --exit",
		"test:schema": "mocha test_graphql_schema.js --timeout 30000 --exit",
		"test:auth": "mocha test_auth_flow_integration.js --timeout 30000 --exit",
		"test:rbac": "mocha test_user_roles_graphql.js --timeout 30000 --exit",
		"test:business": "mocha test_end_to_end_workflows.js --timeout 30000 --exit",
		"test:performance": "mocha test_performance.js --timeout 60000 --exit",
		"test:security": "mocha test_data_security.js --timeout 30000 --exit",
		"test:ci": "npm run test -- --reporter json > test-results.json"
	},
	"keywords": [
		"postgraphile",
		"graphql",
		"postgresql",
		"hr",
		"contract-tests"
	],
	"author": "SvelteHR Team",
	"license": "MIT",
	"dependencies": {
		"pg": "^8.11.3",
		"chai": "^4.3.10",
		"mocha": "^10.2.0",
		"graphql": "^16.8.1"
	},
	"devDependencies": {
		"axios": "^1.6.2"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/svelteHR/backend.git"
	},
	"bugs": {
		"url": "https://github.com/svelteHR/backend/issues"
	},
	"homepage": "https://github.com/svelteHR/backend#readme"
}
