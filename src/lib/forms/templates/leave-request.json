{
  "name": "Leave Request",
  "category": "leave_management",
  "version": 1,
  "description": "Request time off for vacation, sick leave, or personal matters",
  "template_schema": {
    "fields": [
      {
        "id": "request_details",
        "name": "request_details",
        "type": "section",
        "label": "Leave Request Details",
        "description": "Please provide the details of your leave request",
        "required": false
      },
      {
        "id": "leave_type",
        "name": "leaveType",
        "type": "select",
        "label": "Type of Leave",
        "required": true,
        "options": [
          { "value": "vacation", "label": "Vacation", "description": "Planned time off for rest and recreation" },
          { "value": "sick", "label": "Sick Leave", "description": "Time off due to illness or medical appointments" },
          { "value": "personal", "label": "Personal Leave", "description": "Time off for personal matters" },
          { "value": "maternity", "label": "Maternity Leave", "description": "Time off for childbirth and bonding" },
          { "value": "paternity", "label": "Paternity Leave", "description": "Time off for new fathers" },
          { "value": "bereavement", "label": "Bereavement Leave", "description": "Time off due to death in family" },
          { "value": "jury_duty", "label": "Jury Duty", "description": "Time off for civic duty" },
          { "value": "military", "label": "Military Leave", "description": "Time off for military service" },
          { "value": "other", "label": "Other", "description": "Other type of leave (specify in reason)" }
        ],
        "ui_config": {
          "section": "Leave Request Details"
        }
      },
      {
        "id": "start_date",
        "name": "startDate",
        "type": "date",
        "label": "Start Date",
        "required": true,
        "validation": {
          "custom": [
            {
              "rule": "business_days_notice",
              "message": "Please provide at least 5 business days notice for vacation requests",
              "params": {
                "days": 5
              }
            }
          ]
        },
        "ui_config": {
          "section": "Leave Request Details"
        }
      },
      {
        "id": "end_date",
        "name": "endDate",
        "type": "date",
        "label": "End Date",
        "required": true,
        "ui_config": {
          "section": "Leave Request Details"
        }
      },
      {
        "id": "duration_type",
        "name": "durationType",
        "type": "radio",
        "label": "Duration",
        "required": true,
        "options": [
          { "value": "full_day", "label": "Full Day(s)", "description": "Entire working day(s)" },
          { "value": "half_day_am", "label": "Half Day - Morning", "description": "Morning half of working day" },
          { "value": "half_day_pm", "label": "Half Day - Afternoon", "description": "Afternoon half of working day" },
          { "value": "hours", "label": "Specific Hours", "description": "Custom time range within a day" }
        ],
        "ui_config": {
          "section": "Leave Request Details",
          "variant": "inline"
        }
      },
      {
        "id": "start_time",
        "name": "startTime",
        "type": "text",
        "label": "Start Time",
        "required": false,
        "ui_config": {
          "section": "Leave Request Details",
          "placeholder": "e.g., 2:00 PM",
          "conditional_display": {
            "depends_on": "durationType",
            "condition": "equals",
            "value": "hours"
          }
        }
      },
      {
        "id": "end_time",
        "name": "endTime",
        "type": "text",
        "label": "End Time",
        "required": false,
        "ui_config": {
          "section": "Leave Request Details",
          "placeholder": "e.g., 4:00 PM",
          "conditional_display": {
            "depends_on": "durationType",
            "condition": "equals",
            "value": "hours"
          }
        }
      },
      {
        "id": "reason_section",
        "name": "reason_section",
        "type": "section",
        "label": "Reason and Details",
        "description": "Please provide additional context for your leave request",
        "required": false
      },
      {
        "id": "reason",
        "name": "reason",
        "type": "textarea",
        "label": "Reason for Leave",
        "required": true,
        "validation": {
          "minLength": 10,
          "maxLength": 500
        },
        "ui_config": {
          "section": "Reason and Details",
          "placeholder": "Please provide a brief explanation for your leave request...",
          "size": "medium",
          "column_span": 2
        }
      },
      {
        "id": "work_coverage",
        "name": "workCoverage",
        "type": "textarea",
        "label": "Work Coverage Plan",
        "required": false,
        "validation": {
          "maxLength": 1000
        },
        "ui_config": {
          "section": "Reason and Details",
          "placeholder": "Describe how your responsibilities will be covered during your absence...",
          "size": "medium",
          "column_span": 2,
          "help_text": "Include details about who will handle your tasks, any handover documentation, or project status updates"
        }
      },
      {
        "id": "backup_contact",
        "name": "backupContact",
        "type": "text",
        "label": "Backup Contact Person",
        "required": false,
        "ui_config": {
          "section": "Reason and Details",
          "placeholder": "Name of colleague who can handle urgent matters"
        }
      },
      {
        "id": "emergency_contact_during_leave",
        "name": "emergencyContactDuringLeave",
        "type": "radio",
        "label": "Can you be contacted for emergencies?",
        "required": true,
        "options": [
          { "value": "yes", "label": "Yes", "description": "I can be reached for urgent matters" },
          { "value": "limited", "label": "Limited", "description": "Only for critical emergencies" },
          { "value": "no", "label": "No", "description": "Please do not contact me" }
        ],
        "ui_config": {
          "section": "Reason and Details"
        }
      },
      {
        "id": "attachments_section",
        "name": "attachments_section",
        "type": "section",
        "label": "Supporting Documents",
        "description": "Upload any required documentation (medical certificates, etc.)",
        "required": false
      },
      {
        "id": "supporting_documents",
        "name": "supportingDocuments",
        "type": "file",
        "label": "Upload Documents",
        "required": false,
        "validation": {
          "pattern": ".pdf,.doc,.docx,.jpg,.jpeg,.png",
          "maxValue": 5242880
        },
        "ui_config": {
          "section": "Supporting Documents",
          "variant": "multiple",
          "column_span": 2,
          "help_text": "Accepted formats: PDF, DOC, DOCX, JPG, PNG. Maximum size: 5MB per file."
        }
      },
      {
        "id": "additional_notes",
        "name": "additionalNotes",
        "type": "textarea",
        "label": "Additional Notes",
        "required": false,
        "validation": {
          "maxLength": 500
        },
        "ui_config": {
          "section": "Supporting Documents",
          "placeholder": "Any additional information you'd like to provide...",
          "size": "small",
          "column_span": 2
        }
      }
    ],
    "validation_rules": [
      {
        "field": "endDate",
        "rule": "date_range",
        "message": "End date must be after start date"
      },
      {
        "field": "startTime",
        "rule": "conditional_required",
        "message": "Start time is required when selecting specific hours",
        "params": {
          "depends_on": "durationType",
          "condition": "equals",
          "value": "hours"
        }
      },
      {
        "field": "endTime",
        "rule": "conditional_required",
        "message": "End time is required when selecting specific hours",
        "params": {
          "depends_on": "durationType",
          "condition": "equals",
          "value": "hours"
        }
      }
    ],
    "ui_config": {
      "layout": "two_column",
      "show_progress": false
    }
  }
}