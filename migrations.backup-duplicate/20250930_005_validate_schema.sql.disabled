-- Migration: Validate database schema for management pages feature
-- Feature: 016-repair-management-pages
-- Task: T002
-- Purpose: Verify all required tables and relationships exist before enabling management/admin pages

-- Create validation function
CREATE OR REPLACE FUNCTION hr_hidden.validate_management_schema()
RETURNS TABLE(
    validation_status text,
    table_name text,
    check_type text,
    result text,
    details text
) AS $$
BEGIN
    -- Check if all required tables exist
    RETURN QUERY
    SELECT
        'TABLE_EXISTENCE' as validation_status,
        t.table_name::text,
        'EXISTS' as check_type,
        CASE
            WHEN EXISTS (
                SELECT 1
                FROM information_schema.tables
                WHERE table_schema = 'hr_public'
                AND information_schema.tables.table_name = t.table_name
            ) THEN 'PASS'
            ELSE 'FAIL'
        END as result,
        CASE
            WHEN EXISTS (
                SELECT 1
                FROM information_schema.tables
                WHERE table_schema = 'hr_public'
                AND information_schema.tables.table_name = t.table_name
            ) THEN 'Table exists in hr_public schema'
            ELSE 'Table missing from hr_public schema'
        END as details
    FROM (VALUES
        ('departments'),
        ('users'),
        ('leave_requests'),
        ('performance_reviews'),
        ('employee_goals'),
        ('tasks'),
        ('time_off_policies'),
        ('time_off_balances'),
        ('payroll_records')
    ) AS t(table_name)
    WHERE t.table_name != 'tasks'; -- DEPRECATED: tasks moved to public schema (see 20251009_000)

    -- Check foreign key constraints for users table
    RETURN QUERY
    SELECT
        'FOREIGN_KEY' as validation_status,
        'users'::text,
        'department_id -> departments.id' as check_type,
        CASE
            WHEN EXISTS (
                SELECT 1
                FROM information_schema.table_constraints tc
                JOIN information_schema.key_column_usage kcu
                    ON tc.constraint_name = kcu.constraint_name
                WHERE tc.table_schema = 'hr_public'
                    AND tc.table_name = 'users'
                    AND kcu.column_name = 'department_id'
                    AND tc.constraint_type = 'FOREIGN KEY'
            ) THEN 'PASS'
            ELSE 'FAIL'
        END as result,
        'Validates users belong to departments' as details;

    -- Check foreign key constraints for departments table
    RETURN QUERY
    SELECT
        'FOREIGN_KEY' as validation_status,
        'departments'::text,
        'manager_id -> users.id' as check_type,
        CASE
            WHEN EXISTS (
                SELECT 1
                FROM information_schema.table_constraints tc
                JOIN information_schema.key_column_usage kcu
                    ON tc.constraint_name = kcu.constraint_name
                WHERE tc.table_schema = 'hr_public'
                    AND tc.table_name = 'departments'
                    AND kcu.column_name = 'manager_id'
                    AND tc.constraint_type = 'FOREIGN KEY'
            ) THEN 'PASS'
            ELSE 'FAIL'
        END as result,
        'Validates department managers are users' as details;

    -- Check foreign key constraints for leave_requests table
    RETURN QUERY
    SELECT
        'FOREIGN_KEY' as validation_status,
        'leave_requests'::text,
        fk.constraint_name as check_type,
        'PASS' as result,
        'Foreign key constraint exists' as details
    FROM (
        SELECT DISTINCT tc.constraint_name
        FROM information_schema.table_constraints tc
        WHERE tc.table_schema = 'hr_public'
            AND tc.table_name = 'leave_requests'
            AND tc.constraint_type = 'FOREIGN KEY'
    ) fk;

    -- Check foreign key constraints for performance_reviews table
    RETURN QUERY
    SELECT
        'FOREIGN_KEY' as validation_status,
        'performance_reviews'::text,
        fk.constraint_name as check_type,
        'PASS' as result,
        'Foreign key constraint exists' as details
    FROM (
        SELECT DISTINCT tc.constraint_name
        FROM information_schema.table_constraints tc
        WHERE tc.table_schema = 'hr_public'
            AND tc.table_name = 'performance_reviews'
            AND tc.constraint_type = 'FOREIGN KEY'
    ) fk;

    -- Check foreign key constraints for employee_goals table
    RETURN QUERY
    SELECT
        'FOREIGN_KEY' as validation_status,
        'employee_goals'::text,
        fk.constraint_name as check_type,
        'PASS' as result,
        'Foreign key constraint exists' as details
    FROM (
        SELECT DISTINCT tc.constraint_name
        FROM information_schema.table_constraints tc
        WHERE tc.table_schema = 'hr_public'
            AND tc.table_name = 'employee_goals'
            AND tc.constraint_type = 'FOREIGN KEY'
    ) fk;

    -- DEPRECATED: Tasks table validation removed (table moved to public schema in 20251009_000)
    -- -- Check foreign key constraints for tasks table
    -- RETURN QUERY
    -- SELECT
    --     'FOREIGN_KEY' as validation_status,
    --     'tasks'::text,
    --     CASE
    --         WHEN kcu.column_name = 'assignee_id' THEN 'assignee_id -> users.id'
    --         WHEN kcu.column_name = 'assigner_id' THEN 'assigner_id -> users.id'
    --         WHEN kcu.column_name = 'department_id' THEN 'department_id -> departments.id'
    --     END as check_type,
    --     CASE
    --         WHEN EXISTS (
    --             SELECT 1
    --             FROM information_schema.referential_constraints rc
    --             WHERE rc.constraint_name = tc.constraint_name
    --                 AND rc.constraint_schema = 'hr_public'
    --         ) THEN 'PASS'
    --         ELSE 'FAIL'
    --     END as result,
    --     'Validates task assignment relationships' as details
    -- FROM information_schema.table_constraints tc
    -- JOIN information_schema.key_column_usage kcu
    --     ON tc.constraint_name = kcu.constraint_name
    -- WHERE tc.table_schema = 'hr_public'
    --     AND tc.table_name = 'tasks'
    --     AND tc.constraint_type = 'FOREIGN KEY'
    --     AND kcu.column_name IN ('assignee_id', 'assigner_id', 'department_id');

    -- Check CASCADE deletion settings
    RETURN QUERY
    SELECT
        'CASCADE_DELETE' as validation_status,
        kcu.table_name::text,
        kcu.column_name || ' -> ' || ccu.table_name || '.' || ccu.column_name as check_type,
        CASE
            WHEN rc.delete_rule = 'CASCADE' THEN 'PASS'
            ELSE 'WARNING'
        END as result,
        'Delete rule: ' || rc.delete_rule as details
    FROM information_schema.referential_constraints rc
    JOIN information_schema.key_column_usage kcu
        ON rc.constraint_name = kcu.constraint_name
    JOIN information_schema.constraint_column_usage ccu
        ON rc.constraint_name = ccu.constraint_name
    WHERE kcu.table_schema = 'hr_public'
        AND kcu.table_name IN ('leave_requests', 'performance_reviews', 'employee_goals') -- tasks removed (moved to public schema)
        AND rc.delete_rule IN ('CASCADE', 'SET NULL', 'RESTRICT');

END;
$$ LANGUAGE plpgsql;

-- Execute validation and display results
DO $$
DECLARE
    validation_record RECORD;
    failure_count INTEGER := 0;
    warning_count INTEGER := 0;
BEGIN
    RAISE NOTICE '========================================';
    RAISE NOTICE 'Management Schema Validation Report';
    RAISE NOTICE '========================================';
    RAISE NOTICE '';

    FOR validation_record IN
        SELECT * FROM hr_hidden.validate_management_schema()
        ORDER BY validation_status, table_name, check_type
    LOOP
        IF validation_record.result = 'FAIL' THEN
            failure_count := failure_count + 1;
            RAISE WARNING '[%] % - %: % (%)',
                validation_record.validation_status,
                validation_record.table_name,
                validation_record.check_type,
                validation_record.result,
                validation_record.details;
        ELSIF validation_record.result = 'WARNING' THEN
            warning_count := warning_count + 1;
            RAISE NOTICE '[%] % - %: % (%)',
                validation_record.validation_status,
                validation_record.table_name,
                validation_record.check_type,
                validation_record.result,
                validation_record.details;
        ELSE
            RAISE NOTICE '[%] % - %: ✓ %',
                validation_record.validation_status,
                validation_record.table_name,
                validation_record.check_type,
                validation_record.details;
        END IF;
    END LOOP;

    RAISE NOTICE '';
    RAISE NOTICE '========================================';
    RAISE NOTICE 'Validation Summary';
    RAISE NOTICE '========================================';
    RAISE NOTICE 'Failures: %', failure_count;
    RAISE NOTICE 'Warnings: %', warning_count;

    IF failure_count > 0 THEN
        RAISE EXCEPTION 'Schema validation FAILED with % critical issues. Please review and fix before proceeding.', failure_count;
    ELSIF warning_count > 0 THEN
        RAISE NOTICE 'Schema validation PASSED with % warnings. Review recommended but not blocking.', warning_count;
    ELSE
        RAISE NOTICE 'Schema validation PASSED - All checks successful!';
    END IF;
END;
$$;

-- Add comment for documentation
COMMENT ON FUNCTION hr_hidden.validate_management_schema() IS 'Validates database schema requirements for management pages feature (016-repair-management-pages)';
