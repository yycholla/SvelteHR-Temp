# =============================================================================
# SvelteHR Production Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in actual values for your deployment.
# NEVER commit the actual `.env` file to version control!
#
# Security Note: All secrets should be randomly generated with secure methods.
# Use: openssl rand -base64 32 | tr -d "=+/" | cut -c1-32
# =============================================================================

# =============================================================================
# Domain Configuration (CRITICAL for Caddy SSL)
# =============================================================================
# For local testing with self-signed certificates:
DOMAIN=localhost

# For production with Let's Encrypt certificates:
# DOMAIN=hr.example.com
# TLS_EMAIL=admin@example.com

# Optional: Use Let's Encrypt staging server for testing (avoid rate limits)
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# =============================================================================
# Database Configuration (PostgreSQL 15)
# =============================================================================
# Database name
POSTGRES_DB=hr_system

# Database user (MUST NOT be 'root')
POSTGRES_USER=postgres

# Database password (REQUIRED: min 32 chars, use URL-safe random generation)
# Generate with: openssl rand -base64 32 | tr -d "=+/" | cut -c1-32
# IMPORTANT: Must be URL-safe (no special characters that need encoding in DATABASE_URL)
POSTGRES_PASSWORD=<SECURE_RANDOM_PASSWORD_32_CHARACTERS>

# Database initialization arguments (DO NOT MODIFY unless necessary)
POSTGRES_INITDB_ARGS=--encoding=UTF-8 --lc-collate=en_US.UTF-8 --lc-ctype=en_US.UTF-8

# Full database URL for backend (auto-constructed from above variables)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# =============================================================================
# Redis Configuration (Cache & Session Storage)
# =============================================================================
# Redis connection URL
REDIS_URL=redis://redis:6379

# Optional: Redis password (uncomment if Redis AUTH is enabled)
# REDIS_PASSWORD=<SECURE_RANDOM_PASSWORD>

# Redis memory configuration (already set in docker-compose.prod.yml)
# REDIS_MAX_MEMORY=256mb
# REDIS_MAX_MEMORY_POLICY=allkeys-lru

# =============================================================================
# Backend Configuration (Rust GraphQL Server)
# =============================================================================
# JWT Authentication Secrets (REQUIRED: min 32 chars, use secure random generation)
# Generate with: openssl rand -base64 48 | tr -d "=+/" | cut -c1-64
JWT_SECRET=<SECURE_RANDOM_256BIT_SECRET>
JWT_REFRESH_SECRET=<SECURE_RANDOM_256BIT_SECRET>

# Service-to-service authentication key (REQUIRED: min 32 chars)
SERVICE_AUTH_KEY=<SECURE_RANDOM_256BIT_SECRET>

# CORS allowed origins (comma-separated)
# For localhost testing:
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://localhost

# For production (use your actual domain):
# CORS_ALLOWED_ORIGINS=https://hr.example.com

# Logging configuration
RUST_LOG=info,hr_graphql_server=debug,sea_orm=warn,sqlx=warn

# Frontend logging (debug/info/warn/error)
LOG_LEVEL=info
LOG_FORMAT=console

# Rust backtrace (0 = disabled in production, 1 = enabled for debugging)
RUST_BACKTRACE=0

# Server configuration
HOST=0.0.0.0
PORT=4000

# Environment
ENVIRONMENT=production

# =============================================================================
# Frontend Configuration (SvelteKit)
# =============================================================================
# Note: NODE_ENV is managed by Vite/SvelteKit automatically
# Do not set NODE_ENV=production here - only NODE_ENV=development is supported in .env files

# API URL for backend GraphQL server
# For docker-compose (local development): http://hr-graphql-rust:4000
# For Kubernetes (production): https://hr.mtncarerx.com/graphql
PUBLIC_API_URL=http://hr-graphql-rust:4000

# GraphQL Backend URL for SvelteKit Proxy
# IMPORTANT: When running in hybrid mode (native frontend + Docker backend),
# use localhost since the SvelteKit dev server runs on the host:
GRAPHQL_URL=http://localhost:4000/graphql
# For full Docker mode (all containers), use the Docker hostname:
# GRAPHQL_URL=http://hr-graphql-rust:4000/graphql

# Server host and port
HOST=0.0.0.0
PORT=3000

# =============================================================================
# CI/CD Configuration (GitLab Container Registry)
# =============================================================================
# GitLab Container Registry URL (default)
GITLAB_REGISTRY=registry.gitlab.com

# GitLab project path (format: username/project or group/project)
# Example: GITLAB_PROJECT=john_doe/sveltehr
GITLAB_PROJECT=<YOUR_GITLAB_USERNAME>/sveltehr

# Image tag (latest or specific commit SHA)
IMAGE_TAG=latest

# =============================================================================
# Intuit QuickBooks Integration
# =============================================================================
# OAuth 2.0 credentials from Intuit Developer Portal
INTUIT_CLIENT_ID=<YOUR_INTUIT_CLIENT_ID>
INTUIT_CLIENT_SECRET=<YOUR_INTUIT_CLIENT_SECRET>

# Redirect URI (must match exactly what you set in Intuit Developer Portal)
# For local: http://localhost:3000/api/intuit/callback
# For prod: https://yourdomain.com/api/intuit/callback
INTUIT_REDIRECT_URI=http://localhost:3000/api/intuit/callback

# Environment: sandbox or production
INTUIT_ENVIRONMENT=sandbox

# Scopes (space-separated)
INTUIT_SCOPES=com.intuit.quickbooks.accounting com.intuit.quickbooks.payment

# Webhook URL - Publicly accessible endpoint for Intuit to send webhook notifications
# IMPORTANT: This MUST be a publicly accessible HTTPS URL (Intuit requires HTTPS)
# For local development, use a tunneling service like ngrok, localtunnel, or Cloudflare Tunnel
# Example with ngrok: https://abc123.ngrok.io/api/intuit/webhook
# For production: https://yourdomain.com/api/intuit/webhook
INTUIT_WEBHOOK_URL=https://your-ngrok-url.ngrok.io/api/intuit/webhook

# Intuit API Base URLs (auto-configured based on INTUIT_ENVIRONMENT)
# Sandbox: https://sandbox-quickbooks.api.intuit.com
# Production: https://quickbooks.api.intuit.com

# =============================================================================
# Email Configuration (Email Digest System)
# =============================================================================
# SMTP server configuration for sending email digests
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<YOUR_SMTP_USERNAME>
SMTP_PASSWORD=<YOUR_SMTP_PASSWORD>

# Email sender information
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=SvelteHR System

# Application base URL (used in email links)
APP_BASE_URL=http://localhost:3000

# =============================================================================
# Optional Configuration
# =============================================================================
# TLS/SSL Configuration
# Required only when DOMAIN is not 'localhost' (Let's Encrypt mode)
# TLS_EMAIL=admin@example.com

# Monitoring and Metrics
# ENABLE_METRICS=false
# PROMETHEUS_PORT=9090

# Database Backup Configuration (handled by CI/CD)
# BACKUP_RETENTION_DAYS=7
# BACKUP_PATH=/var/backups/postgresql

# =============================================================================
# Required GitHub Secrets (for CI/CD deployment)
# =============================================================================
# These secrets must be added to your GitHub repository settings:
# Settings → Secrets and variables → Actions → New repository secret
#
# GITLAB_USERNAME         - Your GitLab username
# GITLAB_TOKEN            - GitLab Personal Access Token with read_registry + write_registry scopes
# DEPLOY_HOST             - Production server hostname or IP (e.g., hr.example.com or 192.168.1.100)
# DEPLOY_USER             - SSH username for deployment (e.g., deploy)
# SSH_PRIVATE_KEY         - Base64-encoded SSH private key for deployment
# PRODUCTION_ENV          - Base64-encoded contents of this .env file (with actual values)
# PRODUCTION_DOMAIN       - Production domain name (e.g., hr.example.com)
#
# Generate SSH key:
#   ssh-keygen -t ed25519 -C "github-actions-deploy" -f deploy_key
#   cat deploy_key | base64 -w 0 > deploy_key.b64
#
# Generate base64-encoded .env:
#   cat .env.production | base64 -w 0 > .env.production.b64
# =============================================================================

# =============================================================================
# Security Checklist
# =============================================================================
# Before deploying to production, verify:
#
# ✅ All <SECURE_RANDOM_*> placeholders replaced with actual random values
# ✅ POSTGRES_PASSWORD is at least 16 characters and randomly generated
# ✅ JWT_SECRET and JWT_REFRESH_SECRET are at least 32 characters
# ✅ SERVICE_AUTH_KEY is at least 32 characters
# ✅ POSTGRES_USER is NOT 'root'
# ✅ DOMAIN is set to your actual domain (not 'localhost') for production
# ✅ TLS_EMAIL is set (required for Let's Encrypt)
# ✅ CORS_ALLOWED_ORIGINS matches your actual domain
# ✅ This file (.env) is in .gitignore and NEVER committed
# ✅ GitHub Secrets are configured for CI/CD deployment
# ✅ SSH key pair generated and public key added to production server
# ✅ SMTP credentials are configured for email digest system
# ✅ SMTP_FROM_EMAIL is set to a valid email address
# ✅ APP_BASE_URL matches your production domain
# ✅ INTUIT_WEBHOOK_URL is set to a publicly accessible HTTPS URL
# ✅ Webhook endpoint is registered in Intuit Developer Portal
# =============================================================================

# =============================================================================
# Validation
# =============================================================================
# Validate your configuration with:
#   ./scripts/validate-env.sh .env
#
# This script checks:
# - All required variables are present
# - Password strength meets minimum requirements
# - Domain format is valid
# - No insecure default values
# =============================================================================
