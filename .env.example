# =============================================================================
# SvelteHR Frontend Environment Configuration (Twelve-Factor Compliant)
# =============================================================================
# 
# This project uses Doppler for environment variable management.
# The .env file is automatically generated from Doppler and should NOT be edited manually.
#
# To set up Doppler for this project:
#   1. Install Doppler CLI: https://docs.doppler.com/docs/install-cli
#   2. Run: make doppler-setup
#   3. Set secrets: make doppler-set-api URL=<your-api-url>
#   4. Pull environment: make env-pull
#
# =============================================================================

# -------------------------
# Core Application Config
# -------------------------

# Build Environment (affects build behavior)
NODE_ENV=development

# -------------------------
# API Configuration
# -------------------------

# Public API URL (exposed to browser)
# Examples:
#   - Local dev: http://localhost:8080/api/v2
#   - Staging: https://staging-api.your-domain.com/api/v2
#   - Production: https://api.your-domain.com/api/v2
PUBLIC_API_URL=http://localhost:8080/api/v2

# WebSocket URL (exposed to browser) 
# Examples:
#   - Local dev: ws://localhost:8080/api/v1/ws
#   - Staging: wss://staging-api.your-domain.com/api/v1/ws
#   - Production: wss://api.your-domain.com/api/v1/ws
PUBLIC_WS_URL=ws://localhost:8080/api/v1/ws

# Private API URL (server-side only, not exposed to browser)
# Used for server-side API calls during SSR
PRIVATE_API_URL=http://localhost:8080

# -------------------------
# Authentication & Security
# -------------------------

# JWT Secret (for server-side token validation)
# IMPORTANT: This should be a strong, randomly generated secret
JWT_SECRET=your-jwt-secret-here

# Session Secret (for server-side sessions)
SESSION_SECRET=your-session-secret-here

# API Key (if required for backend communication)
API_KEY=your-api-key-here

# -------------------------
# Feature Flags & Options
# -------------------------

# Enable debug mode (affects logging, error display)
DEBUG=false

# Enable HTTPS in development
USE_HTTPS=false

# Enable WebSocket connections
ENABLE_WEBSOCKETS=true

# Enable real-time features
ENABLE_REALTIME=true

# -------------------------
# Third-Party Services
# -------------------------

# Analytics/Monitoring (if used)
# PUBLIC_ANALYTICS_ID=your-analytics-id
# PUBLIC_SENTRY_DSN=your-sentry-dsn

# -------------------------
# Development Only
# -------------------------

# Vite dev server configuration
VITE_PORT=5173
VITE_HOST=localhost

# =============================================================================
# Usage Examples:
# 
# Local Development:
#   NODE_ENV=development
#   PUBLIC_API_URL=http://localhost:8080/api/v2
#   PUBLIC_WS_URL=ws://localhost:8080/api/v1/ws
#   PRIVATE_API_URL=http://localhost:8080
#
# Staging Environment:
#   NODE_ENV=staging
#   PUBLIC_API_URL=https://staging-api.your-domain.com/api/v2
#   PUBLIC_WS_URL=wss://staging-api.your-domain.com/api/v1/ws
#   PRIVATE_API_URL=http://backend-internal:8080
#
# Production Environment:
#   NODE_ENV=production
#   PUBLIC_API_URL=https://api.your-domain.com/api/v2
#   PUBLIC_WS_URL=wss://api.your-domain.com/api/v1/ws
#   PRIVATE_API_URL=http://backend-internal:8080
# =============================================================================