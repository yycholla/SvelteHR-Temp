# Local Native Development Environment Configuration
# Copy this file to .env and adjust values as needed
#
# IMPORTANT: This .env file is for NATIVE DEVELOPMENT ONLY (running Rust server on your host)
# Docker containers use environment variables declared in docker-compose.dev.yml
#
# See README-LOCAL-DEV.md for full setup instructions

# Database Configuration
# Connects to PostgreSQL running in Docker via exposed port 5433
DATABASE_URL=postgresql://postgres:postgres123@localhost:5433/hr_system

# Server Configuration
# HOST should be 127.0.0.1 for native dev (0.0.0.0 in Docker)
HOST=127.0.0.1
PORT=4000

# Logging Configuration
RUST_LOG=info,hr_graphql_server=debug,sea_orm=warn,sqlx=warn

# CORS - Allow local frontend development servers
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Secret (development only - CHANGE IN PRODUCTION!)
# DEPRECATED: Used for old session-based auth, will be removed after JWT migration
JWT_SECRET=dev-jwt-secret-change-in-production

# JWT RS256 Authentication Configuration (Modern JWT Auth)
# Generate RSA keys with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Then paste the contents below (include -----BEGIN/END----- lines)
# CRITICAL: In production, use secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.)
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
[PASTE YOUR PRIVATE KEY HERE - DO NOT COMMIT REAL KEYS]
-----END PRIVATE KEY-----"

JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
[PASTE YOUR PUBLIC KEY HERE]
-----END PUBLIC KEY-----"

# JWT Token Expiration
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# JWT Claims
JWT_ISSUER=mountainhr-api
JWT_AUDIENCE=mountainhr-app

# Service Authentication Key (for inter-service communication)
SERVICE_AUTH_KEY=dev-service-key-change-in-production-use-strong-random-key

# Enable backtrace for better debugging
RUST_BACKTRACE=1

# SeaORM Configuration
SEA_ORM_LOG_QUERIES=false
SEA_ORM_LOG_LEVEL=warn

# Seed Data Configuration
# Set to false for native dev (data should already be seeded via Docker)
ENABLE_SEED_DATA=false
ENVIRONMENT=development

# Sentry Error Tracking & Performance Monitoring (Optional)
# Create a Sentry project at https://sentry.io for the Rust backend
# Leave blank to disable Sentry
SENTRY_DSN=
RUST_SENTRY_ENVIRONMENT=development
RUST_SENTRY_TRACES_SAMPLE_RATE=0.2

# SMTP Email Configuration (Optional)
# Configure for email digest notifications
# Example using SMTP2go (recommended for development)
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=2525
SMTP_USERNAME=your-username
SMTP_PASSWORD=your-password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=SvelteHR System
APP_BASE_URL=http://localhost:5173

# QuickBooks Integration (Intuit) Configuration
# Get credentials from https://developer.intuit.com/app/developer/dashboard

# OAuth 2.0 Credentials
INTUIT_CLIENT_ID=your-client-id-from-quickbooks
INTUIT_CLIENT_SECRET=your-client-secret-from-quickbooks
INTUIT_REDIRECT_URI=http://localhost:5173/api/intuit/callback

# Webhook Configuration
# For local development with ngrok, this will be set automatically by ./scripts/dev-webhook-tunnel.sh
# For dev k8s namespace: https://dev.hr.mtncarerx.com/api/intuit/webhook
# For production: https://hr.mtncarerx.com/api/intuit/webhook (auto-detected)
# INTUIT_WEBHOOK_URL=https://your-ngrok-id.ngrok.io/api/intuit/webhook

# Webhook Verifier Token (MUST match QuickBooks Developer Portal)
# Development token (for sandbox):
INTUIT_WEBHOOK_VERIFIER_TOKEN=ef64f0f4-9508-45b4-9fab-f2a98e5f2bc2
# Production: Use a different token configured in QuickBooks production app
