# Local Native Development Environment Configuration
# Copy this file to .env and adjust values as needed
#
# IMPORTANT: This .env file is for NATIVE DEVELOPMENT ONLY (running Rust server on your host)
# Docker containers use environment variables declared in docker-compose.dev.yml
#
# See README-LOCAL-DEV.md for full setup instructions

# Database Configuration
# Connects to PostgreSQL running in Docker via exposed port 5433
DATABASE_URL=postgresql://postgres:postgres123@localhost:5433/hr_system

# Server Configuration
# HOST should be 127.0.0.1 for native dev (0.0.0.0 in Docker)
HOST=127.0.0.1
PORT=4000

# Logging Configuration
RUST_LOG=info,hr_graphql_server=debug,sea_orm=warn,sqlx=warn

# CORS - Allow local frontend development servers
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Secret (development only - CHANGE IN PRODUCTION!)
JWT_SECRET=dev-jwt-secret-change-in-production

# Service Authentication Key (for inter-service communication)
SERVICE_AUTH_KEY=dev-service-key-change-in-production-use-strong-random-key

# Enable backtrace for better debugging
RUST_BACKTRACE=1

# SeaORM Configuration
SEA_ORM_LOG_QUERIES=false
SEA_ORM_LOG_LEVEL=warn

# Seed Data Configuration
# Set to false for native dev (data should already be seeded via Docker)
ENABLE_SEED_DATA=false
ENVIRONMENT=development

# Sentry Error Tracking & Performance Monitoring (Optional)
# Create a Sentry project at https://sentry.io for the Rust backend
# Leave blank to disable Sentry
SENTRY_DSN=
RUST_SENTRY_ENVIRONMENT=development
RUST_SENTRY_TRACES_SAMPLE_RATE=0.2

# SMTP Email Configuration (Optional)
# Configure for email digest notifications
# Example using SMTP2go (recommended for development)
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=2525
SMTP_USERNAME=your-username
SMTP_PASSWORD=your-password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=SvelteHR System
APP_BASE_URL=http://localhost:5173
