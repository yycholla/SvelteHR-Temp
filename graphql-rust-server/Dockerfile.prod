# =============================================================================
# Rust GraphQL Server - Multi-Target Production Dockerfile
# =============================================================================
# Optimized multi-stage build with 3 separate targets:
#   - server: Main GraphQL API server (hr-graphql-server)
#   - migration: Database migration binary
#   - seed: Database seeding binary
#
# Build with: docker build --target <server|migration|seed> ...
# =============================================================================

# =============================================================================
# Stage 0: Chef Installer - Install cargo-chef ONCE and reuse
# =============================================================================
FROM rust:1.93-alpine AS chef-installer

# Install system dependencies
RUN apk add --no-cache musl-dev openssl-dev pkgconfig

# Install cargo-chef once (cached across all builds)
RUN cargo install cargo-chef --version 0.1.73

# =============================================================================
# Stage 1: Chef - Prepare recipe for dependency caching
# =============================================================================
FROM rust:1.93-alpine AS chef

# Install system dependencies
RUN apk add --no-cache musl-dev openssl-dev pkgconfig

# Copy cargo-chef binary from installer (avoid reinstalling)
COPY --from=chef-installer /usr/local/cargo/bin/cargo-chef /usr/local/cargo/bin/cargo-chef

WORKDIR /app

# =============================================================================
# Stage 2: Planner - Analyze dependencies (shared by all targets)
# =============================================================================
FROM chef AS planner

# Copy source to analyze dependencies
COPY . .

# Generate recipe.json for dependency caching
RUN cargo chef prepare --recipe-path recipe.json

# =============================================================================
# Stage 3: Builder - Build dependencies only (shared by all targets)
# =============================================================================
FROM rust:1.93-alpine AS builder

# Install build dependencies
RUN apk add --no-cache \
    musl-dev \
    openssl-dev \
    openssl-libs-static \
    pkgconfig \
    mold \
    curl

# Copy cargo-chef binary from installer (avoid reinstalling)
COPY --from=chef-installer /usr/local/cargo/bin/cargo-chef /usr/local/cargo/bin/cargo-chef

WORKDIR /app

# Copy recipe from planner
COPY --from=planner /app/recipe.json recipe.json

# Build dependencies only (cached layer) with BuildKit cache mount
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo chef cook --release --recipe-path recipe.json

# Copy source code for all subsequent build stages
COPY . .

# =============================================================================
# Stage 4a: Server Builder - Build hr-graphql-server binary
# =============================================================================
FROM builder AS server-builder

# Build server binary with BuildKit cache
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/app/target \
    cargo build --release --bin hr-graphql-server && \
    cp /app/target/release/hr-graphql-server /app/hr-graphql-server

# Verify binary exists
RUN test -f /app/hr-graphql-server || \
    (echo "Build failed: hr-graphql-server binary not found" && exit 1)

# =============================================================================
# Stage 4b: Migration Builder - Build migration binary
# =============================================================================
FROM builder AS migration-builder

# Build migration binary with BuildKit cache
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/app/target \
    cargo build --release --bin migration && \
    cp /app/target/release/migration /app/migration-bin

# Verify binary exists
RUN test -f /app/migration-bin || \
    (echo "Build failed: migration binary not found" && exit 1)

# =============================================================================
# Stage 4c: Seed Builder - Build seed-data binary
# =============================================================================
FROM builder AS seed-builder

# Build seed-data binary with BuildKit cache
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/app/target \
    cargo build --release --bin seed-data && \
    cp /app/target/release/seed-data /app/seed-data-bin

# Verify binary exists
RUN test -f /app/seed-data-bin || \
    (echo "Build failed: seed-data binary not found" && exit 1)

# =============================================================================
# Stage 5a: Server Runtime (TARGET: server) - Includes all binaries
# =============================================================================
FROM alpine:3.23 AS server

# Install runtime dependencies (including postgresql-client for migrations)
RUN apk add --no-cache \
    libgcc \
    openssl \
    ca-certificates \
    curl \
    postgresql-client

# Create non-root user
RUN addgroup -g 1001 -S rust && \
    adduser -u 1001 -S rust -G rust

WORKDIR /app

# Copy ALL binaries into single image
COPY --from=server-builder /app/hr-graphql-server ./hr-graphql-server
COPY --from=migration-builder /app/migration-bin ./hr-migration
COPY --from=seed-builder /app/seed-data-bin ./hr-seed

# Copy migration files (required for SeaORM migrations)
COPY --from=builder /app/migration ./migration-files

# Make binaries executable
RUN chmod +x /app/hr-graphql-server /app/hr-migration /app/hr-seed

# Change ownership to non-root user
RUN chown -R rust:rust /app

# Switch to non-root user
USER rust

# Expose GraphQL API port
EXPOSE 4000

# Environment variables
ENV HOST=0.0.0.0
ENV PORT=4000
ENV RUST_LOG=info,hr_graphql_server=debug
ENV ENVIRONMENT=production

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:4000/health || exit 1

# Start server (migrations run via Helm startup script)
CMD ["./hr-graphql-server"]

# =============================================================================
# Stage 5b: Migration Runtime (TARGET: migration)
# =============================================================================
FROM alpine:3.23 AS migration

# Install runtime dependencies
RUN apk add --no-cache \
    libgcc \
    openssl \
    ca-certificates \
    postgresql-client

# Create non-root user
RUN addgroup -g 1001 -S rust && \
    adduser -u 1001 -S rust -G rust

WORKDIR /app

# Copy migration binary from migration-builder
COPY --from=migration-builder /app/migration-bin ./migration

# Copy migration files (required for SeaORM migrations)
COPY --from=builder /app/migration ./migration-files

# Make binary executable
RUN chmod +x /app/migration

# Change ownership to non-root user
RUN chown -R rust:rust /app

# Switch to non-root user
USER rust

# Environment variables
ENV RUST_LOG=info
ENV ENVIRONMENT=production

# Run migrations (expects DATABASE_URL env var)
CMD ["./migration", "up"]

# =============================================================================
# Stage 5c: Seed Runtime (TARGET: seed)
# =============================================================================
FROM alpine:3.23 AS seed

# Install runtime dependencies
RUN apk add --no-cache \
    libgcc \
    openssl \
    ca-certificates \
    postgresql-client

# Create non-root user
RUN addgroup -g 1001 -S rust && \
    adduser -u 1001 -S rust -G rust

WORKDIR /app

# Copy seed-data binary from seed-builder
COPY --from=seed-builder /app/seed-data-bin ./seed-data

# Make binary executable
RUN chmod +x /app/seed-data

# Change ownership to non-root user
RUN chown -R rust:rust /app

# Switch to non-root user
USER rust

# Environment variables
ENV RUST_LOG=info
ENV ENVIRONMENT=production

# Run seed data (expects DATABASE_URL env var)
CMD ["./seed-data"]

# =============================================================================
# Build Instructions
# =============================================================================
#
# Build server image:
#   docker build --target server -f Dockerfile.prod -t sveltehr-backend:latest .
#
# Build migration image:
#   docker build --target migration -f Dockerfile.prod -t sveltehr-migration:latest .
#
# Build seed image:
#   docker build --target seed -f Dockerfile.prod -t sveltehr-seed:latest .
#
# With BuildKit (recommended):
#   DOCKER_BUILDKIT=1 docker build --target server -f Dockerfile.prod -t sveltehr-backend:latest .
#
# =============================================================================
