# ESLint ignore patterns for SvelteHR

# Build outputs
build/
dist/
.svelte-kit/
.output/
.vercel/
.netlify/

# Dependencies
node_modules/

# Rust build artifacts
target/
**/target/

# Generated files
coverage/
*.min.js
*.min.css

# Environment files
.env
.env.*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.swp
*.bak