    let ctx = UserContext::new(
        Uuid::new_v4(),
        vec!["SuperUser".to_string()],
        vec!["*".to_string()],
    );

    assert!(ctx.has_permission("employees:read"));
    assert!(ctx.has_permission("employees:write"));
    assert!(ctx.has_permission("any:permission"));
