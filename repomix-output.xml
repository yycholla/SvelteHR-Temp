        db.connection(),
        TestUserRole::Employee,
        "test_password_123"
    ).await.expect("Failed to create test user");

    let auth_backend = AuthBackend::new(db.connection().clone());

    let creds = Credentials {
        email: test_user.email.clone(),
        password: "test_password_123".to_string(),
