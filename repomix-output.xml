    tag: "1.0.0"  # Must match production tag for ArgoCD Image Updater
    target: development  # Use development Dockerfile target

  service:
    type: ClusterIP
    port: 5173  # Development uses Vite dev server
    targetPort: 5173
    annotations: {}

  resources:
    requests:
      memory: "64Mi"
      cpu: "50m"
    limits:
      memory: "128Mi"
      cpu: "100m"

  env:
    PUBLIC_API_URL: "http://sveltehr-backend:4000"
    DB_HOST: "sveltehr-postgres-rw"
    DB_PORT: "5432"

  # Tailscale configuration (disabled by default)
  tailscale:
    enabled: false
    hostname: "sveltehr-frontend-dev"

# Backend configuration
backend:
  enabled: true
  name: sveltehr-backend
  replicaCount: 1

  image:
    repository: localhost:5000/sveltehr-backend
    pullPolicy: Always
    tag: "1.0.0"  # Must match production tag for ArgoCD Image Updater
    target: development

  service:
    type: ClusterIP
    port: 4000
    targetPort: 4000
    annotations: {}

  resources:
    requests:
      memory: "128Mi"
      cpu: "100m"
    limits:
      memory: "256Mi"
      cpu: "200m"

  env:
    DB_HOST: "sveltehr-postgres-rw"
    DB_PORT: "5432"
    DB_NAME: "hr_system"
    DB_USER: "hr_user"
