			]);

			const content = readFileSync(TEST_INIT_SCRIPT, 'utf-8');

			expect(content).toMatch(/--.*Generated:/);
			expect(content).toMatch(/--.*PostgreSQL Version:/);
			expect(content).toMatch(/--.*Schema:/);
			expect(content).toContain('DO NOT EDIT MANUALLY');
