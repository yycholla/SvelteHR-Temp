	${TASK_WITH_ASSIGNEE_FRAGMENT}
	query GetTasksWithAssignees(
		$first: Int = 20
		$offset: Int = 0
		$orderBy: [TasksOrderBy!] = [DUE_DATE_ASC, PRIORITY_DESC]
