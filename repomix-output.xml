#[derive(Debug, Clone, InputObject)]
pub struct CreateRoleInput {
    pub name: String,
    pub description: Option<String>,
    pub level: i32,
}

/// Role update input
#[derive(Debug, Clone, InputObject)]
pub struct UpdateRoleInput {
    pub name: Option<String>,
    pub description: Option<String>,
    pub level: Option<i32>,
}

