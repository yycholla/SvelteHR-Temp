FROM hr_public.users u
CROSS JOIN hr_public.time_off_policies p
WHERE u.role IN ('hr_employee', 'hr_manager')
AND u.email != 'admin@mountainhr.dev'
ON CONFLICT (employee_id, policy_id, year) DO NOTHING;

