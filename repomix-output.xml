		await expect(page.locator('[role="dialog"] h3')).toContainText('Update Recurring Event');

		// Select "This and future events"
		await page.check('input[value="this_and_future"]');

		// Confirm
		await page.click('button:has-text("Confirm")');

		// Verify success
