								{#each headers as h}<option value={h}>{h}</option>{/each}
							</select>
						</label>
						<label class="block">
							<span class="text-sm">Mobile Phone</span>
							<select
								bind:value={mapping.mobile_phone_column}
								class="select mt-1 w-full rounded border p-2"
