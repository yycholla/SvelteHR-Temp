# =============================================================================
# SvelteHR Production Docker Compose Configuration
# =============================================================================
# This file orchestrates the production deployment of the SvelteHR application
# with PostgreSQL, Redis, Rust GraphQL backend, SvelteKit frontend, and Caddy.
#
# Usage:
#   docker compose -f docker-compose.prod.yml up -d
#
# Prerequisites:
#   - .env file with all required variables (see .env.example)
#   - Docker Compose v2.20+
#   - Domain DNS configured (for Let's Encrypt mode)
# =============================================================================

services:
  # ===========================================================================
  # PostgreSQL Database Service
  # ===========================================================================
  postgres:
    image: postgres:15-alpine
    container_name: sveltehr-postgres-prod
    restart: unless-stopped

    environment:
      POSTGRES_DB: ${POSTGRES_DB}
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_INITDB_ARGS: '--encoding=UTF-8 --lc-collate=en_US.UTF-8 --lc-ctype=en_US.UTF-8'

    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./db/backups:/var/backups/postgresql

    networks:
      - sveltehr-network

    healthcheck:
      test: ['CMD-SHELL', 'pg_isready -U ${POSTGRES_USER} -d ${POSTGRES_DB}']
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s

    # Resource limits (commented - monitor first, then uncomment and adjust)
    # deploy:
    #   resources:
    #     limits:
    #       memory: 1G
    #       cpus: '0.5'
    #     reservations:
    #       memory: 512M
    #       cpus: '0.25'

  # ===========================================================================
  # Redis Cache Service
  # ===========================================================================
  redis:
    image: redis:7-alpine
    container_name: sveltehr-redis-prod
    restart: unless-stopped

    command: redis-server --appendonly yes --maxmemory 256mb --maxmemory-policy allkeys-lru

    volumes:
      - redis_data:/data

    networks:
      - sveltehr-network

    healthcheck:
      test: ['CMD', 'redis-cli', 'ping']
      interval: 10s
      timeout: 3s
      retries: 3
      start_period: 10s

    # Resource limits (commented - monitor first, then uncomment and adjust)
    # deploy:
    #   resources:
    #     limits:
    #       memory: 256M
    #       cpus: '0.25'
    #     reservations:
    #       memory: 128M
    #       cpus: '0.1'

  # ===========================================================================
  # Rust GraphQL Backend Service
  # ===========================================================================
  hr-graphql-rust:
    image: ${GITLAB_REGISTRY:-registry.gitlab.com}/${GITLAB_PROJECT}/backend:${IMAGE_TAG:-latest}
    container_name: sveltehr-graphql-rust-prod
