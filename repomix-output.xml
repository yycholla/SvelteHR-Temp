	RELOADING = 'reloading',
	SUCCESS = 'success',
	ERROR = 'error',
	TIMEOUT = 'timeout'
}

/**
 * Page error state details
 */
export interface PageErrorState {
	hasError: boolean;
	errorResponse?: ErrorResponse;
	canRetry: boolean;
	retryAttempts: number;
	lastErrorAt?: string;
	isRecoverable: boolean;
