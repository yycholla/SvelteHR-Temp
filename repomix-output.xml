							items: column.tasks,
							flipDurationMs,
							dropTargetStyle: { outline: '2px solid hsl(var(--primary))' }
						}}
						onconsider={(e) => handleDndConsider(index, e)}
						onfinalize={(e) => handleDndFinalize(index, e)}
					>
