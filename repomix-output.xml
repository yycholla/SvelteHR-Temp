					{/if}
				</p>
			</div>

			<div class="modal-body">
				{#if !progress}
					<!-- Selection Phase -->
					<div class="selection-header">
						<div class="select-info">
							<span class="selected-count">
								{selectedLogs.size} / {Math.min(logs.length, 100)} selected
							</span>
