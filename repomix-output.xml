            {domain} {
                create(input: {
                    field1: "value1"
                    field2: "value2"
                }) {
                    id
                    field1
                    field2
                    createdBy
                }
            }
        }
    "#;

    let result = schema
        .execute(query)
        .await;

    assert!(result.errors.is_empty(), "GraphQL errors: {:?}", result.errors);
    let data = result.data.into_json().unwrap();
    assert_eq!(data["{domain}"]["create"]["field1"], "value1");
}

#[tokio::test]
