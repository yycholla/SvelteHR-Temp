				break;
			case 'delete':
				// TODO: Show bulk delete confirmation
				console.log('Bulk delete:', selectedTasks);
				break;
		}
	}

	// Load data when filters change
	$: if (filters) {
		loadTasks();
	}

	onMount(() => {
		// Load users for assignee dropdown
		userService.loadUsers();
		loadTasks();
	});
</script>

