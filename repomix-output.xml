        self.id
    }

    /// Performance review ID (foreign key)
    async fn performance_review_id(&self) -> Uuid {
        self.review_id
    }

    /// User ID who provided the feedback
    async fn provider_id(&self) -> Uuid {
        self.provider_id
    }

