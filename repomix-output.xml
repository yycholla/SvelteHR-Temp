	</div>

	<!-- Actions -->
	<Button variant="ghost" size="icon" class="h-7 w-7 opacity-0 group-hover:opacity-100" onclick={(e) => { e.stopPropagation(); /* Add menu trigger */ }}>
		<MoreHorizontal class="h-4 w-4 text-muted-foreground" />
