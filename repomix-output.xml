		// Check authentication and permissions
		if (!locals.user) {
			redirect(303, '/login?redirectTo=/dashboard/documents/upload');
		}

		PermissionChecks.documentsWrite({ request, locals, cookies, fetch } as any);

		const userId = locals.user.id;

