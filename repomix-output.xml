			<p>{error.message}</p>
			<button class="btn-secondary" onclick={refresh}> Try Again </button>
		</div>
	{/if}

	<!-- Employee grid/list -->
	{#if !loading && !error && filteredEmployees.length === 0}
		<div class="empty-state">
