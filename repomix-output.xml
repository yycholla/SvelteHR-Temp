// Page content
const hasError = await pageContainsText('Error');
expect(hasError).toBe(false);

// Extract numbers
const count = extractNumber('45 employees'); // Returns 45
```

### Authentication

```typescript
// Login (auto-navigates to /login and then /dashboard)
