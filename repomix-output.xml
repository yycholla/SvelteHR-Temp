        assert!(require_permission(&ctx_with_perm, "users:read").is_ok());
        assert!(require_permission(&ctx_with_perm, "users:write").is_err());

        let admin_ctx = UserContext::new(
            Uuid::new_v4(),
            vec!["Admin".to_string()],
            vec![],
        );
        assert!(require_permission(&admin_ctx, "any:permission").is_ok());
    }
}
