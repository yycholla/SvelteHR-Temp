# -----------------------------------------------------------------------------
migration:
  enabled: true

  # Use backend image (contains migration binary)
  image:
    repository: localhost:5000/sveltehr-backend
    tag: latest
    pullPolicy: Always

  ttlSecondsAfterFinished: 300
  backoffLimit: 3

  rustLog: "info,migration=debug"

  resources:
    requests:
      memory: 64Mi
      cpu: 50m
    limits:
      memory: 128Mi
      cpu: 200m

# -----------------------------------------------------------------------------
# Seed Job - Disabled (Run Manually)
