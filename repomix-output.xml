{{- end }}
</file>

<file path="k8s/helm-charts/sveltehr/templates/postgres-cluster.yaml">
{{- if and .Values.postgresql .Values.postgresql.enabled -}}
---
apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: {{ include "sveltehr.fullname" . }}-postgres
  namespace: {{ .Values.global.namespace }}
  labels:
    {{- include "sveltehr.labels" . | nindent 4 }}
    app.kubernetes.io/component: database
spec:
  imageName: {{ .Values.postgresql.image.repository }}:{{ .Values.postgresql.image.tag }}
  instances: {{ .Values.postgresql.instances }}

  # PostgreSQL configuration
  postgresql:
    parameters:
      max_connections: {{ .Values.postgresql.config.maxConnections | quote }}
      shared_buffers: {{ .Values.postgresql.config.sharedBuffers | quote }}
      work_mem: {{ .Values.postgresql.config.workMem | quote }}
      maintenance_work_mem: {{ .Values.postgresql.config.maintenanceWorkMem | quote }}
      max_wal_senders: {{ .Values.postgresql.config.maxWalSenders | quote }}
      max_replication_slots: {{ .Values.postgresql.config.maxReplicationSlots | quote }}
      {{- with .Values.postgresql.config.additionalParameters }}
      {{- toYaml . | nindent 6 }}
      {{- end }}

  # Storage configuration
  storage:
    size: {{ .Values.postgresql.storage.size }}
    storageClass: {{ .Values.postgresql.storage.storageClass }}
    {{- with .Values.postgresql.storage.pvcTemplate }}
    pvcTemplate:
      {{- toYaml . | nindent 6 }}
    {{- end }}

  # Monitoring
  monitoring:
    enablePodMonitor: {{ .Values.postgresql.monitoring.enabled }}
    {{- with .Values.postgresql.monitoring.podMonitorLabels }}
    podMonitorLabels:
      {{- toYaml . | nindent 6 }}
    {{- end }}

  {{- if .Values.postgresql.backup.enabled }}
  # Backup configuration
  backup:
    barmanObjectStore:
      destinationPath: {{ .Values.postgresql.backup.destinationPath }}
      {{- if .Values.postgresql.backup.endpointURL }}
      endpointURL: {{ .Values.postgresql.backup.endpointURL }}
      {{- end }}
      {{- if .Values.postgresql.backup.s3Credentials }}
      s3Credentials:
        accessKeyId:
          name: {{ .Values.postgresql.backup.s3Credentials.secretName }}
          key: {{ .Values.postgresql.backup.s3Credentials.accessKeyIdKey }}
        secretAccessKey:
          name: {{ .Values.postgresql.backup.s3Credentials.secretName }}
          key: {{ .Values.postgresql.backup.s3Credentials.secretAccessKeyKey }}
      {{- end }}
      {{- with .Values.postgresql.backup.wal }}
      wal:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- with .Values.postgresql.backup.data }}
      data:
        {{- toYaml . | nindent 8 }}
      {{- end }}
    retentionPolicy: {{ .Values.postgresql.backup.retentionPolicy | quote }}
    {{- if .Values.postgresql.backup.schedule }}
    schedule: {{ .Values.postgresql.backup.schedule | quote }}
    {{- end }}
  {{- end }}

  # Bootstrap configuration
  bootstrap:
    initdb:
      database: {{ .Values.postgresql.database }}
      owner: {{ .Values.postgresql.username }}
      {{- if .Values.externalSecrets.enabled }}
      # Use Doppler password for production
      secret:
        name: {{ include "sveltehr.fullname" . }}-secrets
      {{- else }}
      # Use Helm-generated password for dev
      secret:
        name: {{ include "sveltehr.fullname" . }}-postgres-app-secret
      {{- end }}

  # Superuser configuration
  superuserSecret:
    name: {{ include "sveltehr.fullname" . }}-postgres-superuser-secret

  # High availability configuration
  {{- if gt (int .Values.postgresql.instances) 1 }}
  # Automatic failover enabled for HA setup
  primaryUpdateStrategy: unsupervised
  primaryUpdateMethod: switchover
  {{- end }}

  # Resources
  resources:
    requests:
      memory: {{ .Values.postgresql.resources.requests.memory }}
      cpu: {{ .Values.postgresql.resources.requests.cpu }}
    limits:
      memory: {{ .Values.postgresql.resources.limits.memory }}
      cpu: {{ .Values.postgresql.resources.limits.cpu }}

  {{- with .Values.postgresql.affinity }}
  # Pod affinity rules
  affinity:
    {{- toYaml . | nindent 4 }}
  {{- end }}

  {{- with .Values.postgresql.nodeSelector }}
  # Node selector
  nodeSelector:
    {{- toYaml . | nindent 4 }}
  {{- end }}

  {{- with .Values.postgresql.tolerations }}
  # Tolerations
  tolerations:
    {{- toYaml . | nindent 4 }}
  {{- end }}

---
# PostgreSQL application user secret
apiVersion: v1
kind: Secret
metadata:
  name: {{ include "sveltehr.fullname" . }}-postgres-app-secret
  namespace: {{ .Values.global.namespace }}
  labels:
    {{- include "sveltehr.labels" . | nindent 4 }}
    app.kubernetes.io/component: database
type: Opaque
stringData:
  username: {{ .Values.postgresql.username }}
  password: {{ .Values.postgresql.password | default (randAlphaNum 32) }}

---
# PostgreSQL superuser secret
apiVersion: v1
kind: Secret
metadata:
  name: {{ include "sveltehr.fullname" . }}-postgres-superuser-secret
  namespace: {{ .Values.global.namespace }}
  labels:
    {{- include "sveltehr.labels" . | nindent 4 }}
    app.kubernetes.io/component: database
type: Opaque
stringData:
  username: postgres
  password: {{ .Values.postgresql.superuserPassword | default (randAlphaNum 32) }}

{{- end }}
</file>

<file path="k8s/helm-charts/sveltehr/templates/postgres-scheduled-backup.yaml">
{{- if and .Values.postgresql.enabled .Values.postgresql.backup.enabled }}
---
apiVersion: postgresql.cnpg.io/v1
kind: ScheduledBackup
metadata:
  name: {{ include "sveltehr.fullname" . }}-postgres-daily-backup
  namespace: {{ .Values.global.namespace }}
  labels:
    {{- include "sveltehr.labels" . | nindent 4 }}
    app.kubernetes.io/component: postgres-backup
spec:
  # Six-field cron schedule: second minute hour day month weekday
  # Daily at 3:00 AM UTC (after Velero at 2 AM)
  schedule: "0 0 3 * * *"

  # Don't suspend backups
  suspend: false

  # Backup owner reference (for garbage collection)
  backupOwnerReference: self

  # Target cluster
  cluster:
    name: {{ include "sveltehr.fullname" . }}-postgres

  # Use barman object store method
  method: barmanObjectStore

  # Prefer standby for backups (less impact on primary)
  target: prefer-standby
{{- end }}
</file>

<file path="k8s/helm-charts/sveltehr/templates/rbac.yaml">
{{- if and .Values.rbac .Values.rbac.enabled -}}
---
# Backend Service Account
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ include "sveltehr.serviceAccountName" . }}-backend
  namespace: {{ .Values.global.namespace }}
  labels:
    {{- include "sveltehr.labels" . | nindent 4 }}
    app.kubernetes.io/component: backend
  {{- with .Values.serviceAccount.annotations }}
  annotations:
    {{- toYaml . | nindent 4 }}
  {{- end }}
automountServiceAccountToken: true

---
# Frontend Service Account
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ include "sveltehr.serviceAccountName" . }}-frontend
  namespace: {{ .Values.global.namespace }}
  labels:
    {{- include "sveltehr.labels" . | nindent 4 }}
    app.kubernetes.io/component: frontend
  {{- with .Values.serviceAccount.annotations }}
  annotations:
    {{- toYaml . | nindent 4 }}
  {{- end }}
automountServiceAccountToken: true

---
# Backend Role - Database access and configuration reading
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: {{ include "sveltehr.fullname" . }}-backend
  namespace: {{ .Values.global.namespace }}
  labels:
    {{- include "sveltehr.labels" . | nindent 4 }}
    app.kubernetes.io/component: backend
rules:
  # Read ConfigMaps for application configuration
  - apiGroups: [""]
    resources: ["configmaps"]
    verbs: ["get", "list", "watch"]

  # Read Secrets for credentials
  - apiGroups: [""]
    resources: ["secrets"]
    verbs: ["get", "list"]
    resourceNames:
      - {{ include "sveltehr.fullname" . }}-postgres-app-secret
      - {{ include "sveltehr.fullname" . }}-secrets

  # Read Pod information for service discovery
  - apiGroups: [""]
    resources: ["pods"]
    verbs: ["get", "list"]

  # Read Services for internal service discovery
  - apiGroups: [""]
    resources: ["services"]
    verbs: ["get", "list"]

  {{- if and .Values.rbac.backend .Values.rbac.backend.additionalRules }}
  {{- toYaml .Values.rbac.backend.additionalRules | nindent 2 }}
  {{- end }}

---
# Backend RoleBinding
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: {{ include "sveltehr.fullname" . }}-backend
  namespace: {{ .Values.global.namespace }}
  labels:
    {{- include "sveltehr.labels" . | nindent 4 }}
    app.kubernetes.io/component: backend
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: {{ include "sveltehr.fullname" . }}-backend
subjects:
  - kind: ServiceAccount
    name: {{ include "sveltehr.serviceAccountName" . }}-backend
    namespace: {{ .Values.global.namespace }}

---
# Frontend Role - Basic read access
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: {{ include "sveltehr.fullname" . }}-frontend
  namespace: {{ .Values.global.namespace }}
  labels:
    {{- include "sveltehr.labels" . | nindent 4 }}
    app.kubernetes.io/component: frontend
rules:
  # Read ConfigMaps for frontend configuration
  - apiGroups: [""]
    resources: ["configmaps"]
    verbs: ["get", "list"]

  # Read Services for backend discovery
  - apiGroups: [""]
    resources: ["services"]
    verbs: ["get", "list"]

  {{- if and .Values.rbac.frontend .Values.rbac.frontend.additionalRules }}
  {{- toYaml .Values.rbac.frontend.additionalRules | nindent 2 }}
  {{- end }}

---
# Frontend RoleBinding
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: {{ include "sveltehr.fullname" . }}-frontend
  namespace: {{ .Values.global.namespace }}
  labels:
    {{- include "sveltehr.labels" . | nindent 4 }}
    app.kubernetes.io/component: frontend
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: {{ include "sveltehr.fullname" . }}-frontend
subjects:
  - kind: ServiceAccount
    name: {{ include "sveltehr.serviceAccountName" . }}-frontend
    namespace: {{ .Values.global.namespace }}

---
# Migration Job Service Account
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ include "sveltehr.serviceAccountName" . }}-migration
  namespace: {{ .Values.global.namespace }}
  labels:
    {{- include "sveltehr.labels" . | nindent 4 }}
    app.kubernetes.io/component: migration
  {{- with .Values.serviceAccount.annotations }}
  annotations:
    {{- toYaml . | nindent 4 }}
  {{- end }}
automountServiceAccountToken: true

---
# Migration Role - Database migration permissions
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: {{ include "sveltehr.fullname" . }}-migration
  namespace: {{ .Values.global.namespace }}
  labels:
    {{- include "sveltehr.labels" . | nindent 4 }}
    app.kubernetes.io/component: migration
rules:
  # Read Secrets for database credentials
  - apiGroups: [""]
    resources: ["secrets"]
    verbs: ["get"]
    resourceNames:
      - {{ include "sveltehr.fullname" . }}-postgres-app-secret

  # Read ConfigMaps for migration configuration
  - apiGroups: [""]
    resources: ["configmaps"]
    verbs: ["get", "list"]

  # Read Services for database discovery
  - apiGroups: [""]
    resources: ["services"]
    verbs: ["get"]

  {{- if and .Values.rbac.migration .Values.rbac.migration.additionalRules }}
  {{- toYaml .Values.rbac.migration.additionalRules | nindent 2 }}
  {{- end }}

---
# Migration RoleBinding
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: {{ include "sveltehr.fullname" . }}-migration
  namespace: {{ .Values.global.namespace }}
  labels:
    {{- include "sveltehr.labels" . | nindent 4 }}
    app.kubernetes.io/component: migration
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: {{ include "sveltehr.fullname" . }}-migration
subjects:
  - kind: ServiceAccount
    name: {{ include "sveltehr.serviceAccountName" . }}-migration
    namespace: {{ .Values.global.namespace }}

{{- if .Values.rbac.createClusterRole }}
---
# Optional ClusterRole for cross-namespace access
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: {{ include "sveltehr.fullname" . }}-cluster
  labels:
    {{- include "sveltehr.labels" . | nindent 4 }}
rules:
  # Read nodes for node discovery (useful for distributed systems)
  - apiGroups: [""]
    resources: ["nodes"]
    verbs: ["get", "list"]

  # Read namespaces for multi-tenant scenarios
  - apiGroups: [""]
    resources: ["namespaces"]
    verbs: ["get", "list"]

  {{- if .Values.rbac.clusterRole.additionalRules }}
  {{- toYaml .Values.rbac.clusterRole.additionalRules | nindent 2 }}
  {{- end }}

---
# ClusterRoleBinding for backend
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: {{ include "sveltehr.fullname" . }}-backend-cluster
  labels:
    {{- include "sveltehr.labels" . | nindent 4 }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: {{ include "sveltehr.fullname" . }}-cluster
subjects:
  - kind: ServiceAccount
    name: {{ include "sveltehr.serviceAccountName" . }}-backend
    namespace: {{ .Values.global.namespace }}
{{- end }}

{{- end }}
</file>

<file path="k8s/helm-charts/sveltehr/templates/seed-job.yaml">
{{- if and .Values.seed .Values.seed.enabled -}}
---
apiVersion: batch/v1
kind: Job
metadata:
  name: {{ include "sveltehr.fullname" . }}-seed
  namespace: {{ .Values.global.namespace }}
  labels:
    {{- include "sveltehr.labels" . | nindent 4 }}
    app.kubernetes.io/component: seed
  annotations:
    # Manual execution only - NOT a Helm hook
    # Run with: kubectl create job --from=cronjob/sveltehr-seed sveltehr-seed-manual
    # Or: helm test sveltehr --filter name=seed
    "helm.sh/hook": test
    "helm.sh/hook-weight": "10"
    "helm.sh/hook-delete-policy": hook-succeeded
    manual-execution: "true"
    {{- with .Values.seed.annotations }}
    {{- toYaml . | nindent 4 }}
    {{- end }}
spec:
  ttlSecondsAfterFinished: {{ .Values.seed.ttlSecondsAfterFinished }}
  backoffLimit: {{ .Values.seed.backoffLimit }}

  template:
    metadata:
      labels:
        {{- include "sveltehr.selectorLabels" . | nindent 8 }}
        app.kubernetes.io/component: seed
      {{- with .Values.seed.podAnnotations }}
      annotations:
        {{- toYaml . | nindent 8 }}
      {{- end }}
    spec:
      restartPolicy: OnFailure

      # Service account
      {{- if .Values.serviceAccount.create }}
      serviceAccountName: {{ include "sveltehr.serviceAccountName" . }}-backend
      {{- end }}

      # Init container: Wait for PostgreSQL and migrations
      initContainers:
        - name: wait-for-postgres
          image: postgres:16-alpine
          command:
            - sh
            - -c
            - |
              echo "Waiting for PostgreSQL and migrations to complete..."
              until pg_isready -h $(DB_HOST) -p $(DB_PORT) -U $(DB_USER); do
                echo "  PostgreSQL is unavailable - sleeping 2s"
                sleep 2
              done
              echo "PostgreSQL is ready!"

              # Additional wait to ensure migrations have run
              sleep 5
          env:
            - name: DB_HOST
              value: {{ .Values.postgresql.service.name | default (printf "%s-postgres-rw" (include "sveltehr.fullname" .)) }}
            - name: DB_PORT
              value: {{ .Values.postgresql.service.port | default "5432" | quote }}
            - name: DB_USER
              value: {{ .Values.postgresql.username }}
            - name: PGPASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ include "sveltehr.fullname" . }}-postgres-app-secret
                  key: password

      # Seed data container
      containers:
        - name: seed
          image: "{{ .Values.seed.image.repository }}:{{ .Values.seed.image.tag | default .Chart.AppVersion }}"
          imagePullPolicy: {{ .Values.seed.image.pullPolicy }}

          command:
            - sh
            - -c
            - |
              echo "================================================================"
              echo "  SvelteHR Database Seeding"
              echo "================================================================"
              echo "Database: ${DB_NAME}"
              echo "Environment: ${ENVIRONMENT}"
              echo "================================================================"
              echo ""
              echo "Creating initial admin user and seed data..."
              echo ""

              # Run seed-data binary
              ./seed-data

              SEED_EXIT_CODE=$?

              if [ $SEED_EXIT_CODE -eq 0 ]; then
                echo ""
                echo "================================================================"
                echo "  Seed data created successfully!"
                echo "================================================================"
                {{- if .Values.seed.adminEmail }}
                echo "Admin email: {{ .Values.seed.adminEmail }}"
                {{- end }}
              else
                echo ""
                echo "================================================================"
                echo "  Seed data failed with exit code: $SEED_EXIT_CODE"
                echo "  (This may be expected if seed data already exists)"
                echo "================================================================"

                # Exit code 1 typically means data already exists - not a fatal error
                if [ $SEED_EXIT_CODE -eq 1 ]; then
                  echo "Seed data appears to already exist. Continuing..."
                  exit 0
                fi

                exit $SEED_EXIT_CODE
              fi

          env:
            # Database connection
            - name: DB_HOST
              value: {{ .Values.postgresql.service.name | default (printf "%s-postgres-rw" (include "sveltehr.fullname" .)) }}
            - name: DB_PORT
              value: {{ .Values.postgresql.service.port | default "5432" | quote }}
            - name: DB_NAME
              value: {{ .Values.postgresql.database }}
            - name: DB_USER
              value: {{ .Values.postgresql.username }}
            - name: DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ include "sveltehr.fullname" . }}-postgres-app-secret
                  key: password

            # Construct DATABASE_URL
            - name: DATABASE_URL
              value: "postgres://$(DB_USER):$(DB_PASSWORD)@$(DB_HOST):$(DB_PORT)/$(DB_NAME)"

            # Admin credentials (optional)
            {{- if .Values.seed.adminEmail }}
            - name: ADMIN_EMAIL
              value: {{ .Values.seed.adminEmail }}
            {{- end }}
            {{- if .Values.seed.adminPassword }}
            - name: ADMIN_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ include "sveltehr.fullname" . }}-seed-admin
                  key: password
            {{- end }}

            # Environment
            - name: RUST_LOG
              value: {{ .Values.seed.rustLog | default "info,seed_data=debug" }}
            - name: ENVIRONMENT
              value: {{ .Values.global.environment }}
            - name: ENABLE_SEED_DATA
              value: "true"

            {{- with .Values.seed.extraEnv }}
            {{- toYaml . | nindent 12 }}
            {{- end }}

          resources:
            {{- toYaml .Values.seed.resources | nindent 12 }}

          securityContext:
            allowPrivilegeEscalation: false
            runAsNonRoot: true
            runAsUser: 1001
            capabilities:
              drop:
                - ALL
            {{- with .Values.seed.securityContext }}
            {{- toYaml . | nindent 12 }}
            {{- end }}

      {{- with .Values.seed.nodeSelector }}
      nodeSelector:
        {{- toYaml . | nindent 8 }}
      {{- end }}

      {{- with .Values.seed.tolerations }}
      tolerations:
        {{- toYaml . | nindent 8 }}
      {{- end }}

      {{- with .Values.seed.affinity }}
      affinity:
        {{- toYaml . | nindent 8 }}
      {{- end }}

{{- if .Values.seed.adminPassword }}
---
# Admin password secret (if provided)
apiVersion: v1
kind: Secret
metadata:
  name: {{ include "sveltehr.fullname" . }}-seed-admin
  namespace: {{ .Values.global.namespace }}
  labels:
    {{- include "sveltehr.labels" . | nindent 4 }}
    app.kubernetes.io/component: seed
type: Opaque
stringData:
  password: {{ .Values.seed.adminPassword }}
{{- end }}

{{- end }}
</file>

