```

### Element Queries

```typescript
// Get text content
const text = await getElementText('[data-testid="count"]');

// Get attribute
const href = await getElementAttribute('a.link', 'href');

// Check visibility
const isVisible = await isElementVisible('[data-testid="modal"]');

// Count elements
