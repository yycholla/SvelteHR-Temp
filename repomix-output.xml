			// Check first 1000 bytes - should NOT match plaintext pattern
			let matchingBytes = 0;
			for (let i = 0; i < 1000; i++) {
				if (encryptedBytes[i] === fileContent[i]) {
					matchingBytes++;
				}
			}

			// Expect very few accidental matches (<5% due to randomness)
