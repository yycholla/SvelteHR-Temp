			},
			timestamp: new Date().toISOString()
		});
	} catch (err) {
		console.error('Performance config update error:', err);

		error(500, {
        			message: 'Failed to update performance configuration',
        			error: err instanceof Error ? err.message : 'Unknown error'
        		});
	}
