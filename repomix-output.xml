		iconOnly?: boolean;
		onclick?: ((event: MouseEvent) => void) | undefined;
		children?: Snippet;
	} = $props();

	// Class computation
	let buttonClasses = $derived(
		[
			'btn',
			`btn--${variant}`,
			`btn--${size}`,
