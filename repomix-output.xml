						onDateClick={(date) => {
							const start = formatLocalISO(date);
                            const endObj = new Date(date);
                            endObj.setMinutes(endObj.getMinutes() + 30);
							createDialogDefaults = { startTime: start, endTime: formatLocalISO(endObj), allDay: false };
							showCreateDialog = true;
