			{/each}
		</div>

		<!-- Filters -->
		<div class="mb-8 rounded-lg border bg-card p-6 shadow-sm">
			<div class="mb-4 flex items-center gap-4">
				<div class="flex-1">
					<label for="search" class="sr-only">Search reports</label>
					<div class="relative">
