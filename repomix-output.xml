  enabled: true
  scrapeInterval: 30s
  scrapeTimeout: 10s

# pgAdmin configuration
pgadmin:
  enabled: false  # Disabled by default for dev
  email: "admin@sveltehr.dev"
  password: "admin"

  image:
    repository: dpage/pgadmin4
    tag: latest
    pullPolicy: IfNotPresent

  resources:
    requests:
      memory: "256Mi"
      cpu: "100m"
    limits:
      memory: "512Mi"
      cpu: "500m"

