	 * Check if time slot is available
	 */
	static async isTimeSlotAvailable(
		userId: string,
		startTime: Date,
		endTime: Date,
		excludeEventId?: string
	): Promise<boolean> {
		const result = await this.checkConflicts({
			userId,
			startTime,
