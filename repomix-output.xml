<file path=".github/workflows/release.yml">
name: Create Release

on:
  workflow_dispatch:
    inputs:
      version:
        description: 'Version to release (e.g., 1.2.3)'
        required: true
        type: string
      bump:
        description: 'Auto-bump version type'
        required: false
        type: choice
        options:
          - ''
          - patch
          - minor
          - major

jobs:
  create-release:
    runs-on: blacksmith-4vcpu-ubuntu-2404
    permissions:
      contents: write

    steps:
      - name: Checkout code
        uses: actions/checkout@v5
        with:
          fetch-depth: 0
          token: ${{ secrets.GITHUB_TOKEN }}

      - name: Configure Git
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"

      - name: Get latest tag
        id: get-latest-tag
        run: |
          # Get latest tag or default to 0.0.0
          LATEST_TAG=$(git describe --tags --abbrev=0 2>/dev/null || echo "0.0.0")
          echo "latest_tag=$LATEST_TAG" >> $GITHUB_OUTPUT
          echo "📌 Latest tag: $LATEST_TAG"

      - name: Calculate next version
        id: calc-version
        run: |
          LATEST="${{ steps.get-latest-tag.outputs.latest_tag }}"
          BUMP="${{ github.event.inputs.bump }}"
          MANUAL="${{ github.event.inputs.version }}"

          # If manual version provided, use it
          if [ -n "$MANUAL" ]; then
            NEW_VERSION="$MANUAL"
          elif [ -n "$BUMP" ]; then
            # Parse semver
            IFS='.' read -r MAJOR MINOR PATCH <<< "$LATEST"

            case "$BUMP" in
              major)
                NEW_VERSION="$((MAJOR + 1)).0.0"
                ;;
              minor)
                NEW_VERSION="${MAJOR}.$((MINOR + 1)).0"
                ;;
              patch)
                NEW_VERSION="${MAJOR}.${MINOR}.$((PATCH + 1))"
                ;;
            esac
          else
            echo "❌ Either version or bump must be provided"
            exit 1
          fi

          # Validate semver format
          if ! echo "$NEW_VERSION" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+$'; then
            echo "❌ Invalid semantic version: $NEW_VERSION"
            exit 1
          fi

          echo "new_version=$NEW_VERSION" >> $GITHUB_OUTPUT
          echo "✨ New version: $NEW_VERSION"

      - name: Check if tag exists
        id: check-tag
        run: |
          VERSION="${{ steps.calc-version.outputs.new_version }}"
          if git rev-parse "$VERSION" >/dev/null 2>&1; then
            echo "❌ Tag $VERSION already exists"
            exit 1
          fi
          echo "✅ Tag $VERSION is available"

      - name: Generate changelog
        id: changelog
        run: |
          VERSION="${{ steps.calc-version.outputs.new_version }}"
          LATEST="${{ steps.get-latest-tag.outputs.latest_tag }}"

          echo "## Release $VERSION" > CHANGELOG.tmp
          echo "" >> CHANGELOG.tmp
          echo "### Changes since $LATEST" >> CHANGELOG.tmp
          echo "" >> CHANGELOG.tmp

          # Get commits since last tag
          if [ "$LATEST" != "0.0.0" ]; then
            git log --pretty=format:"- %s (%h)" "$LATEST"..HEAD >> CHANGELOG.tmp
          else
            git log --pretty=format:"- %s (%h)" HEAD >> CHANGELOG.tmp
          fi

          cat CHANGELOG.tmp

          # Escape for GitHub output
          {
            echo 'changelog<<EOF'
            cat CHANGELOG.tmp
            echo EOF
          } >> $GITHUB_OUTPUT

      - name: Create and push tag
        run: |
          VERSION="${{ steps.calc-version.outputs.new_version }}"
          git tag -a "$VERSION" -m "Release $VERSION"
          git push origin "$VERSION"
          echo "✅ Created and pushed tag $VERSION"

      - name: Create GitHub Release
        uses: actions/github-script@v7
        with:
          script: |
            const version = '${{ steps.calc-version.outputs.new_version }}';
            const changelog = `${{ steps.changelog.outputs.changelog }}`;

            await github.rest.repos.createRelease({
              owner: context.repo.owner,
              repo: context.repo.repo,
              tag_name: version,
              name: `Release ${version}`,
              body: changelog,
              draft: false,
              prerelease: false
            });

            core.info(`✅ Created GitHub Release for ${version}`);

      - name: Summary
        run: |
          VERSION="${{ steps.calc-version.outputs.new_version }}"
          echo "## 🚀 Release Created" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "**Version:** \`$VERSION\`" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "### Next Steps" >> $GITHUB_STEP_SUMMARY
          echo "1. Docker images will be built automatically" >> $GITHUB_STEP_SUMMARY
          echo "2. ArgoCD will detect the new version" >> $GITHUB_STEP_SUMMARY
          echo "3. Images will be available at:" >> $GITHUB_STEP_SUMMARY
          echo "   - \`ghcr.io/${{ github.repository }}/backend-server:$VERSION\`" >> $GITHUB_STEP_SUMMARY
          echo "   - \`ghcr.io/${{ github.repository }}/frontend:$VERSION\`" >> $GITHUB_STEP_SUMMARY
</file>

<file path=".github/workflows/rust-benchmark.yml">
name: Benchmark (Rust Backend)

on:
  push:
    branches: [main]
    paths:
      - 'graphql-rust-server/**'
      - '.github/workflows/rust-benchmark.yml'
  pull_request:
    branches: [main]
    paths:
      - 'graphql-rust-server/**'
      - '.github/workflows/rust-benchmark.yml'
  workflow_dispatch:  # Allow manual triggering

# Cancel in-progress runs
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

env:
  CARGO_TERM_COLOR: always

jobs:
  benchmark:
    name: Performance Benchmarks
    runs-on: blacksmith-4vcpu-ubuntu-2404
    # Skip benchmarks on Dependabot PRs
    if: github.actor != 'dependabot[bot]'

    services:
      postgres:
        image: postgres:15-alpine
        env:
          POSTGRES_USER: postgres
          POSTGRES_PASSWORD: postgres
          POSTGRES_DB: benchmark_db
        ports:
          - 5432:5432
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5

    steps:
      - name: Checkout code
        uses: actions/checkout@v5

      - name: Install mold linker
        run: |
          sudo apt-get update
          sudo apt-get install -y mold clang

      - name: Install Rust toolchain
        uses: dtolnay/rust-toolchain@stable

      - name: Cache cargo registry and build artifacts
        uses: actions/cache@v4
        with:
          path: |
            ~/.cargo/registry
            ~/.cargo/git
            graphql-rust-server/target
          key: ${{ runner.os }}-cargo-bench-${{ hashFiles('**/Cargo.lock') }}
          restore-keys: |
            ${{ runner.os }}-cargo-bench-
            ${{ runner.os }}-cargo-

      - name: Run benchmarks
        working-directory: ./graphql-rust-server
        run: cargo bench --bench resolver_benchmarks -- --output-format bencher | tee benchmark_output.txt

      - name: Store benchmark result (GitHub Pages)
        uses: benchmark-action/github-action-benchmark@v1
        if: github.ref == 'refs/heads/main'
        with:
          name: Rust Resolver Benchmarks
          tool: 'cargo'
          output-file-path: ./graphql-rust-server/benchmark_output.txt
          github-token: ${{ secrets.GITHUB_TOKEN }}
          auto-push: true
          # Publish to gh-pages branch
          gh-pages-branch: gh-pages
          benchmark-data-dir-path: benchmarks
          # Show alert with commit comment on detecting possible performance regression
          alert-threshold: '150%'
          comment-on-alert: true
          fail-on-alert: false
          # Comment always on main branch commits
          comment-always: true
          summary-always: true

      - name: Generate benchmark summary
        run: |
          echo "## 📊 Benchmark Results" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "Detailed benchmark results have been stored in GitHub Pages." >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "**View full results:** https://${{ github.repository_owner }}.github.io/${{ github.event.repository.name }}/benchmarks/" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY

          # Parse benchmark output for summary
          if [ -f benchmark_output.txt ]; then
            echo "### Top 5 Benchmarks" >> $GITHUB_STEP_SUMMARY
            echo "" >> $GITHUB_STEP_SUMMARY
            echo "| Benchmark | Time (ns/iter) |" >> $GITHUB_STEP_SUMMARY
            echo "|-----------|----------------|" >> $GITHUB_STEP_SUMMARY
            head -5 benchmark_output.txt | while read line; do
              echo "| $line |" >> $GITHUB_STEP_SUMMARY
            done
          fi

      - name: Upload benchmark results
        uses: actions/upload-artifact@v5
        with:
          name: benchmark-results
          path: graphql-rust-server/target/criterion/
          retention-days: 30

  benchmark-comparison:
    name: Benchmark Comparison
    runs-on: blacksmith-4vcpu-ubuntu-2404
    if: github.event_name == 'pull_request'

    services:
      postgres:
        image: postgres:15-alpine
        env:
          POSTGRES_USER: postgres
          POSTGRES_PASSWORD: postgres
          POSTGRES_DB: benchmark_db
        ports:
          - 5432:5432
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5

    steps:
      - name: Checkout PR code
        uses: actions/checkout@v5

      - name: Install mold linker
        run: |
          sudo apt-get update
          sudo apt-get install -y mold clang

      - name: Install Rust toolchain
        uses: dtolnay/rust-toolchain@stable

      - name: Cache cargo registry and build artifacts
        uses: actions/cache@v4
        with:
          path: |
            ~/.cargo/registry
            ~/.cargo/git
            graphql-rust-server/target
          key: ${{ runner.os }}-cargo-bench-pr-${{ hashFiles('**/Cargo.lock') }}
          restore-keys: |
            ${{ runner.os }}-cargo-bench-
            ${{ runner.os }}-cargo-

      - name: Run PR benchmarks
        working-directory: ./graphql-rust-server
        run: cargo bench --bench resolver_benchmarks -- --save-baseline pr

      - name: Checkout main branch
        uses: actions/checkout@v5
        with:
          ref: main

      - name: Run main benchmarks
        working-directory: ./graphql-rust-server
        run: cargo bench --bench resolver_benchmarks -- --save-baseline main

      - name: Compare benchmarks
        working-directory: ./graphql-rust-server
        run: cargo bench --bench resolver_benchmarks -- --baseline main --load-baseline pr

      - name: Store PR benchmark result
        uses: benchmark-action/github-action-benchmark@v1
        with:
          name: Rust Resolver Benchmarks (PR)
          tool: 'cargo'
          output-file-path: ./graphql-rust-server/benchmark_output.txt
          github-token: ${{ secrets.GITHUB_TOKEN }}
          auto-push: false
          save-data-file: true
          comment-on-alert: true
          alert-threshold: '150%'
          fail-on-alert: false

      - name: Comment PR with benchmark comparison
        uses: actions/github-script@v8
        if: always()
        with:
          script: |
            const fs = require('fs');
            const path = require('path');

            let comment = `## ⚡ Performance Benchmark Comparison\n\n`;
            comment += `Benchmarks have been run comparing this PR against the main branch.\n\n`;

            // Try to read criterion output
            const criterionPath = './graphql-rust-server/target/criterion';
            if (fs.existsSync(criterionPath)) {
              comment += `### Benchmark Results\n\n`;
              comment += `Detailed HTML reports are available in the workflow artifacts.\n\n`;
              comment += `**View full results:** https://${{ github.repository_owner }}.github.io/${{ github.event.repository.name }}/benchmarks/\n\n`;
            }

            comment += `✅ Check the Actions summary for detailed performance metrics.\n`;

            github.rest.issues.createComment({
              issue_number: context.issue.number,
              owner: context.repo.owner,
              repo: context.repo.repo,
              body: comment
            });
</file>

