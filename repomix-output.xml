				"createdAt": "2025-10-09T10:30:00Z"
			},
			"clientMutationId": "unique-client-id"
		}
	}
}
```

---

### updateTask

Update an existing task.

**Mutation:**

```graphql
mutation UpdateTask($input: UpdateTaskByIdInput!) {
	updateTaskById(input: $input) {
		task {
			id
			title
			status
			priority
			updatedAt
		}
		clientMutationId
	}
}
```

**Variables:**

```json
{
