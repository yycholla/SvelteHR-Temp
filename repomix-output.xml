# Root App-of-Apps
# The top-level Application that manages all other app-of-apps
# This creates a hierarchical structure:
#   root-app
#   ├── infrastructure (app-of-apps)
#   │   ├── monitoring
#   │   ├── cloudnative-pg
#   │   ├── ingress-nginx
#   │   ├── cert-manager
#   │   ├── tailscale
#   │   ├── external-secrets
#   │   ├── minio
#   │   └── velero
#   ├── dev-apps (app-of-apps)
#   │   └── sveltehr-dev
#   └── prod-apps (app-of-apps)
#       └── sveltehr-prod
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: root-app
  namespace: argocd
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: default  # Root app uses default project (unrestricted)

  # Source: All app-of-apps manifests from Git
  source:
    repoURL: https://github.com/Mountain-Care-Rx/SvelteHR.git
    targetRevision: main
    path: k8s/argocd/apps
    directory:
      # Include only app-of-apps files, not this root-app.yaml
      exclude: 'root-app.yaml'

  # Destination: Deploy to in-cluster
  destination:
    server: https://kubernetes.default.svc
    namespace: argocd

  # Sync policy: MANUAL (critical - never auto-sync the root!)
  syncPolicy:
    automated: null  # NEVER enable automated sync for root app

    syncOptions:
      - CreateNamespace=false  # argocd namespace already exists

    retry:
      limit: 2
      backoff:
        duration: 10s
        maxDuration: 3m

  # Ignore differences in child Application status
  ignoreDifferences:
    - group: argoproj.io
      kind: Application
      jsonPointers:
        - /status
        - /operation

  revisionHistoryLimit: 10

# =============================================================================
# Root App-of-Apps Notes
# =============================================================================
#
# WARNING: This is the ROOT application that manages everything.
# DO NOT enable automated sync on this application!
#
# Deployment (after all other apps are tested):
#   kubectl apply -f k8s/argocd/apps/root-app.yaml
#
# Sync the root (creates all app-of-apps):
#   argocd app sync root-app
#
# View the entire application tree:
#   argocd app tree root-app
#
# This will create 3 app-of-apps Applications:
#   1. infrastructure - Manages platform components
#   2. dev-apps - Manages dev environment
#   3. prod-apps - Manages prod environment
#
# Each app-of-apps must be synced individually:
#   argocd app sync infrastructure
#   argocd app sync dev-apps
#   argocd app sync prod-apps
#
# Then, each child application can be synced:
#   argocd app sync monitoring
#   argocd app sync cloudnative-pg
#   argocd app sync sveltehr-dev
#   argocd app sync sveltehr-prod
#
# View all applications:
#   argocd app list
#
# Migration Strategy:
#   1. First apply individual Applications manually (done)
#   2. Then apply app-of-apps (infrastructure, dev-apps, prod-apps)
#   3. Finally apply root-app once everything is stable
#
# =============================================================================
</file>

<file path="k8s/argocd/infrastructure/argocd-image-updater-app.yaml">
---
# ArgoCD Application for ArgoCD Image Updater
# Enables automated GHCR image updates with semantic versioning
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: argocd-image-updater
  namespace: argocd
  annotations:
    argocd.argoproj.io/sync-wave: "1"  # Install after monitoring (wave 0)
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  # Use infrastructure AppProject
  project: infrastructure

  # Source: Official ArgoCD Helm chart repository
  source:
    repoURL: https://argoproj.github.io/argo-helm
    targetRevision: 0.14.0
    chart: argocd-image-updater
    helm:
      releaseName: argocd-image-updater

      # Image Updater configuration
      values: |
        # Config for Image Updater
        config:
          # ArgoCD API configuration
          argocd:
            serverAddress: "http://argocd-server.argocd.svc.cluster.local"
            insecure: true
            plaintext: true

          # Registry configurations for GHCR
          registries:
            - name: GHCR
              prefix: ghcr.io
              api_url: https://ghcr.io
              ping: yes
              credentials: pullsecret:sveltehr-prod/ghcr-pull-secret
              default: yes

          # Update interval (default: 2 minutes)
          interval: 2m

          # Log level
          logLevel: info

        # Authentication method (use existing ArgoCD credentials)
        authScripts:
          enabled: false

        # Resource limits (BestEffort CPU for overcommitment on resource-constrained nodes)
        resources:
          requests:
            memory: "64Mi"
            # No CPU request/limit - allows scheduling on fully allocated nodes
          limits:
            memory: "128Mi"
            # No CPU limit - prevents Kubernetes from auto-setting CPU request

        # Metrics for monitoring
        metrics:
          enabled: true
          serviceMonitor:
            enabled: true
            namespace: argocd
            additionalLabels:
              release: prometheus

        # Security context
        securityContext:
          runAsNonRoot: true
          runAsUser: 1000
          readOnlyRootFilesystem: true

        # Service account
        serviceAccount:
          create: true
          name: argocd-image-updater

  # Destination: ArgoCD namespace
  destination:
    server: https://kubernetes.default.svc
    namespace: argocd

  # Sync policy: Manual sync for infrastructure components
  syncPolicy:
    automated:
      prune: true  # Remove resources deleted from Git
      selfHeal: true  # Auto-correct cluster drift  # Manual sync for infrastructure

    syncOptions:
      - CreateNamespace=false  # Namespace already exists
      - ServerSideApply=true

    retry:
      limit: 3
      backoff:
        duration: 10s
        factor: 2
        maxDuration: 3m

# =============================================================================
# ArgoCD Image Updater Deployment Notes
# =============================================================================
#
# Installation:
#   kubectl apply -f k8s/argocd/infrastructure/argocd-image-updater-app.yaml
#   argocd app sync argocd-image-updater
#
# Verify Installation:
#   kubectl get pods -n argocd -l app.kubernetes.io/name=argocd-image-updater
#   kubectl logs -n argocd -l app.kubernetes.io/name=argocd-image-updater -f
#
# Test Registry Access:
#   kubectl exec -n argocd $(kubectl get pod -n argocd -l app.kubernetes.io/name=argocd-image-updater -o name) -- \
#     argocd-image-updater test ghcr.io/mountain-care-rx/sveltehr/frontend --semver-constraint "^v1.0.0"
#
# Configuration:
#   - Uses existing GHCR pull secret in sveltehr-prod namespace
#   - Polls GHCR every 2 minutes for new semantic version tags
#   - Writes back to Git repository (main branch) when new versions detected
#   - Requires manual sync approval for production deployments
#
# =============================================================================
</file>

