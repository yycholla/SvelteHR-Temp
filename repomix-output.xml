										{#if isUpdating}
											<div
												class="mr-2 h-4 w-4 animate-spin rounded-full border-2 border-white border-t-transparent"
											></div>
										{:else}
											<Save class="mr-2 h-4 w-4" />
										{/if}
										{isUpdating ? 'Updating...' : 'Save Changes'}
									</Button>
								</Card.Footer>
							{/if}
						</Card.Root>

						<!-- Security Card -->
