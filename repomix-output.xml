												class="mr-2 h-4 w-4 animate-spin rounded-full border-2 border-gray-600 border-t-transparent"
											></div>
										{:else}
											<Lock class="mr-2 h-4 w-4" />
										{/if}
										{isUpdating ? 'Updating...' : 'Update Password'}
									</Button>
								</Card.Footer>
							</Card.Root>
						{/if}
