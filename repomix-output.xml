        );
        assert!(require_hr_manager(&admin_ctx).is_ok());

        let user_ctx = UserContext::new(
            Uuid::new_v4(),
            vec!["Employee".to_string()],
            vec![],
        );
        assert!(require_hr_manager(&user_ctx).is_err());
    }

    #[test]
