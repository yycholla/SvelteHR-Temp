    echo -e "${CYAN}║                                                       ║${NC}"
    echo -e "${CYAN}║        SvelteHR Fresh Installation Wizard             ║${NC}"
    echo -e "${CYAN}║                                                       ║${NC}"
    echo -e "${CYAN}╚═══════════════════════════════════════════════════════╝${NC}"
