<file path="k8s/helm-values/traefik-values.yaml">
# Traefik Configuration for Kubernetes Ingress
# Modern HTTP reverse proxy and load balancer
# Chart: traefik/traefik version 37.2.0 (Traefik v3.5.3)

# Deployment configuration
deployment:
  enabled: true
  kind: Deployment
  replicas: 1

# Image configuration
image:
  registry: docker.io
  repository: traefik
  tag: ""  # Use chart default (v3.5.3)
  pullPolicy: IfNotPresent

# Ports configuration
ports:
  web:
    port: 8000  # Unprivileged port (container)
    exposedPort: 80  # External port (service)
    nodePort: 30080  # Fixed NodePort for external access
    hostPort: 80  # Bind directly to host port 80
    expose:
      default: true
    protocol: TCP

  websecure:
    port: 8443  # Unprivileged port (container)
    exposedPort: 443  # External port (service)
    nodePort: 30443  # Fixed NodePort for HTTPS
    hostPort: 443  # Bind directly to host port 443
    expose:
      default: true
    protocol: TCP
    tls:
      enabled: true

  traefik:
    port: 9000
    exposedPort: 9000
    expose:
      default: false  # Dashboard not exposed externally
    protocol: TCP

# Service configuration
service:
  enabled: true
  type: LoadBalancer
  # k3s will assign LoadBalancer IP from MetalLB/ServiceLB

# IngressClass
ingressClass:
  enabled: true
  isDefaultClass: true  # Make Traefik the default IngressClass

# IngressRoute for Traefik dashboard (optional - disabled by default)
ingressRoute:
  dashboard:
    enabled: false  # Enable via Tailscale if needed

# Resources
resources:
  requests:
    cpu: 100m
    memory: 128Mi
  limits:
    cpu: 500m
    memory: 512Mi

# Security context (container level)
securityContext:
  runAsNonRoot: true
  runAsUser: 65532
  runAsGroup: 65532
  readOnlyRootFilesystem: true
  capabilities:
    drop:
      - ALL
    add:
      - NET_BIND_SERVICE  # Required to bind to ports 80 and 443 via hostPort

# Pod security context (pod level)
podSecurityContext:
  fsGroup: 65532  # fsGroup belongs at pod level, not container level
  seccompProfile:
    type: RuntimeDefault

# Logs
logs:
  general:
    level: INFO  # DEBUG, INFO, WARN, ERROR
  access:
    enabled: true
    format: json

# Metrics for Prometheus
metrics:
  prometheus:
    enabled: true
    addEntryPointsLabels: true
    addRoutersLabels: true
    addServicesLabels: true
    serviceMonitor:
      enabled: true
      interval: 30s
      additionalLabels:
        release: kube-prometheus-stack

# Global arguments
globalArguments:
  - "--global.checknewversion=false"
  - "--global.sendanonymoususage=false"

# Additional arguments
additionalArguments:
  - "--serversTransport.insecureSkipVerify=true"  # Allow self-signed certs for backend services
  # Trust the Windows Gateway IP so it accepts the X-Forwarded-For header
  - "--entryPoints.websecure.forwardedHeaders.trustedIPs=192.168.0.64"
  - "--entryPoints.web.forwardedHeaders.trustedIPs=192.168.0.64"

# TLS configuration
tlsOptions:
  default:
    minVersion: VersionTLS12
    cipherSuites:
      - TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
      - TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
      - TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
      - TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384

# RBAC
rbac:
  enabled: true

# Service account
serviceAccount:
  name: ""  # Empty string creates service account automatically with fullname template

# Persistence for certificates
persistence:
  enabled: true
  storageClass: ""  # Use default (local-path)
  size: 1Gi
  accessMode: ReadWriteOnce
  path: /data

# Affinity (optional)
# affinity: {}

# Node selector (optional)
# nodeSelector: {}

# Tolerations (optional)
# tolerations: []

# =============================================================================
# Usage Notes
# =============================================================================
#
# Traefik is the default ingress controller for k3s and handles:
#   - HTTP/HTTPS traffic routing
#   - Automatic HTTPS with Let's Encrypt (via cert-manager)
#   - Load balancing
#   - Path-based and host-based routing
#
# Access Traefik dashboard (if enabled):
#   kubectl port-forward -n kube-system svc/traefik 9000:9000
#   Open: http://localhost:9000/dashboard/
#
# Create an Ingress resource:
#   apiVersion: networking.k8s.io/v1
#   kind: Ingress
#   metadata:
#     name: example
#   spec:
#     ingressClassName: traefik
#     rules:
#       - host: example.com
#         http:
#           paths:
#             - path: /
#               pathType: Prefix
#               backend:
#                 service:
#                   name: example-service
#                   port:
#                     number: 80
#
# TLS with cert-manager:
#   Add annotations:
#     cert-manager.io/cluster-issuer: "letsencrypt-prod"
#   Add tls section:
#     tls:
#       - hosts:
#           - example.com
#         secretName: example-tls
#
# =============================================================================
</file>

<file path="k8s/helm-values/velero-values.yaml">
# Velero Configuration for Kubernetes Backup and Restore
# Integrates with MinIO (S3-compatible) for backup storage

# Image configuration
image:
  repository: velero/velero
  tag: v1.15.0  # Latest stable
  pullPolicy: IfNotPresent

# Init containers
initContainers:
  - name: velero-plugin-for-aws
    image: velero/velero-plugin-for-aws:v1.11.0
    volumeMounts:
      - mountPath: /target
        name: plugins

# Resource configuration
resources:
  requests:
    cpu: 500m
    memory: 512Mi
  limits:
    cpu: 1000m
    memory: 1Gi

# Backup configuration
configuration:
  # Environment variables to force credentials from file (not EC2 IMDS)
  extraEnvVars:
    - name: AWS_SHARED_CREDENTIALS_FILE
      value: /credentials/cloud

  # Backup storage location (MinIO S3-compatible)
  backupStorageLocation:
    - name: default
      provider: aws
      bucket: velero
      default: true
      credential:
        name: velero-credentials
        key: cloud
      config:
        region: minio  # Dummy region for MinIO
        s3ForcePathStyle: "true"  # Required for MinIO
        s3Url: http://minio.backup-system.svc.cluster.local:9000
        publicUrl: http://minio.backup-system.svc.cluster.local:9000

  # Volume snapshot location - DISABLED (not needed for MinIO filesystem backups)
  # We use kopia for filesystem backups, not cloud provider volume snapshots
  volumeSnapshotLocation: []  # Explicitly disable to prevent null values

  # Default backup retention
  defaultBackupTTL: 720h  # 30 days

  # Upload and download concurrency
  uploaderType: kopia  # Kopia is the new default uploader (restic was removed in v11.x)
  defaultVolumesToFsBackup: true  # Backup PV contents by default

# Credentials for MinIO (using External Secrets from Doppler)
credentials:
  useSecret: false  # Use existingSecret instead
  existingSecret: velero-credentials  # Created by ExternalSecret from Doppler

# Schedules (automated backups)
schedules:
  # Daily full cluster backup
  daily-backup:
    disabled: false
    schedule: "0 2 * * *"  # 2 AM daily
    useOwnerReferencesInBackup: false
    template:
      ttl: 720h  # 30 days retention
      includedNamespaces:
        - "*"
      excludedNamespaces:
        - kube-system
        - kube-public
        - kube-node-lease
      includedResources:
        - "*"
      storageLocation: default

  # Weekly cluster state backup (metadata only)
  weekly-metadata:
    disabled: false
    schedule: "0 3 * * 0"  # 3 AM every Sunday
    useOwnerReferencesInBackup: false
    template:
      ttl: 2160h  # 90 days retention
      includedNamespaces:
        - "*"
      snapshotVolumes: false  # Metadata only, no volumes
      storageLocation: default

# Metrics for Prometheus
metrics:
  enabled: true
  serviceMonitor:
    enabled: true
    additionalLabels:
      release: kube-prometheus-stack

# Security context
podSecurityContext:
  runAsNonRoot: true
  runAsUser: 1000
  fsGroup: 1000

containerSecurityContext:
  allowPrivilegeEscalation: false
  readOnlyRootFilesystem: false  # Allow temporary file writes
  runAsNonRoot: true
  capabilities:
    drop:
      - ALL

# Service account
serviceAccount:
  server:
    create: true
    name: velero

# RBAC
rbac:
  create: true
  clusterAdministrator: true  # Required for cluster-wide backups

# Node-agent (formerly Restic) for filesystem backups
deployNodeAgent: true

nodeAgent:
  podVolumePath: /var/lib/kubelet/pods
  privileged: false
  resources:
    requests:
      cpu: 500m
      memory: 512Mi
    limits:
      cpu: 1000m
      memory: 1Gi

  # Security context for node agent
  podSecurityContext:
    runAsUser: 0  # Root required for volume access
  containerSecurityContext:
    privileged: false  # Don't use privileged mode
    readOnlyRootFilesystem: false  # Allow writes for Kopia cache

  # Additional volumes for node-agent
  # Use emptyDir for temporary cache (clears on pod restart)
  # Kopia/UDM repo is in MinIO, this is just for local cache
  extraVolumes:
    - name: udmrepo-cache
      emptyDir: {}

  extraVolumeMounts:
    - name: udmrepo-cache
      mountPath: /udmrepo

# Cleanup CRDs on uninstall
cleanUpCRDs: false  # Keep CRDs for safety

# =============================================================================
# Post-Installation Configuration
# =============================================================================
#
# 1. Verify Velero installation:
#    velero version
#    velero backup-location get
#
# 2. Create a test backup:
#    velero backup create test-backup --wait
#
# 3. Check backup status:
#    velero backup describe test-backup
#    velero backup logs test-backup
#
# 4. List all backups:
#    velero backup get
#
# 5. Restore from backup:
#    velero restore create --from-backup test-backup
#
# 6. Create namespace-specific backup:
#    velero backup create sveltehr-prod-backup \
#      --include-namespaces sveltehr-prod \
#      --wait
#
# 7. Disaster Recovery:
#    # Install Velero on new cluster (same configuration)
#    # Restore all resources:
#    velero restore create --from-backup daily-backup-20250101020000
#
# 8. Security Notes:
#    - Update MinIO credentials via External Secrets
#    - Encrypt backups at rest (MinIO server-side encryption)
#    - Limit RBAC permissions in production
#    - Test restore procedures regularly
#    - Monitor backup sizes and retention policies
#
# 9. Monitoring:
#    - Prometheus metrics: velero_backup_*
#    - Alert on failed backups
#    - Grafana dashboard: Import ID 11055
#
# =============================================================================
</file>

<file path="k8s/manifests/argocd/image-updater-rbac.yaml">
---
# RBAC Configuration for ArgoCD Image Updater
# Enables Image Updater to:
# 1. Read ArgoCD Applications
# 2. Access registry credentials across namespaces
# 3. Write back to Git repository
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: argocd-image-updater
  namespace: argocd
  labels:
    app.kubernetes.io/name: argocd-image-updater
    app.kubernetes.io/component: image-updater
---
# Role in argocd namespace for reading Applications and Secrets
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: argocd-image-updater
  namespace: argocd
  labels:
    app.kubernetes.io/name: argocd-image-updater
    app.kubernetes.io/component: image-updater
rules:
  # Read Applications to discover image update annotations
  - apiGroups: ["argoproj.io"]
    resources: ["applications"]
    verbs: ["get", "list", "watch"]

  # Read Secrets for registry credentials and Git auth
  - apiGroups: [""]
    resources: ["secrets"]
    verbs: ["get", "list"]

  # Read ConfigMaps for configuration
  - apiGroups: [""]
    resources: ["configmaps"]
    verbs: ["get", "list"]

  # Write Events for status updates
  - apiGroups: [""]
    resources: ["events"]
    verbs: ["create", "patch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: argocd-image-updater
  namespace: argocd
  labels:
    app.kubernetes.io/name: argocd-image-updater
    app.kubernetes.io/component: image-updater
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: argocd-image-updater
subjects:
  - kind: ServiceAccount
    name: argocd-image-updater
    namespace: argocd
---
# Cross-namespace Role for accessing GHCR pull secret in sveltehr-prod
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: argocd-image-updater-registry-access
  namespace: sveltehr-prod
  labels:
    app.kubernetes.io/name: argocd-image-updater
    app.kubernetes.io/component: image-updater
rules:
  # Read GHCR pull secret for registry authentication
  - apiGroups: [""]
    resources: ["secrets"]
    resourceNames: ["ghcr-pull-secret"]
    verbs: ["get"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: argocd-image-updater-registry-access
  namespace: sveltehr-prod
  labels:
    app.kubernetes.io/name: argocd-image-updater
    app.kubernetes.io/component: image-updater
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: argocd-image-updater-registry-access
subjects:
  - kind: ServiceAccount
    name: argocd-image-updater
    namespace: argocd
---
# ClusterRole for reading Applications across all namespaces (if needed)
# Currently scoped to argocd namespace only
# Uncomment if Image Updater needs to manage applications in multiple namespaces
#
# apiVersion: rbac.authorization.k8s.io/v1
# kind: ClusterRole
# metadata:
#   name: argocd-image-updater
#   labels:
#     app.kubernetes.io/name: argocd-image-updater
#     app.kubernetes.io/component: image-updater
# rules:
#   - apiGroups: ["argoproj.io"]
#     resources: ["applications"]
#     verbs: ["get", "list", "watch"]
# ---
# apiVersion: rbac.authorization.k8s.io/v1
# kind: ClusterRoleBinding
# metadata:
#   name: argocd-image-updater
#   labels:
#     app.kubernetes.io/name: argocd-image-updater
#     app.kubernetes.io/component: image-updater
# roleRef:
#   apiGroup: rbac.authorization.k8s.io
#   kind: ClusterRole
#   name: argocd-image-updater
# subjects:
#   - kind: ServiceAccount
#     name: argocd-image-updater
#     namespace: argocd

# =============================================================================
# RBAC Configuration Notes
# =============================================================================
#
# Permissions Granted:
#   1. Read ArgoCD Applications (to detect image update annotations)
#   2. Read Secrets in argocd namespace (for Git credentials)
#   3. Read GHCR pull secret in sveltehr-prod namespace (for registry auth)
#   4. Create Events (for status reporting)
#
# Security Considerations:
#   - Minimal permissions following principle of least privilege
#   - Namespace-scoped roles (not ClusterRole) for better isolation
#   - Specific secret name restriction for registry access
#   - No write permissions to Applications (read-only)
#
# Deployment:
#   kubectl apply -f k8s/manifests/argocd/image-updater-rbac.yaml
#
# Verification:
#   kubectl auth can-i get applications --as=system:serviceaccount:argocd:argocd-image-updater -n argocd
#   kubectl auth can-i get secrets --as=system:serviceaccount:argocd:argocd-image-updater -n sveltehr-prod
#
