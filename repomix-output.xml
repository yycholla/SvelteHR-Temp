```typescript
// Accessible component patterns
<script lang="ts">
  interface Props {
    label: string;
    required?: boolean;
    error?: string;
    describedBy?: string;
  }

  let { label, required = false, error, describedBy }: Props = $props();
  let inputId = crypto.randomUUID();
  let errorId = error ? `${inputId}-error` : undefined;
</script>

<div class="form-field">
  <label
    for={inputId}
    class="form-label"
    class:required
  >
    {label}
    {#if required}
      <span aria-label="required" class="text-red-500">*</span>
    {/if}
  </label>

  <input
    id={inputId}
    aria-invalid={error ? 'true' : 'false'}
    aria-describedby={[describedBy, errorId].filter(Boolean).join(' ') || undefined}
    class="form-input"
    class:error
    {...$$restProps}
  />

  {#if error}
    <div id={errorId} class="error-message" role="alert" aria-live="polite">
      {error}
    </div>
  {/if}
</div>
