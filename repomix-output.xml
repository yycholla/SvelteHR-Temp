			aspectRatio: '4:3' as any, // Cast to any to allow testing invalid values
			onImageSelected: vi.fn(),
			onImageRemoved: vi.fn()
		};
		expect(invalidProps.aspectRatio).toBe('4:3'); // Should still hold the value for runtime checks
