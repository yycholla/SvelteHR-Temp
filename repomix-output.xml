<file path="k8s/helm-charts/sveltehr/templates/_helpers.tpl">
{{/*
Expand the name of the chart.
*/}}
{{- define "sveltehr.name" -}}
{{- default .Chart.Name .Values.nameOverride | trunc 63 | trimSuffix "-" }}
{{- end }}

{{/*
Create a default fully qualified app name.
We truncate at 63 chars because some Kubernetes name fields are limited to this (by the DNS naming spec).
If release name contains chart name it will be used as a full name.
*/}}
{{- define "sveltehr.fullname" -}}
{{- if .Values.fullnameOverride }}
{{- .Values.fullnameOverride | trunc 63 | trimSuffix "-" }}
{{- else }}
{{- $name := default .Chart.Name .Values.nameOverride }}
{{- if contains $name .Release.Name }}
{{- .Release.Name | trunc 63 | trimSuffix "-" }}
{{- else }}
{{- printf "%s-%s" .Release.Name $name | trunc 63 | trimSuffix "-" }}
{{- end }}
{{- end }}
{{- end }}

{{/*
Create chart name and version as used by the chart label.
*/}}
{{- define "sveltehr.chart" -}}
{{- printf "%s-%s" .Chart.Name .Chart.Version | replace "+" "_" | trunc 63 | trimSuffix "-" }}
{{- end }}

{{/*
Common labels
*/}}
{{- define "sveltehr.labels" -}}
helm.sh/chart: {{ include "sveltehr.chart" . }}
{{ include "sveltehr.selectorLabels" . }}
{{- if .Chart.AppVersion }}
app.kubernetes.io/version: {{ .Chart.AppVersion | quote }}
{{- end }}
app.kubernetes.io/managed-by: {{ .Release.Service }}
{{- end }}

{{/*
Selector labels
*/}}
{{- define "sveltehr.selectorLabels" -}}
app.kubernetes.io/name: {{ include "sveltehr.name" . }}
app.kubernetes.io/instance: {{ .Release.Name }}
{{- end }}

{{/*
Create the name of the service account to use
*/}}
{{- define "sveltehr.serviceAccountName" -}}
{{- if .Values.serviceAccount.create }}
{{- default (include "sveltehr.fullname" .) .Values.serviceAccount.name }}
{{- else }}
{{- default "default" .Values.serviceAccount.name }}
{{- end }}
{{- end }}

{{/*
PostgreSQL connection string
*/}}
{{- define "sveltehr.postgresqlConnectionString" -}}
{{- $host := .Values.postgresql.service.name | default (printf "%s-postgres-rw" (include "sveltehr.fullname" .)) }}
{{- $port := .Values.postgresql.service.port | default "5432" }}
{{- $database := .Values.postgresql.database }}
{{- $username := .Values.postgresql.username }}
{{- printf "postgresql://%s:${DB_PASSWORD}@%s:%s/%s" $username $host $port $database }}
{{- end }}

{{/*
Redis connection URL
*/}}
{{- define "sveltehr.redisUrl" -}}
{{- if .Values.redis.url }}
{{- .Values.redis.url }}
{{- else if eq .Values.redis.architecture "standalone" }}
{{- $host := printf "%s-redis-master" (include "sveltehr.fullname" .) }}
{{- printf "redis://%s:6379" $host }}
{{- else }}
{{- $host := printf "%s-redis" (include "sveltehr.fullname" .) }}
{{- printf "redis://%s:6379" $host }}
{{- end }}
{{- end }}

{{/*
Backend service URL
*/}}
{{- define "sveltehr.backendUrl" -}}
{{- $name := include "sveltehr.fullname" . }}
{{- $port := .Values.backend.service.port | default 4000 }}
{{- printf "http://%s-backend:%d" $name $port }}
{{- end }}

{{/*
Frontend service URL
*/}}
{{- define "sveltehr.frontendUrl" -}}
{{- $name := include "sveltehr.fullname" . }}
{{- $port := .Values.frontend.service.port | default 5173 }}
{{- printf "http://%s-frontend:%d" $name $port }}
{{- end }}

{{/*
Container security context
*/}}
{{- define "sveltehr.containerSecurityContext" -}}
allowPrivilegeEscalation: false
runAsNonRoot: true
runAsUser: 1001
capabilities:
  drop:
    - ALL
{{- end }}

{{/*
Pod security context
*/}}
{{- define "sveltehr.podSecurityContext" -}}
fsGroup: 1001
{{- end }}

{{/*
Standard resource limits
*/}}
{{- define "sveltehr.resources" -}}
{{- if . }}
{{- toYaml . }}
{{- else }}
requests:
  memory: 128Mi
  cpu: 100m
limits:
  memory: 256Mi
  cpu: 200m
{{- end }}
{{- end }}

{{/*
Database wait init container
*/}}
{{- define "sveltehr.waitForPostgresql" -}}
- name: wait-for-postgres
  image: postgres:15-alpine
  command:
    - sh
    - -c
    - |
      echo "Waiting for PostgreSQL to be ready..."
      until pg_isready -h {{ .Values.postgresql.service.name | default (printf "%s-postgres-rw" (include "sveltehr.fullname" .)) }} -p {{ .Values.postgresql.service.port | default "5432" }} -U {{ .Values.postgresql.username }}; do
        echo "  PostgreSQL is unavailable - sleeping 2s"
        sleep 2
      done
      echo "PostgreSQL is ready!"
  env:
    - name: PGPASSWORD
      valueFrom:
        secretKeyRef:
          name: {{ include "sveltehr.fullname" . }}-postgres-app-secret
          key: password
{{- end }}

{{/*
Backend wait init container
*/}}
{{- define "sveltehr.waitForBackend" -}}
- name: wait-for-backend
  image: curlimages/curl:latest
  command:
    - sh
    - -c
    - |
      echo "Waiting for backend API to be ready..."
      until curl -sf {{ include "sveltehr.backendUrl" . }}/health; do
        echo "  Backend API is unavailable - sleeping 2s"
        sleep 2
      done
      echo "Backend API is ready!"
{{- end }}

{{/*
Image pull policy helper
*/}}
{{- define "sveltehr.imagePullPolicy" -}}
{{- if eq .Values.global.environment "development" }}
Always
{{- else }}
IfNotPresent
{{- end }}
{{- end }}

{{/*
Environment name helper
*/}}
{{- define "sveltehr.environmentName" -}}
{{- .Values.global.environment | default "development" }}
{{- end }}

{{/*
Is production environment
*/}}
{{- define "sveltehr.isProduction" -}}
{{- eq (include "sveltehr.environmentName" .) "production" }}
{{- end }}

{{/*
Common environment variables
*/}}
{{- define "sveltehr.commonEnv" -}}
- name: ENVIRONMENT
  value: {{ include "sveltehr.environmentName" . }}
- name: LOG_LEVEL
  value: {{ .Values.global.environment | eq "production" | ternary "info" "debug" }}
- name: TZ
  value: "UTC"
{{- end }}

{{/*
Monitoring labels
*/}}
{{- define "sveltehr.monitoringLabels" -}}
{{- if .Values.monitoring.enabled }}
prometheus.io/scrape: "true"
prometheus.io/port: "{{ .port }}"
prometheus.io/path: "/metrics"
{{- end }}
{{- end }}

{{/*
Anti-affinity rules for HA
*/}}
{{- define "sveltehr.podAntiAffinity" -}}
{{- if and (eq (include "sveltehr.isProduction" .) "true") (gt (.replicaCount | int) 1) }}
podAntiAffinity:
  preferredDuringSchedulingIgnoredDuringExecution:
    - weight: 100
      podAffinityTerm:
        labelSelector:
          matchExpressions:
            - key: app.kubernetes.io/component
              operator: In
              values:
                - {{ .component }}
        topologyKey: kubernetes.io/hostname
{{- end }}
{{- end }}

{{/*
Rolling update strategy
*/}}
{{- define "sveltehr.rollingUpdateStrategy" -}}
type: RollingUpdate
rollingUpdate:
  maxSurge: 1
  {{- if eq (include "sveltehr.isProduction" .) "true" }}
  maxUnavailable: 0
  {{- else }}
  maxUnavailable: 1
  {{- end }}
{{- end }}

{{/*
Standard probe configuration
*/}}
{{- define "sveltehr.standardProbe" -}}
{{- $probe := . -}}
httpGet:
  path: {{ $probe.path | default "/" }}
  port: {{ $probe.port }}
initialDelaySeconds: {{ $probe.initialDelaySeconds | default 30 }}
periodSeconds: {{ $probe.periodSeconds | default 10 }}
timeoutSeconds: {{ $probe.timeoutSeconds | default 5 }}
failureThreshold: {{ $probe.failureThreshold | default 3 }}
{{- end }}
</file>

<file path="k8s/helm-charts/sveltehr/templates/backend-deployment.yaml">
{{- if and .Values.backend .Values.backend.enabled -}}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ include "sveltehr.fullname" . }}-backend
  namespace: {{ .Values.global.namespace }}
  labels:
    {{- include "sveltehr.labels" . | nindent 4 }}
    app.kubernetes.io/component: backend
  annotations:
    # Container optimization annotations
    build.method: "multi-stage Docker build with cargo-chef"
    build.target: "server"
    buildkit.enabled: "true"
    cache.cargo-registry: "BuildKit cache mount"
    cache.cargo-git: "BuildKit cache mount"
    cache.target: "BuildKit cache mount"
    {{- with .Values.backend.annotations }}
    {{- toYaml . | nindent 4 }}
    {{- end }}
spec:
  replicas: {{ .Values.backend.replicaCount }}
  {{- with .Values.backend.strategy }}
  strategy:
    {{- toYaml . | nindent 4 }}
  {{- end }}
  selector:
    matchLabels:
      {{- include "sveltehr.selectorLabels" . | nindent 6 }}
      app.kubernetes.io/component: backend
  template:
    metadata:
      labels:
        {{- include "sveltehr.selectorLabels" . | nindent 8 }}
        app.kubernetes.io/component: backend
        {{- with .Values.backend.podLabels }}
        {{- toYaml . | nindent 8 }}
        {{- end }}
      {{- with .Values.backend.podAnnotations }}
      annotations:
        {{- toYaml . | nindent 8 }}
      {{- end }}
    spec:
      {{- if .Values.serviceAccount.create }}
      serviceAccountName: {{ include "sveltehr.serviceAccountName" . }}-backend
      {{- end }}

      {{- with .Values.backend.imagePullSecrets }}
      imagePullSecrets:
        {{- toYaml . | nindent 8 }}
      {{- end }}

      # Init container: Wait for PostgreSQL (CloudNativePG service)
      initContainers:
        - name: wait-for-postgres
          image: postgres:16-alpine
          command:
            - sh
            - -c
            - |
              echo "Waiting for PostgreSQL cluster to be ready..."
              until pg_isready -h $(DB_HOST) -p $(DB_PORT) -U $(DB_USER); do
                echo "  PostgreSQL is unavailable - sleeping 2s"
                sleep 2
              done
              echo "PostgreSQL is ready!"
          env:
            - name: DB_HOST
              value: {{ .Values.postgresql.service.name | default (printf "%s-postgres-rw" (include "sveltehr.fullname" .)) }}
            - name: DB_PORT
              value: {{ .Values.postgresql.service.port | default "5432" | quote }}
            - name: DB_USER
              value: {{ .Values.postgresql.username }}
            - name: PGPASSWORD
              valueFrom:
                secretKeyRef:
                  {{- if .Values.externalSecrets.enabled }}
                  # Use Doppler password in production
                  name: {{ include "sveltehr.fullname" . }}-secrets
                  key: password
                  {{- else }}
                  # Use Helm-generated password in dev
                  name: {{ include "sveltehr.fullname" . }}-postgres-app-secret
                  key: password
                  {{- end }}

      containers:
        - name: graphql-server
          # Server image from multi-target build
          image: "{{ .Values.backend.image.repository }}:{{ .Values.backend.image.tag | default .Chart.AppVersion }}"
          imagePullPolicy: {{ .Values.backend.image.pullPolicy }}
          ports:
            - containerPort: {{ .Values.backend.service.targetPort }}
              name: http
              protocol: TCP

          # Run migrations on startup, then start server
          command: ["/bin/sh", "-c"]
          args:
            - |
              echo "================================================================"
              echo "  SvelteHR GraphQL Server"
              echo "================================================================"
              echo "Environment: ${ENVIRONMENT}"
              echo "Host: ${HOST}"
              echo "Port: ${PORT}"
              echo "Database: ${DB_NAME}@${DB_HOST}:${DB_PORT}"
              echo "Redis: ${REDIS_URL}"
              echo "================================================================"
              echo ""

              # Construct DATABASE_URL from components
              export DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

              # Run migrations
              echo "Running database migrations..."
              if [ -f "./hr-migration" ]; then
                ./hr-migration
                echo "✓ Migrations completed successfully"
              else
                echo "⚠ Migration binary not found, skipping migrations"
              fi
              echo ""

              # Skip seed in production
              {{- if ne .Values.global.environment "production" }}
              # Run seed data (dev/staging only)
              echo "Running seed data..."
              if [ -f "./hr-seed" ]; then
                ./hr-seed
                echo "✓ Seed data completed successfully"
              else
                echo "⚠ Seed binary not found, skipping seed"
              fi
              echo ""
              {{- else }}
              echo "⚠ Skipping seed data in production environment"
              echo ""
              {{- end }}

              # Start server
              echo "Starting GraphQL server..."
              exec ./hr-graphql-server

          env:
            # PostgreSQL connection (CloudNativePG service)
            - name: DB_HOST
              value: {{ .Values.postgresql.service.name | default (printf "%s-postgres-rw" (include "sveltehr.fullname" .)) }}
            - name: DB_PORT
              value: {{ .Values.postgresql.service.port | default "5432" | quote }}
            - name: DB_NAME
              value: {{ .Values.postgresql.database }}
            - name: DB_USER
              value: {{ .Values.postgresql.username }}
            - name: DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  {{- if .Values.externalSecrets.enabled }}
                  # Use Doppler password in production
                  name: {{ include "sveltehr.fullname" . }}-secrets
                  key: password
                  {{- else }}
                  # Use Helm-generated password in dev
                  name: {{ include "sveltehr.fullname" . }}-postgres-app-secret
                  key: password
                  {{- end }}

            # Redis connection (Bitnami Redis service)
            - name: REDIS_URL
              value: {{ .Values.redis.url | default (printf "redis://%s-redis-master:6379" (include "sveltehr.fullname" .)) }}

            # JWT and auth secrets
            - name: JWT_SECRET
              valueFrom:
                secretKeyRef:
                  name: {{ include "sveltehr.fullname" . }}-secrets
                  key: jwt-secret
            - name: JWT_REFRESH_SECRET
              valueFrom:
                secretKeyRef:
                  name: {{ include "sveltehr.fullname" . }}-secrets
                  key: jwt-refresh-secret
            - name: SERVICE_AUTH_KEY
              valueFrom:
                secretKeyRef:
                  name: {{ include "sveltehr.fullname" . }}-secrets
                  key: service-auth-key

            # Server configuration
            - name: HOST
              value: {{ .Values.backend.host | default "0.0.0.0" | quote }}
            - name: PORT
              value: {{ .Values.backend.service.targetPort | quote }}
            - name: RUST_LOG
              value: {{ .Values.backend.rustLog | default "info,hr_graphql_server=debug" }}
            - name: ENVIRONMENT
              value: {{ .Values.global.environment }}

            {{- with .Values.backend.extraEnv }}
            {{- toYaml . | nindent 12 }}
            {{- end }}

          {{- if .Values.backend.envFrom }}
          envFrom:
            {{- toYaml .Values.backend.envFrom | nindent 12 }}
          {{- end }}

          resources:
            {{- toYaml .Values.backend.resources | nindent 12 }}

          livenessProbe:
            httpGet:
              path: {{ .Values.backend.livenessProbe.path | default "/health" }}
              port: {{ .Values.backend.service.targetPort }}
            initialDelaySeconds: {{ .Values.backend.livenessProbe.initialDelaySeconds | default 30 }}
            periodSeconds: {{ .Values.backend.livenessProbe.periodSeconds | default 10 }}
            timeoutSeconds: {{ .Values.backend.livenessProbe.timeoutSeconds | default 5 }}
            failureThreshold: {{ .Values.backend.livenessProbe.failureThreshold | default 3 }}

          readinessProbe:
            httpGet:
              path: {{ .Values.backend.readinessProbe.path | default "/health" }}
              port: {{ .Values.backend.service.targetPort }}
            initialDelaySeconds: {{ .Values.backend.readinessProbe.initialDelaySeconds | default 5 }}
            periodSeconds: {{ .Values.backend.readinessProbe.periodSeconds | default 5 }}
            timeoutSeconds: {{ .Values.backend.readinessProbe.timeoutSeconds | default 3 }}
            failureThreshold: {{ .Values.backend.readinessProbe.failureThreshold | default 3 }}

          {{- with .Values.backend.startupProbe }}
          startupProbe:
            {{- toYaml . | nindent 12 }}
          {{- end }}

          securityContext:
            allowPrivilegeEscalation: false
            runAsNonRoot: true
            runAsUser: {{ .Values.backend.securityContext.runAsUser | default 1001 }}
            capabilities:
              drop:
                - ALL
            {{- with .Values.backend.securityContext }}
            {{- toYaml . | nindent 12 }}
            {{- end }}

          volumeMounts:
            - name: tmp
              mountPath: /tmp
            {{- with .Values.backend.volumeMounts }}
            {{- toYaml . | nindent 12 }}
            {{- end }}

      volumes:
        - name: tmp
          emptyDir: {}
        {{- with .Values.backend.volumes }}
        {{- toYaml . | nindent 8 }}
        {{- end }}

      {{- with .Values.backend.nodeSelector }}
      nodeSelector:
        {{- toYaml . | nindent 8 }}
      {{- end }}

      {{- with .Values.backend.affinity }}
      affinity:
        {{- toYaml . | nindent 8 }}
      {{- end }}

      {{- with .Values.backend.tolerations }}
      tolerations:
        {{- toYaml . | nindent 8 }}
      {{- end }}

      securityContext:
        fsGroup: {{ .Values.backend.podSecurityContext.fsGroup | default 1001 }}
        {{- with .Values.backend.podSecurityContext }}
        {{- toYaml . | nindent 8 }}
        {{- end }}

{{- end }}
</file>

<file path="k8s/helm-charts/sveltehr/templates/configmap.yaml">
apiVersion: v1
kind: ConfigMap
metadata:
  name: sveltehr-config
  namespace: {{ .Values.global.namespace }}
data:
  POSTGRES_DB: {{ .Values.config.POSTGRES_DB | quote }}
  POSTGRES_USER: {{ .Values.config.POSTGRES_USER | quote }}
  NODE_ENV: {{ .Values.config.NODE_ENV | quote }}
  LOG_LEVEL: {{ .Values.config.LOG_LEVEL | quote }}
</file>

<file path="k8s/helm-charts/sveltehr/templates/external-secrets.yaml">
{{- if .Values.externalSecrets.enabled }}
---
# Doppler Service Token Secret (only hardcoded secret needed)
apiVersion: v1
kind: Secret
metadata:
  name: doppler-token-secret
  namespace: {{ .Values.global.namespace }}
type: Opaque
stringData:
  dopplerToken: {{ .Values.externalSecrets.doppler.serviceToken | required "externalSecrets.doppler.serviceToken is required when externalSecrets.enabled=true" | quote }}

---
# SecretStore that connects to Doppler
apiVersion: external-secrets.io/v1
kind: SecretStore
metadata:
  name: doppler-secret-store
  namespace: {{ .Values.global.namespace }}
spec:
  provider:
    doppler:
      auth:
        secretRef:
          dopplerToken:
            name: doppler-token-secret
            key: dopplerToken
      project: {{ .Values.externalSecrets.doppler.project | required "externalSecrets.doppler.project is required" | quote }}
      config: {{ .Values.externalSecrets.doppler.config | required "externalSecrets.doppler.config is required" | quote }}

---
# ExternalSecret that pulls secrets from Doppler
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: sveltehr-external-secrets
  namespace: {{ .Values.global.namespace }}
spec:
  refreshInterval: {{ .Values.externalSecrets.refreshInterval }}
  secretStoreRef:
    name: doppler-secret-store
    kind: SecretStore
  target:
    name: {{ include "sveltehr.fullname" . }}-secrets
    creationPolicy: Owner
  data:
    # Remap Doppler keys to match deployment expectations
    - secretKey: username
      remoteRef:
        key: POSTGRES_USER
    - secretKey: password
      remoteRef:
        key: POSTGRES_PASSWORD
    - secretKey: postgres-password
      remoteRef:
        key: POSTGRES_PASSWORD
    - secretKey: jwt-secret
      remoteRef:
        key: JWT_SECRET
    - secretKey: jwt-refresh-secret
      remoteRef:
        key: JWT_REFRESH_SECRET
    - secretKey: service-auth-key
      remoteRef:
        key: SERVICE_AUTH_KEY

---
{{- if and .Values.pgadmin .Values.pgadmin.enabled }}
# ExternalSecret for pgAdmin password
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: pgadmin-external-secret
  namespace: {{ .Values.global.namespace }}
spec:
  refreshInterval: {{ .Values.externalSecrets.refreshInterval }}
  secretStoreRef:
    name: doppler-secret-store
    kind: SecretStore
  target:
    name: pgadmin-secret
    creationPolicy: Owner
  data:
    - secretKey: pgadmin-password
      remoteRef:
        key: PGADMIN_PASSWORD
{{- end }}
{{- end }}
</file>

<file path="k8s/helm-charts/sveltehr/templates/frontend-deployment.yaml">
{{- if and .Values.frontend .Values.frontend.enabled -}}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ include "sveltehr.fullname" . }}-frontend
  namespace: {{ .Values.global.namespace }}
  labels:
    {{- include "sveltehr.labels" . | nindent 4 }}
    app.kubernetes.io/component: frontend
  annotations:
    # Container optimization annotations
    build.method: "multi-stage Docker build with separate dependency layers"
    build.target: {{ .Values.global.environment | eq "development" | ternary "development" "runtime" }}
    buildkit.enabled: "true"
    cache.npm: "BuildKit cache mount"
    cache.vite: "BuildKit cache mount"
    optimization.vite: "7.0.4"
    optimization.deps: "Separate production/dev dependency layers"
    {{- with .Values.frontend.annotations }}
    {{- toYaml . | nindent 4 }}
    {{- end }}
spec:
  replicas: {{ .Values.frontend.replicaCount }}
  {{- with .Values.frontend.strategy }}
  strategy:
    {{- toYaml . | nindent 4 }}
  {{- end }}
  selector:
    matchLabels:
      {{- include "sveltehr.selectorLabels" . | nindent 6 }}
      app.kubernetes.io/component: frontend
  template:
    metadata:
      labels:
        {{- include "sveltehr.selectorLabels" . | nindent 8 }}
        app.kubernetes.io/component: frontend
        {{- with .Values.frontend.podLabels }}
        {{- toYaml . | nindent 8 }}
        {{- end }}
      {{- with .Values.frontend.podAnnotations }}
      annotations:
        {{- toYaml . | nindent 8 }}
      {{- end }}
    spec:
      {{- if .Values.serviceAccount.create }}
      serviceAccountName: {{ include "sveltehr.serviceAccountName" . }}-frontend
      {{- end }}

      {{- with .Values.frontend.imagePullSecrets }}
      imagePullSecrets:
        {{- toYaml . | nindent 8 }}
      {{- end }}

      # Init container: Wait for backend API
      {{- if .Values.frontend.waitForBackend }}
      initContainers:
        - name: wait-for-backend
          image: curlimages/curl:latest
          command:
            - sh
            - -c
            - |
              echo "Waiting for backend API to be ready..."
              until curl -sf {{ .Values.frontend.backendUrl | default (printf "http://%s-backend:%d" (include "sveltehr.fullname" .) (.Values.backend.service.port | int)) }}/health; do
                echo "  Backend API is unavailable - sleeping 2s"
                sleep 2
              done
              echo "Backend API is ready!"
      {{- end }}

      containers:
        - name: sveltekit-app
          # Frontend image (dev: port 5173, prod: port 3000)
          image: "{{ .Values.frontend.image.repository }}:{{ .Values.frontend.image.tag | default .Chart.AppVersion }}"
          imagePullPolicy: {{ .Values.frontend.image.pullPolicy }}
          ports:
            - containerPort: {{ .Values.frontend.service.targetPort }}
              name: http
              protocol: TCP

          env:
            # Backend API URL
            - name: PUBLIC_API_URL
              value: {{ .Values.frontend.backendUrl | default (printf "http://%s-backend:%d" (include "sveltehr.fullname" .) (.Values.backend.service.port | int)) }}

            # Database connection (for SSR)
            - name: DB_HOST
              value: {{ .Values.postgresql.service.name | default (printf "%s-postgres-rw" (include "sveltehr.fullname" .)) }}
            - name: DB_PORT
              value: {{ .Values.postgresql.service.port | default "5432" | quote }}
            - name: DB_NAME
              value: {{ .Values.postgresql.database }}
            - name: DB_USER
              value: {{ .Values.postgresql.username }}
            - name: DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  {{- if .Values.externalSecrets.enabled }}
                  # Use Doppler password in production
                  name: {{ include "sveltehr.fullname" . }}-secrets
                  key: password
                  {{- else }}
                  # Use Helm-generated password in dev
                  name: {{ include "sveltehr.fullname" . }}-postgres-app-secret
                  key: password
                  {{- end }}

            # Service authentication
            - name: SERVICE_AUTH_KEY
              valueFrom:
                secretKeyRef:
                  name: {{ include "sveltehr.fullname" . }}-secrets
                  key: service-auth-key

            # Node.js configuration
            - name: NODE_ENV
              value: {{ .Values.global.environment | eq "development" | ternary "development" "production" }}
            - name: PORT
              value: {{ .Values.frontend.service.targetPort | quote }}
            - name: HOST
              value: {{ .Values.frontend.host | default "0.0.0.0" | quote }}

            {{- with .Values.frontend.extraEnv }}
            {{- toYaml . | nindent 12 }}
            {{- end }}

          {{- if .Values.frontend.envFrom }}
          envFrom:
            {{- toYaml .Values.frontend.envFrom | nindent 12 }}
          {{- end }}

          resources:
            {{- toYaml .Values.frontend.resources | nindent 12 }}

          {{- with .Values.frontend.livenessProbe }}
          {{- if .path }}
          livenessProbe:
            httpGet:
              path: {{ .path | default "/" }}
              port: {{ $.Values.frontend.service.targetPort }}
            initialDelaySeconds: {{ .initialDelaySeconds | default 30 }}
            periodSeconds: {{ .periodSeconds | default 30 }}
            timeoutSeconds: {{ .timeoutSeconds | default 5 }}
            failureThreshold: {{ .failureThreshold | default 3 }}
          {{- end }}
          {{- end }}

          {{- with .Values.frontend.readinessProbe }}
          {{- if .path }}
          readinessProbe:
            httpGet:
              path: {{ .path | default "/" }}
              port: {{ $.Values.frontend.service.targetPort }}
            initialDelaySeconds: {{ .initialDelaySeconds | default 5 }}
            periodSeconds: {{ .periodSeconds | default 5 }}
            timeoutSeconds: {{ .timeoutSeconds | default 3 }}
            failureThreshold: {{ .failureThreshold | default 3 }}
          {{- end }}
          {{- end }}

          {{- with .Values.frontend.startupProbe }}
          startupProbe:
            {{- toYaml . | nindent 12 }}
          {{- end }}

          securityContext:
            allowPrivilegeEscalation: false
            runAsNonRoot: {{ .Values.frontend.securityContext.runAsNonRoot | default true }}
            runAsUser: {{ .Values.frontend.securityContext.runAsUser | default 1001 }}
            capabilities:
              drop:
                - ALL
            {{- with .Values.frontend.securityContext }}
            {{- toYaml . | nindent 12 }}
            {{- end }}

          volumeMounts:
            # Temporary files
            - name: tmp
              mountPath: /tmp

            # npm cache (BuildKit benefits at runtime)
            - name: npm-cache
              mountPath: /home/svelte/.npm

            # Vite cache (for dev mode hot reload)
            {{- if eq .Values.global.environment "development" }}
            - name: vite-cache
              mountPath: /app/node_modules/.vite
            {{- end }}

            {{- with .Values.frontend.volumeMounts }}
            {{- toYaml . | nindent 12 }}
            {{- end }}

      volumes:
        - name: tmp
          emptyDir: {}
        - name: npm-cache
          emptyDir: {}
        {{- if eq .Values.global.environment "development" }}
        - name: vite-cache
          emptyDir: {}
        {{- end }}
        {{- with .Values.frontend.volumes }}
        {{- toYaml . | nindent 8 }}
        {{- end }}

      {{- with .Values.frontend.nodeSelector }}
      nodeSelector:
        {{- toYaml . | nindent 8 }}
      {{- end }}

      {{- with .Values.frontend.affinity }}
      affinity:
        {{- toYaml . | nindent 8 }}
      {{- end }}

      {{- with .Values.frontend.tolerations }}
      tolerations:
        {{- toYaml . | nindent 8 }}
      {{- end }}

      securityContext:
        fsGroup: {{ .Values.frontend.podSecurityContext.fsGroup | default 1001 }}
        {{- with .Values.frontend.podSecurityContext }}
        {{- toYaml . | nindent 8 }}
        {{- end }}

{{- end }}
</file>

<file path="k8s/helm-charts/sveltehr/templates/ingress.yaml">
{{- if and .Values.ingress .Values.ingress.enabled -}}
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: sveltehr-ingress
  namespace: {{ .Values.global.namespace }}
  annotations:
    # Mark as healthy for ArgoCD (on-prem cluster, no external LoadBalancer)
    argocd.argoproj.io/compare-options: IgnoreExtraneous
    {{- with .Values.ingress.annotations }}
    {{- toYaml . | nindent 4 }}
    {{- end }}
    {{- if .Values.ingress.tls.enabled }}
    traefik.ingress.kubernetes.io/router.middlewares: {{ .Values.global.namespace }}-redirect-https@kubernetescrd
    {{- end }}
spec:
  ingressClassName: {{ .Values.ingress.className }}
  {{- if .Values.ingress.tls.enabled }}
  tls:
    - hosts:
        - {{ .Values.ingress.host }}
      secretName: {{ .Values.ingress.tls.secretName }}
  {{- end }}
  rules:
    - host: {{ .Values.ingress.host }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ .Values.frontend.name }}
                port:
                  number: {{ .Values.frontend.service.port }}

{{- if .Values.ingress.tls.enabled }}
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: redirect-https
  namespace: {{ .Values.global.namespace }}
spec:
  redirectScheme:
    scheme: https
    permanent: true
{{- end }}
{{- end }}
</file>

<file path="k8s/helm-charts/sveltehr/templates/migration-job.yaml">
{{- if and .Values.migration .Values.migration.enabled -}}
---
apiVersion: batch/v1
kind: Job
metadata:
  name: {{ include "sveltehr.fullname" . }}-migration
  namespace: {{ .Values.global.namespace }}
  labels:
    {{- include "sveltehr.labels" . | nindent 4 }}
    app.kubernetes.io/component: migration
  annotations:
    # Helm hooks: Run this job before install/upgrade
    "helm.sh/hook": pre-install,pre-upgrade
    "helm.sh/hook-weight": "0"
    "helm.sh/hook-delete-policy": before-hook-creation,hook-succeeded
    {{- with .Values.migration.annotations }}
    {{- toYaml . | nindent 4 }}
    {{- end }}
spec:
  # Cleanup completed job after specified time
  ttlSecondsAfterFinished: {{ .Values.migration.ttlSecondsAfterFinished }}
  backoffLimit: {{ .Values.migration.backoffLimit }}

  template:
    metadata:
      labels:
        {{- include "sveltehr.selectorLabels" . | nindent 8 }}
        app.kubernetes.io/component: migration
      {{- with .Values.migration.podAnnotations }}
      annotations:
        {{- toYaml . | nindent 8 }}
      {{- end }}
    spec:
      restartPolicy: OnFailure

      # Service account for database access
      {{- if .Values.serviceAccount.create }}
      serviceAccountName: {{ include "sveltehr.serviceAccountName" . }}-backend
      {{- end }}

      # Init container: Wait for PostgreSQL availability
      initContainers:
        - name: wait-for-postgres
          image: postgres:16-alpine
          command:
            - sh
            - -c
            - |
              echo "Waiting for PostgreSQL to be ready..."
              until pg_isready -h $(DB_HOST) -p $(DB_PORT) -U $(DB_USER); do
                echo "  PostgreSQL is unavailable - sleeping 2s"
                sleep 2
              done
              echo "PostgreSQL is ready!"
          env:
            - name: DB_HOST
              value: {{ .Values.postgresql.service.name | default (printf "%s-postgres-rw" (include "sveltehr.fullname" .)) }}
            - name: DB_PORT
              value: {{ .Values.postgresql.service.port | default "5432" | quote }}
            - name: DB_USER
              value: {{ .Values.postgresql.username }}
            - name: PGPASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ include "sveltehr.fullname" . }}-postgres-app-secret
                  key: password

      # Main migration container
      containers:
        - name: migration
          image: "{{ .Values.migration.image.repository }}:{{ .Values.migration.image.tag | default .Chart.AppVersion }}"
          imagePullPolicy: {{ .Values.migration.image.pullPolicy }}

          # Migration command
          command:
            - sh
            - -c
            - |
              echo "================================================================"
              echo "  SvelteHR Database Migration"
              echo "================================================================"
              echo "Database: ${DB_NAME}"
              echo "Host: ${DB_HOST}:${DB_PORT}"
              echo "Environment: ${ENVIRONMENT}"
              echo "================================================================"
              echo ""

              # Run SeaORM migrations
              echo "Running database migrations..."
              /app/migration up

              MIGRATION_EXIT_CODE=$?

              if [ $MIGRATION_EXIT_CODE -eq 0 ]; then
                echo ""
                echo "================================================================"
                echo "  Migration completed successfully!"
                echo "================================================================"
              else
                echo ""
                echo "================================================================"
                echo "  Migration FAILED with exit code: $MIGRATION_EXIT_CODE"
                echo "================================================================"
                exit $MIGRATION_EXIT_CODE
              fi

          env:
            # Database connection components
            - name: DB_HOST
              value: {{ .Values.postgresql.service.name | default (printf "%s-postgres-rw" (include "sveltehr.fullname" .)) }}
            - name: DB_PORT
              value: {{ .Values.postgresql.service.port | default "5432" | quote }}
            - name: DB_NAME
              value: {{ .Values.postgresql.database }}
            - name: DB_USER
              value: {{ .Values.postgresql.username }}
            - name: DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ include "sveltehr.fullname" . }}-postgres-app-secret
                  key: password

            # Construct DATABASE_URL
            - name: DATABASE_URL
              value: "postgres://$(DB_USER):$(DB_PASSWORD)@$(DB_HOST):$(DB_PORT)/$(DB_NAME)"

            # Logging and environment
            - name: RUST_LOG
              value: {{ .Values.migration.rustLog | default "info,migration=debug" }}
            - name: ENVIRONMENT
              value: {{ .Values.global.environment }}

            {{- with .Values.migration.extraEnv }}
            {{- toYaml . | nindent 12 }}
            {{- end }}

          # Resource limits
          resources:
            {{- toYaml .Values.migration.resources | nindent 12 }}

          # Security context
          securityContext:
            allowPrivilegeEscalation: false
            runAsNonRoot: true
            runAsUser: 1001
            capabilities:
              drop:
                - ALL
            {{- with .Values.migration.securityContext }}
            {{- toYaml . | nindent 12 }}
            {{- end }}

      {{- with .Values.migration.nodeSelector }}
      nodeSelector:
        {{- toYaml . | nindent 8 }}
      {{- end }}

      {{- with .Values.migration.tolerations }}
      tolerations:
        {{- toYaml . | nindent 8 }}
      {{- end }}

      {{- with .Values.migration.affinity }}
      affinity:
        {{- toYaml . | nindent 8 }}
      {{- end }}

{{- end }}
</file>

<file path="k8s/helm-charts/sveltehr/templates/pgadmin.yaml">
{{- if and .Values.pgadmin .Values.pgadmin.enabled }}
{{- if not .Values.externalSecrets.enabled }}
---
# pgAdmin password secret (only created if External Secrets is disabled)
apiVersion: v1
kind: Secret
metadata:
  name: pgadmin-secret
  namespace: {{ .Values.global.namespace }}
type: Opaque
stringData:
  pgadmin-password: {{ .Values.pgadmin.password | quote }}
{{- end }}

---
apiVersion: v1
kind: ConfigMap
metadata:
  name: pgadmin-config
  namespace: {{ .Values.global.namespace }}
data:
  servers.json: |
    {
      "Servers": {
        "1": {
          "Name": "SvelteHR PostgreSQL Primary",
          "Group": "Production",
          "Host": "sveltehr-postgres-rw",
          "Port": 5432,
          "MaintenanceDB": "hr_system",
          "Username": "hr_user",
          "SSLMode": "prefer"
        },
        "2": {
          "Name": "SvelteHR PostgreSQL Replica",
          "Group": "Production",
          "Host": "sveltehr-postgres-ro",
          "Port": 5432,
          "MaintenanceDB": "hr_system",
          "Username": "hr_user",
          "SSLMode": "prefer"
        }
      }
    }

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: pgadmin
  namespace: {{ .Values.global.namespace }}
  labels:
    app: pgadmin
spec:
  replicas: 1
  selector:
    matchLabels:
      app: pgadmin
  template:
    metadata:
      labels:
        app: pgadmin
    spec:
      containers:
      - name: pgadmin
        image: "{{ .Values.pgadmin.image.repository }}:{{ .Values.pgadmin.image.tag }}"
        imagePullPolicy: {{ .Values.pgadmin.image.pullPolicy }}
        ports:
        - containerPort: 80
          name: http
        env:
        - name: PGADMIN_DEFAULT_EMAIL
          value: {{ .Values.pgadmin.email | quote }}
        - name: PGADMIN_DEFAULT_PASSWORD
          valueFrom:
            secretKeyRef:
              name: pgadmin-secret
              key: pgadmin-password
        - name: PGADMIN_CONFIG_SERVER_MODE
          value: "True"
        - name: PGADMIN_CONFIG_MASTER_PASSWORD_REQUIRED
          value: "False"
        volumeMounts:
        - name: pgadmin-config
          mountPath: /pgadmin4/servers.json
          subPath: servers.json
          readOnly: true
        resources:
          {{- toYaml .Values.pgadmin.resources | nindent 10 }}
        securityContext:
          allowPrivilegeEscalation: false
          runAsNonRoot: false  # pgAdmin needs root
      volumes:
      - name: pgadmin-config
        configMap:
          name: pgadmin-config

---
apiVersion: v1
kind: Service
metadata:
  name: pgadmin
  namespace: {{ .Values.global.namespace }}
  labels:
    app: pgadmin
  annotations:
    {{- if .Values.pgadmin.tailscale.enabled }}
    tailscale.com/expose: "true"
    tailscale.com/hostname: {{ .Values.pgadmin.tailscale.hostname | quote }}
    {{- end }}
spec:
  selector:
    app: pgadmin
  ports:
  - name: http
    port: 80
    targetPort: 80
  type: ClusterIP
{{- end }}
</file>

<file path="k8s/helm-charts/sveltehr/templates/pod-disruption-budgets.yaml">
{{- if and .Values.podDisruptionBudget .Values.podDisruptionBudget.enabled }}
{{- if and .Values.frontend .Values.frontend.enabled }}
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
