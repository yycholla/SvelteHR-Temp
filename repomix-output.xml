				query: `
					query GetTaskAuditTrail($taskId: UUID!, $limit: Int!) {
						taskAuditEntries(
							condition: { taskId: $taskId }
							first: $limit
							orderBy: CREATED_AT_DESC
						) {
							nodes {
								id
								taskId
								userId
								action
								changes
								createdAt
								userByUserId {
									id
									displayName
									email
								}
