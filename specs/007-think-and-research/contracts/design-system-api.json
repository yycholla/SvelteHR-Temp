{
	"openapi": "3.0.3",
	"info": {
		"title": "Carbon Design System API",
		"description": "API contracts for Carbon Design System implementation in SvelteHR",
		"version": "1.0.0"
	},
	"paths": {
		"/api/design-system/tokens": {
			"get": {
				"summary": "Get design tokens",
				"description": "Retrieve current design tokens configuration",
				"responses": {
					"200": {
						"description": "Design tokens retrieved successfully",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/DesignTokensResponse"
								}
							}
						}
					}
				}
			}
		},
		"/api/design-system/components": {
			"get": {
				"summary": "Get component registry",
				"description": "Retrieve available components and their contracts",
				"responses": {
					"200": {
						"description": "Component registry retrieved successfully",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ComponentRegistryResponse"
								}
							}
						}
					}
				}
			}
		},
		"/api/design-system/accessibility/audit": {
			"post": {
				"summary": "Request accessibility audit",
				"description": "Trigger accessibility audit for specified components or pages",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/AccessibilityAuditRequest"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Audit completed successfully",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/AccessibilityAuditResponse"
								}
							}
						}
					}
				}
			}
		},
		"/api/design-system/performance/metrics": {
			"get": {
				"summary": "Get performance metrics",
				"description": "Retrieve current performance metrics for design system",
				"parameters": [
					{
						"name": "component",
						"in": "query",
						"description": "Specific component to analyze",
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "timeframe",
						"in": "query",
						"description": "Time range for metrics",
						"schema": {
							"type": "string",
							"enum": ["1h", "24h", "7d", "30d"]
						}
					}
				],
				"responses": {
					"200": {
						"description": "Performance metrics retrieved successfully",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/PerformanceMetricsResponse"
								}
							}
						}
					}
				}
			}
		},
		"/api/design-system/theme": {
			"get": {
				"summary": "Get current theme configuration",
				"description": "Retrieve active theme settings",
				"responses": {
					"200": {
						"description": "Theme configuration retrieved successfully",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ThemeConfiguration"
								}
							}
						}
					}
				}
			},
			"put": {
				"summary": "Update theme configuration",
				"description": "Update theme settings and customizations",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/ThemeUpdateRequest"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Theme updated successfully",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ThemeConfiguration"
								}
							}
						}
					}
				}
			}
		}
	},
	"components": {
		"schemas": {
			"DesignToken": {
				"type": "object",
				"required": ["name", "category", "value", "description"],
				"properties": {
					"name": {
						"type": "string",
						"description": "Token identifier following Carbon naming convention"
					},
					"category": {
						"type": "string",
						"enum": ["spacing", "color", "typography", "motion"],
						"description": "Token category type"
					},
					"value": {
						"oneOf": [{ "type": "string" }, { "type": "number" }],
						"description": "Token value in appropriate format"
					},
					"description": {
						"type": "string",
						"description": "Usage description and guidelines"
					},
					"platforms": {
						"type": "array",
						"items": { "type": "string" },
						"description": "Supported platforms"
					}
				}
			},
			"DesignTokensResponse": {
				"type": "object",
				"properties": {
					"tokens": {
						"type": "array",
						"items": { "$ref": "#/components/schemas/DesignToken" }
					},
					"categories": {
						"type": "object",
						"additionalProperties": {
							"type": "array",
							"items": { "$ref": "#/components/schemas/DesignToken" }
						}
					},
					"version": {
						"type": "string",
						"description": "Token set version"
					}
				}
			},
			"ComponentDefinition": {
				"type": "object",
				"required": ["name", "version", "props", "accessibility"],
				"properties": {
					"name": {
						"type": "string",
						"description": "Component name"
					},
					"version": {
						"type": "string",
						"description": "Component version"
					},
					"props": {
						"type": "array",
						"items": { "$ref": "#/components/schemas/ComponentProp" }
					},
					"slots": {
						"type": "array",
						"items": { "$ref": "#/components/schemas/ComponentSlot" }
					},
					"events": {
						"type": "array",
						"items": { "$ref": "#/components/schemas/ComponentEvent" }
					},
					"accessibility": {
						"$ref": "#/components/schemas/AccessibilityFeatures"
					},
					"documentation": {
						"$ref": "#/components/schemas/ComponentDocumentation"
					}
				}
			},
			"ComponentProp": {
				"type": "object",
				"required": ["name", "type", "required", "description"],
				"properties": {
					"name": { "type": "string" },
					"type": { "type": "string" },
					"required": { "type": "boolean" },
					"default": {},
					"description": { "type": "string" },
					"validation": {
						"type": "array",
						"items": { "$ref": "#/components/schemas/ValidationRule" }
					}
				}
			},
			"ComponentSlot": {
				"type": "object",
				"required": ["name", "required", "description"],
				"properties": {
					"name": { "type": "string" },
					"required": { "type": "boolean" },
					"description": { "type": "string" },
					"allowedContent": {
						"type": "array",
						"items": { "type": "string" }
					}
				}
			},
			"ComponentEvent": {
				"type": "object",
				"required": ["name", "payload", "description"],
				"properties": {
					"name": { "type": "string" },
					"payload": { "type": "string" },
					"description": { "type": "string" },
					"when": { "type": "string" }
				}
			},
			"AccessibilityFeatures": {
				"type": "object",
				"required": ["keyboardNavigation", "screenReader", "visualAccess"],
				"properties": {
					"keyboardNavigation": { "$ref": "#/components/schemas/KeyboardNavigation" },
					"screenReader": { "$ref": "#/components/schemas/ScreenReaderSupport" },
					"visualAccess": { "$ref": "#/components/schemas/VisualAccessibility" },
					"cognitiveAccess": { "$ref": "#/components/schemas/CognitiveAccessibility" }
				}
			},
			"KeyboardNavigation": {
				"type": "object",
				"properties": {
					"tabIndex": {
						"oneOf": [{ "type": "number" }, { "type": "string", "enum": ["auto"] }]
					},
					"customKeyHandlers": {
						"type": "array",
						"items": { "$ref": "#/components/schemas/KeyHandler" }
					},
					"focusManagement": { "$ref": "#/components/schemas/FocusManagement" },
					"skipLinks": {
						"type": "array",
						"items": { "$ref": "#/components/schemas/SkipLink" }
					}
				}
			},
			"ScreenReaderSupport": {
				"type": "object",
				"properties": {
					"ariaLabel": { "type": "string" },
					"ariaLabelledBy": { "type": "string" },
					"ariaDescribedBy": { "type": "string" },
					"ariaRole": { "type": "string" },
					"liveRegion": {
						"type": "string",
						"enum": ["polite", "assertive", "off"]
					},
					"announcement": { "type": "string" }
				}
			},
			"VisualAccessibility": {
				"type": "object",
				"required": ["contrastRatio", "colorIndependence", "scaleSupport"],
				"properties": {
					"contrastRatio": {
						"type": "number",
						"minimum": 4.5,
						"description": "WCAG AA contrast ratio requirement"
					},
					"colorIndependence": {
						"type": "boolean",
						"description": "Information conveyed without color alone"
					},
					"scaleSupport": {
						"type": "boolean",
						"description": "Supports up to 200% zoom"
					},
					"motionReduction": {
						"type": "boolean",
						"description": "Respects prefers-reduced-motion"
					}
				}
			},
			"AccessibilityAuditRequest": {
				"type": "object",
				"required": ["target"],
				"properties": {
					"target": {
						"type": "string",
						"description": "Component or page to audit"
					},
					"auditType": {
						"type": "array",
						"items": {
							"type": "string",
							"enum": ["axe", "lighthouse", "manual", "all"]
						}
					},
					"wcagLevel": {
						"type": "string",
						"enum": ["A", "AA", "AAA"],
						"default": "AA"
					}
				}
			},
			"AccessibilityAuditResponse": {
				"type": "object",
				"properties": {
					"auditId": { "type": "string" },
					"target": { "type": "string" },
					"timestamp": { "type": "string", "format": "date-time" },
					"results": {
						"type": "object",
						"properties": {
							"passed": { "type": "number" },
							"failed": { "type": "number" },
							"warnings": { "type": "number" },
							"score": { "type": "number", "minimum": 0, "maximum": 100 }
						}
					},
					"violations": {
						"type": "array",
						"items": { "$ref": "#/components/schemas/AccessibilityViolation" }
					},
					"recommendations": {
						"type": "array",
						"items": { "type": "string" }
					}
				}
			},
			"AccessibilityViolation": {
				"type": "object",
				"properties": {
					"id": { "type": "string" },
					"description": { "type": "string" },
					"impact": {
						"type": "string",
						"enum": ["minor", "moderate", "serious", "critical"]
					},
					"wcagCriterion": { "type": "string" },
					"element": { "type": "string" },
					"fix": { "type": "string" }
				}
			},
			"PerformanceMetricsResponse": {
				"type": "object",
				"properties": {
					"bundleSize": {
						"type": "object",
						"properties": {
							"css": { "type": "number" },
							"javascript": { "type": "number" },
							"gzipped": { "type": "number" }
						}
					},
					"runtime": {
						"type": "object",
						"properties": {
							"firstPaint": { "type": "number" },
							"interaction": { "type": "number" },
							"frameRate": { "type": "number" }
						}
					},
					"accessibility": {
						"type": "object",
						"properties": {
							"contrastRatio": { "type": "number" },
							"keyboardNavigation": { "type": "boolean" },
							"screenReaderErrors": { "type": "number" }
						}
					},
					"budgets": {
						"type": "object",
						"properties": {
							"status": {
								"type": "string",
								"enum": ["pass", "warn", "fail"]
							},
							"violations": {
								"type": "array",
								"items": { "type": "string" }
							}
						}
					}
				}
			},
			"ThemeConfiguration": {
				"type": "object",
				"required": ["name", "tokens"],
				"properties": {
					"name": { "type": "string" },
					"tokens": {
						"type": "object",
						"additionalProperties": { "type": "string" }
					},
					"customizations": {
						"type": "array",
						"items": { "$ref": "#/components/schemas/ThemeCustomization" }
					},
					"dark": { "type": "boolean" },
					"accessibility": {
						"type": "object",
						"properties": {
							"highContrast": { "type": "boolean" },
							"reducedMotion": { "type": "boolean" },
							"largeText": { "type": "boolean" }
						}
					}
				}
			},
			"ThemeUpdateRequest": {
				"type": "object",
				"properties": {
					"customizations": {
						"type": "array",
						"items": { "$ref": "#/components/schemas/ThemeCustomization" }
					},
					"accessibility": {
						"type": "object",
						"properties": {
							"highContrast": { "type": "boolean" },
							"reducedMotion": { "type": "boolean" },
							"largeText": { "type": "boolean" }
						}
					}
				}
			},
			"ThemeCustomization": {
				"type": "object",
				"required": ["token", "value"],
				"properties": {
					"token": { "type": "string" },
					"value": { "type": "string" },
					"description": { "type": "string" }
				}
			},
			"ComponentRegistryResponse": {
				"type": "object",
				"properties": {
					"components": {
						"type": "array",
						"items": { "$ref": "#/components/schemas/ComponentDefinition" }
					},
					"patterns": {
						"type": "array",
						"items": { "$ref": "#/components/schemas/PatternDefinition" }
					},
					"version": { "type": "string" }
				}
			},
			"ValidationRule": {
				"type": "object",
				"required": ["type", "message"],
				"properties": {
					"type": {
						"type": "string",
						"enum": ["required", "minLength", "maxLength", "pattern", "custom"]
					},
					"value": {},
					"message": { "type": "string" }
				}
			},
			"ComponentDocumentation": {
				"type": "object",
				"properties": {
					"description": { "type": "string" },
					"examples": {
						"type": "array",
						"items": { "type": "string" }
					},
					"usage": { "type": "string" },
					"accessibility": { "type": "string" }
				}
			},
			"PatternDefinition": {
				"type": "object",
				"required": ["name", "description", "components"],
				"properties": {
					"name": { "type": "string" },
					"description": { "type": "string" },
					"components": {
						"type": "array",
						"items": { "type": "string" }
					},
					"examples": {
						"type": "array",
						"items": { "type": "string" }
					}
				}
			},
			"KeyHandler": {
				"type": "object",
				"properties": {
					"key": { "type": "string" },
					"action": { "type": "string" },
					"preventDefault": { "type": "boolean" }
				}
			},
			"FocusManagement": {
				"type": "object",
				"properties": {
					"autoFocus": { "type": "boolean" },
					"trapFocus": { "type": "boolean" },
					"restoreFocus": { "type": "boolean" }
				}
			},
			"SkipLink": {
				"type": "object",
				"properties": {
					"label": { "type": "string" },
					"target": { "type": "string" }
				}
			},
			"CognitiveAccessibility": {
				"type": "object",
				"properties": {
					"clearLabels": { "type": "boolean" },
					"consistentNavigation": { "type": "boolean" },
					"errorPrevention": { "type": "boolean" },
					"helpAvailable": { "type": "boolean" }
				}
			}
		}
	}
}
