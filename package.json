{
	"name": "sveltehr",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22.0.0",
		"npm": ">=10.0.0"
	},
	"overrides": {
		"graphql": "15.10.1",
		"runed": "^0.35.1"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "npm run test:unit -- --run && npm run test:integration -- --run && npm run test:contract -- --run && npm run test:graphql -- --run && npm run test:e2e",
		"test:unit": "vitest --project=unit-server,unit-client",
		"test:unit:server": "vitest --project=unit-server",
		"test:unit:client": "vitest --project=unit-client",
		"test:unit:browser": "vitest --project=component-browser",
		"test:integration": "vitest --project=integration",
		"test:contract": "vitest --project=contract",
		"test:performance": "vitest --project=performance",
		"test:performance:graphql": "vitest tests/performance/graphql-performance.test.ts",
		"test:performance:integration": "vitest tests/integration/performance-integration.test.ts",
		"test:performance:e2e": "playwright test tests/e2e/performance/",
		"test:graphql": "vitest --project=graphql",
		"test:graphql:schema": "vitest --project=graphql-schema",
		"test:graphql:testing-framework": "vitest tests/contract/test_graphql_schema.spec.ts --project=graphql-schema",
		"test:graphql:performance": "vitest --project=graphql-performance",
		"test:graphql:subscriptions": "vitest --project=graphql-subscriptions",
		"test:graphql:all": "vitest --project=graphql,graphql-schema,graphql-performance,graphql-subscriptions",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:debug": "playwright test --debug",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:report": "playwright show-report",
		"test:e2e:mobile": "PLAYWRIGHT_MOBILE_TESTS=true playwright test --project=mobile-chrome,mobile-safari",
		"test:e2e:performance": "PLAYWRIGHT_PERFORMANCE_REPORT=true playwright test --project=chromium-performance",
		"test:e2e:a11y": "playwright test --project=chromium-a11y",
		"test:api": "playwright test --project=api-tests",
		"test:visual": "playwright test --project=visual-regression",
		"test:visual:update": "playwright test --project=visual-regression --update-snapshots",
		"test:auth": "playwright test tests/e2e/auth",
		"test:dashboard": "playwright test tests/e2e/dashboard",
		"test:employees": "playwright test tests/e2e/employees",
		"test:streaming": "playwright test tests/e2e/streaming",
		"test:hr-workflows": "playwright test tests/e2e/*flow*.spec.ts",
		"test:puppeteer": "vitest --project=e2e-puppeteer",
		"test:puppeteer:dashboard": "vitest tests/e2e/dashboard-data.puppeteer.test.ts --project=e2e-puppeteer",
		"test:puppeteer:forms": "vitest tests/e2e/form-interactions.puppeteer.test.ts --project=e2e-puppeteer",
		"test:puppeteer:events": "vitest tests/e2e/events/event-rsvp-workflow.puppeteer.test.ts --project=e2e-puppeteer",
		"test:puppeteer:headed": "BROWSER_HEADLESS=false vitest --project=e2e-puppeteer",
		"test:puppeteer:ui": "vitest --project=e2e-puppeteer --ui",
		"test:browser": "vitest --project=e2e-browser --coverage.enabled=false",
		"test:browser:dashboard": "vitest tests/e2e/dashboard-data.browser.test.ts --project=e2e-browser --coverage.enabled=false",
		"test:browser:forms": "vitest tests/e2e/form-interactions.browser.test.ts --project=e2e-browser --coverage.enabled=false",
		"test:browser:events": "vitest tests/e2e/events/event-rsvp-workflow.browser.test.ts --project=e2e-browser --coverage.enabled=false",
		"test:browser:headed": "HEADED=true vitest --project=e2e-browser --coverage.enabled=false",
		"test:browser:ui": "vitest --project=e2e-browser --ui --coverage.enabled=false",
		"test:components": "vitest src/lib/components",
		"test:coverage": "vitest --coverage",
		"test:coverage:report": "vitest --coverage && open coverage/index.html",
		"test:coverage:unit": "vitest --project=unit-server --project=unit-browser --coverage",
		"test:coverage:ci": "vitest --coverage --reporter=json --reporter=text",
		"test:puppeteer:all": "vitest --project=e2e-puppeteer --run",
		"test:puppeteer:coverage": "npm run test:puppeteer:all && echo '\\nSee tests/coverage/e2e-feature-coverage-matrix.md for E2E feature coverage'",
		"test:puppeteer:hr": "vitest tests/e2e/hr/hr-workflows.puppeteer.test.ts --project=e2e-puppeteer --run",
		"test:puppeteer:admin": "vitest tests/e2e/admin/admin-components.puppeteer.test.ts --project=e2e-puppeteer --run",
		"test:puppeteer:tasks": "vitest tests/e2e/tasks/task-management.puppeteer.test.ts --project=e2e-puppeteer --run",
		"db:snapshot": "tsx scripts/db/create-baseline-snapshot.ts",
		"db:verify": "tsx scripts/db/verify-schema.ts --environment development --database-url ${DATABASE_URL:-postgresql://postgres:postgres123@localhost:5433/hr_system}",
		"db:new-migration": "bash scripts/db/new-migration.sh",
		"db:migrate": "bash scripts/db/apply-pending-migrations.sh",
		"db:migrate:status": "bash scripts/db/migration-status.sh",
		"db:rebuild": "cd dev-containers && docker compose -f docker-compose.dev.yml down postgres-dev && docker volume rm sveltehr_postgres_dev_data && docker compose -f docker-compose.dev.yml up -d postgres-dev",
		"db:logs": "docker logs sveltehr-postgres-dev 2>&1 | grep -A50 'Starting Database Initialization'",
		"db:check": "docker exec sveltehr-postgres-dev psql -U postgres -d hr_system -c 'SELECT count(*) FROM pg_tables WHERE schemaname = '\"'\"'hr_public'\"'\"''",
		"test:db:create": "bash scripts/test-db/create-test-db.sh",
		"test:db:seed": "bash scripts/test-db/seed-test-data.sh",
		"test:db:reset": "bash scripts/test-db/reset-test-db.sh",
		"test:watch": "vitest --watch",
		"test:ci": "vitest --run --coverage && playwright test",
		"codegen": "echo 'Codegen temporarily disabled - GraphQL operations need to be updated to match Rust schema'",
		"codegen:watch": "echo 'Codegen watch temporarily disabled - GraphQL operations need to be updated to match Rust schema'",
		"codegen:hasura": "graphql-codegen --config codegen.hasura.ts",
		"schema:validate": "export $(grep -v '^#' .env | xargs) && cd tools/schema-validator && npm run build && node dist/cli/index.js validate --config ../../schema-validator.config.json",
		"schema:validate:full": "export $(grep -v '^#' .env | xargs) && cd tools/schema-validator && npm run build && node dist/cli/index.js validate --config ../../schema-validator.config.json --full",
		"schema:check": "export $(grep -v '^#' .env | xargs) && cd tools/schema-validator && node dist/cli/index.js check --config ../../schema-validator.config.json",
		"schema:report": "export $(grep -v '^#' .env | xargs) && cd tools/schema-validator && node dist/cli/index.js report --config ../../schema-validator.config.json --format markdown -o ../../schema-validation-report.md",
		"schema:report:json": "export $(grep -v '^#' .env | xargs) && cd tools/schema-validator && node dist/cli/index.js report --config ../../schema-validator.config.json --format json -o ../../schema-validation-report.json",
		"schema:init": "export $(grep -v '^#' .env | xargs) && cd tools/schema-validator && node dist/cli/index.js init --config ../../schema-validator.config.json --install-hooks",
		"schema:cache:clear": "export $(grep -v '^#' .env | xargs) && cd tools/schema-validator && node dist/cli/index.js cache clear --config ../../schema-validator.config.json --all",
		"schema:cache:stats": "export $(grep -v '^#' .env | xargs) && cd tools/schema-validator && node dist/cli/index.js cache stats --config ../../schema-validator.config.json",
		"dev:k8s": "tilt up",
		"dev:k8s:down": "tilt down",
		"dev:k8s:ci": "tilt ci",
		"dev:k8s:logs": "tilt logs",
		"dev:k8s:trigger": "tilt trigger",
		"dev:k8s:clean": "tilt down --delete-namespaces"
	},
	"devDependencies": {
		"@dnd-kit-svelte/core": "^0.0.11",
		"@dnd-kit-svelte/modifiers": "^0.0.11",
		"@dnd-kit-svelte/sortable": "^0.0.11",
		"@dnd-kit-svelte/utilities": "^0.0.11",
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@graphql-codegen/cli": "^6.0.0",
		"@graphql-codegen/introspection": "^5.0.0",
		"@graphql-codegen/schema-ast": "^5.0.0",
		"@graphql-codegen/typescript": "^5.0.0",
		"@graphql-codegen/typescript-operations": "^5.0.0",
		"@graphql-codegen/typescript-urql": "^4.0.1",
		"@internationalized/date": "^3.9.0",
		"@lucide/svelte": "^0.544.0",
		"@playwright/test": "^1.55.1",
		"@storybook/svelte": "^10.0.5",
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/adapter-node": "^5.4.0",
		"@sveltejs/kit": "^2.43.5",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tabler/icons-svelte": "^3.35.0",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.16",
		"@tanstack/table-core": "^8.21.3",
		"@types/bcryptjs": "^2.4.6",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.1.7",
		"@types/file-saver": "^2.0.7",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/pg": "^8.15.5",
		"@types/qrcode": "^1.5.5",
		"@vitest/browser": "^3.2.3",
		"@vitest/coverage-v8": "^3.2.3",
		"@vitest/ui": "^3.2.4",
		"chalk": "^5.4.1",
		"commander": "^13.1.0",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"dotenv": "^17.2.3",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^9.36.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"formsnap": "^2.0.1",
		"globals": "^16.0.0",
		"layerchart": "^2.0.0-next.27",
		"mode-watcher": "^1.1.0",
		"ora": "^9.0.0",
		"paneforge": "^1.0.2",
		"pg": "^8.16.3",
		"pg-format": "^1.0.4",
		"playwright": "^1.55.1",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"puppeteer": "^24.26.1",
		"svelte": "^5.39.6",
		"svelte-check": "^4.3.2",
		"svelte-sonner": "^1.0.5",
		"svelte2tsx": "^0.7.44",
		"sveltekit-superforms": "^2.28.0",
		"tailwind-merge": "^3.3.1",
		"tailwind-variants": "^3.1.1",
		"tailwindcss": "^4.1.16",
		"tsx": "^4.19.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.44.1",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^7.1.7",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^3.2.3",
		"vitest-browser-svelte": "^0.1.0",
		"webdriverio": "^9.20.0",
		"zod": "^4.0.14"
	},
	"dependencies": {
		"@fullcalendar/core": "^6.1.19",
		"@fullcalendar/daygrid": "^6.1.19",
		"@fullcalendar/interaction": "^6.1.19",
		"@fullcalendar/rrule": "^6.1.19",
		"@fullcalendar/timegrid": "^6.1.19",
		"@graphile-contrib/pg-simplify-inflector": "^6.1.0",
		"@graphql-codegen/client-preset": "^5.0.0",
		"@graphql-tools/schema": "^10.0.25",
		"@sentry/sveltekit": "^10.23.0",
		"@testing-library/svelte": "^5.2.8",
		"@types/node-cron": "^3.0.11",
		"@types/pdfkit": "^0.17.3",
		"@urql/exchange-auth": "^3.0.0",
		"@urql/exchange-graphcache": "^8.1.0",
		"@urql/exchange-retry": "^2.0.0",
		"@urql/svelte": "^5.0.0",
		"@vincjo/datatables": "^2.6.4",
		"bcryptjs": "^3.0.2",
		"bits-ui": "^2.14.1",
		"chart.js": "^4.4.1",
		"clsx": "^2.1.1",
		"cron": "^4.3.3",
		"cropperjs": "^1.6.2",
		"date-fns": "^2.30.0",
		"edgedb": "^2.0.1",
		"felte": "^1.3.0",
		"file-saver": "^2.0.5",
		"graphql": "15.10.1",
		"graphql-yoga": "^5.15.2",
		"ical.js": "^2.2.1",
		"jsdom": "^26.1.0",
		"jsonwebtoken": "^9.0.2",
		"nanoid": "^5.0.4",
		"node-cron": "^4.2.1",
		"pdfkit": "^0.17.2",
		"postcss": "^8.5.6",
		"postgres": "^3.4.7",
		"recharts": "^3.2.1",
		"rrule": "^2.8.1",
		"sharp": "^0.34.4",
		"svelte-calendar": "^3.1.6",
		"svelte-dnd-action": "^0.9.64",
		"svelte-file-dropzone": "^2.0.7",
		"svelte-notifications": "^0.9.98",
		"svelte-persisted-store": "^0.11.0",
		"svelte-select": "^5.8.3",
		"svelte-time": "^0.9.0",
		"svelte-virtual-scroll-list": "^1.3.0"
	}
}
