{
	"name": "sveltehr",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"overrides": {
		"graphql": "15.10.1"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"codegen": "graphql-codegen --config codegen.ts",
		"codegen:watch": "graphql-codegen --config codegen.ts --watch",
		"codegen:hasura": "graphql-codegen --config codegen.hasura.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@graphql-codegen/cli": "^6.0.0",
		"@graphql-codegen/introspection": "^5.0.0",
		"@graphql-codegen/schema-ast": "^5.0.0",
		"@graphql-codegen/typescript": "^5.0.0",
		"@graphql-codegen/typescript-operations": "^5.0.0",
		"@graphql-codegen/typescript-urql": "^4.0.1",
		"@playwright/test": "^1.49.1",
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.16",
		"@types/bcryptjs": "^2.4.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@vitest/browser": "^3.2.3",
		"autoprefixer": "^10.4.21",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"playwright": "^1.53.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"svelte2tsx": "^0.7.43",
		"tailwindcss": "^3.4.17",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"vite": "^7.0.4",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^3.2.3",
		"vitest-browser-svelte": "^0.1.0"
	},
	"dependencies": {
		"@graphile-contrib/pg-simplify-inflector": "^6.1.0",
		"@graphql-codegen/client-preset": "^5.0.0",
		"@graphql-tools/schema": "^10.0.25",
		"@testing-library/svelte": "^5.2.8",
		"@urql/exchange-auth": "^3.0.0",
		"@urql/exchange-graphcache": "^8.1.0",
		"@urql/exchange-retry": "^2.0.0",
		"@urql/svelte": "^5.0.0",
		"bcryptjs": "^3.0.2",
		"edgedb": "^2.0.1",
		"graphql": "15.10.1",
		"graphql-yoga": "^5.15.2",
		"jsdom": "^26.1.0",
		"jsonwebtoken": "^9.0.2",
		"lucide-svelte": "^0.543.0",
		"postgraphile": "^4.14.1",
		"zod": "^4.1.5"
	}
}
